/* The editor's look, after the editor concept: near-black panels with 6px
   gaps on a darker window, thin borders, one periwinkle accent, Inter for
   text and JetBrains Mono for numbers, and compact rows. Tokens and
   controls come from the default theme; this sheet lays the editor out and
   dresses its panels. */

:root {
    --ed-logo-top: #aab3ff;
    --ed-logo-left: #7988ff;
    --ed-logo-right: #4c56b8;
    --ed-warn: var(--vx-warning);
}

.editor {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
}

.spacer {
    flex-grow: 1;
}

.fill {
    flex-grow: 1;
    flex-basis: 0px;
}

.mono {
    font-family: mono;
    font-size: 11px;
}

/* The top bar: brand, workspaces and the command bar on the left, play
   controls in the middle, the account and Build on the right. */

.topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 40px;
    padding: 0px 8px;
    column-gap: 8px;
}

.topbar-left {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    min-width: 0px;
    overflow: hidden;
}

.logo {
    width: 18px;
    height: 18px;
    margin-left: 4px;
    flex-shrink: 0;
}

.logo > Icon {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 18px;
    height: 18px;
}

.logo-top {
    color: var(--ed-logo-top);
}

.logo-left {
    color: var(--ed-logo-left);
}

.logo-right {
    color: var(--ed-logo-right);
}

.brand {
    font-size: 13px;
    font-weight: 600;
    color: var(--vx-text);
    margin-right: 6px;
}

/* The Layout menu's button: the layout showing, which opens the menu of layouts. */
.layouts-button {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0px 6px 0px 8px;
    border-radius: 5px;
    background-color: transparent;
    font-weight: 500;
}

.layouts-button:hover {
    background-color: var(--vx-selected);
}

.layouts-arrow {
    width: 12px;
    height: 12px;
    color: var(--vx-muted);
}

/* Save Layout As's box, under the Layout menu's button. */
.layout-prompt {
    position: absolute;
    z-index: 40;
    flex-direction: column;
    gap: 8px;
    width: 280px;
    padding: 10px;
    border-radius: 8px;
    background-color: var(--vx-overlay);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 12px 32px rgba(0, 0, 0, 0.45);
}

.layout-prompt-title {
    font-weight: 600;
}

.layout-prompt-row {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.layout-prompt-name {
    flex-grow: 1;
    min-width: 0px;
}

.command {
    flex-direction: row;
    align-items: center;
    width: 260px;
    height: 26px;
    padding: 0px 5px 0px 9px;
    gap: 7px;
    margin-left: 6px;
    flex-shrink: 1;
    border-radius: 6px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.command-icon, .search-icon {
    width: 13px;
    height: 13px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

.command-field, .search-field, .axis-input {
    flex-grow: 1;
    height: 20px;
    padding: 0px;
    border-width: 0px;
    background-color: transparent;
}

/* The Settings panel: groups of settings, laid out as the Inspector's rows. */
.settings-body {
    padding: 4px 12px 12px 12px;
}

.settings-group {
    margin-top: 12px;
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: 600;
    color: var(--vx-muted);
}

.setting .prop-label {
    color: var(--vx-text-2);
}

.setting.found .prop-label {
    color: var(--vx-accent);
}

/* Names in full, as settings have room the Inspector's fields do not. */
.prop.setting {
    grid-template-columns: minmax(0px, 1fr) 132px;
}

.setting-unit {
    flex-shrink: 0;
    font-size: 11px;
    color: var(--vx-muted);
}

/* The command palette, under the command bar. */
.palette {
    position: absolute;
    width: 460px;
    padding: 4px;
    z-index: 20;
    border-radius: 8px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 12px 32px rgba(0, 0, 0, 0.45);
}

.palette-list .list-row {
    align-items: center;
    gap: 8px;
    padding: 0px 8px;
    border-radius: 5px;
}

.palette-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--vx-muted);
}

.palette-title {
    flex-grow: 1;
    min-width: 0px;
    color: var(--vx-text);
}

.palette-detail {
    flex-shrink: 0;
    font-size: 11px;
    color: var(--vx-muted);
}

.palette-empty {
    padding: 8px;
    color: var(--vx-muted);
}

.kbd {
    height: 16px;
    padding: 0px 4px;
    flex-shrink: 0;
    border-radius: 4px;
    border: 1px solid var(--vx-line-2);
    font-family: mono;
    font-size: 10px;
    line-height: 14px;
    color: var(--vx-muted);
}

/* Play, pause and step in a pill; play is the accent. */
.play {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    gap: 4px;
    border-radius: 7px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.play > Button {
    width: 28px;
    height: 22px;
}

.play Icon {
    width: 11px;
    height: 11px;
}

.play-button {
    color: var(--vx-accent);
}

.play-button:hover {
    color: var(--vx-accent-hover);
}

.topbar-right {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
}

.build {
    height: 26px;
    padding: 0px 12px;
}

/* The body: the rail, then the dock. */

.body {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0px;
    padding: 0px 6px 0px 0px;
    gap: 2px;
}

.rail {
    width: 44px;
    padding: 2px 0px 4px 0px;
    gap: 4px;
    align-items: center;
    flex-shrink: 0;
}

.rail-button {
    width: 32px;
    height: 32px;
    border-radius: 7px;
}

.rail-button > Icon {
    width: 16px;
    height: 16px;
}

.rail-button:checked {
    color: var(--vx-text);
    background-color: var(--vx-selected);
}

/* The game's own buttons and items, under Levels. */
.rail-scripts {
    align-items: center;
    gap: 4px;
}

.rail-item {
    width: 40px;
    align-items: center;
}

/* The Project panel's rename bar, over its files while a name is typed. */
.project-rename {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 30px;
    padding: 0px 8px;
    gap: 8px;
    background-color: var(--vx-field);
    border-radius: 5px;
    margin: 0px 6px 4px 6px;
}

.project-rename-label {
    font-size: 11px;
    color: var(--vx-muted);
}

.project-rename-field {
    flex-grow: 1;
}

/* The rail's drawer: Levels or Settings, over the left of the dock, a third of the window wide: under the 40px
   top bar, over the 22px status bar, and right of the 44px rail. */
.drawer {
    position: absolute;
    left: 46px;
    top: 40px;
    bottom: 23px;
    width: 33%;
    min-width: 340px;
    flex-direction: column;
    border-radius: 8px;
    background-color: var(--vx-panel);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 12px 32px rgba(0, 0, 0, 0.45);
}

.drawer-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 34px;
    padding: 0px 6px 0px 12px;
}

.drawer-title {
    flex-grow: 1;
    font-weight: 600;
}

.drawer-page {
    flex-direction: column;
}

/* Settings: a tab for each group down the left, its settings beside them. */
.settings-root {
    flex-direction: row;
}

.settings-tabs {
    flex-direction: column;
    flex-shrink: 0;
    width: 128px;
    padding: 4px 6px;
    gap: 2px;
}

.settings-tab {
    height: 26px;
    padding: 0px 10px;
    border-radius: 5px;
    border-color: transparent;
    justify-content: flex-start;
    text-align: left;
    color: var(--vx-muted);
    background-color: transparent;
}

.settings-tab:focus {
    border-color: transparent;
}

.settings-tab:hover {
    color: var(--vx-text);
    background-color: var(--vx-hover);
}

.settings-tab:checked {
    color: var(--vx-text);
    background-color: var(--vx-selected);
}

.settings-main {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
}

.dock {
    flex-grow: 1;
}

.dock-content {
    padding-top: 6px;
    gap: 4px;
}

/* An Inspector's padlock, lit while it is locked to what it shows. */
.inspector-lock:checked {
    color: var(--vx-accent);
    background-color: var(--vx-accent-soft);
}

/* A panel's own controls, at the right of its header, left of the dock's options button, which is every window's
   menu. */
.panel-actions {
    position: absolute;
    top: -32px;
    right: 30px;
    height: 32px;
    flex-direction: row;
    align-items: center;
    gap: 2px;
}

.header-button {
    height: 22px;
    padding: 0px 7px;
    border-width: 0px;
    background-color: transparent;
    color: var(--vx-text-2);
    font-weight: 400;
}

.header-button:hover {
    background-color: var(--vx-hover);
}

.shading {
    height: 22px;
    padding: 0px 6px;
    gap: 4px;
    border-width: 0px;
    background-color: transparent;
}

.shading:hover {
    background-color: var(--vx-hover);
}

.search {
    flex-direction: row;
    align-items: center;
    height: 24px;
    margin: 0px 6px;
    padding: 0px 7px;
    gap: 6px;
    flex-shrink: 0;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.placeholder {
    color: var(--vx-muted);
    padding: 4px 10px;
}

/* Rows of the Hierarchy and the Project. */

.row-icon {
    width: 13px;
    height: 13px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

.list-row:selected .row-icon {
    color: var(--vx-accent);
}

.row-name {
    flex-grow: 1;
    flex-basis: 0px;
}

.row-count {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

/* A scene's header in the Hierarchy, as Unity heads each open scene. */
.scene-header .row-name {
    font-weight: 600;
    color: var(--vx-text);
}

.scene-header .row-icon {
    color: var(--vx-text-2);
}

/* An Obj with an IInstance behaviour: a small pill after its name. */
.row-badge {
    flex-shrink: 0;
    padding: 0px 5px;
    margin-right: 4px;
    border-radius: 4px;
    font-size: 10px;
    color: var(--vx-accent);
    background-color: var(--vx-selected);
}

/* Prefab instances are tinted, as Unity tints them: the root, and lighter what is inside. */
.row-name.prefab-root, .row-icon.prefab-root, .obj-tile.prefab-root > Icon {
    color: var(--vx-prefab);
}

.row-name.prefab-member, .row-icon.prefab-member {
    color: var(--vx-prefab-member);
}

/* The Inspector's Prefab row: the prefab an instance comes from, to open or show. */
.prefab-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--vx-prefab);
}

.prefab-file {
    flex-grow: 1;
    min-width: 0px;
    overflow: hidden;
    white-space: nowrap;
    font-size: 11px;
    color: var(--vx-prefab);
}

.prefab-button {
    height: 22px;
    padding: 0px 8px;
    flex-shrink: 0;
    font-size: 11px;
}

/* The Scene panel: its area lets the 3D view show through, and its
   overlays float over it. The frame is drawn over the view's edge, in the
   window's layer, so the view's corners follow the panel's. */

/* The dock area around the 3D view: see-through, with a ring of the editor's background around its edge that
   rounds the view's corners to the panel's. The ring is the area's own, so a floating window over it covers it. */
.viewport-area {
    background-color: transparent;
    box-shadow: 0px 0px 0px 4px var(--vx-bg);
}

.viewport-area > .tab-bar {
    background-color: var(--vx-panel);
}

.viewport {
    flex-grow: 1;
}

/* A prefab or model dragged over the Scene view, ready to place. */
.viewport.drop-hover {
    background-color: var(--vx-accent-soft);
}

/* Prefab mode: what is open, and the way back to the level. */
.prefab-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    height: 30px;
    padding: 0px 8px 0px 4px;
    background-color: var(--vx-panel);
    border-bottom: 1px solid var(--vx-line);
}

.prefab-back, .prefab-close {
    flex-direction: row;
    align-items: center;
    gap: 2px;
}

.prefab-close {
    flex-shrink: 0;
    padding: 0px 8px 0px 4px;
    border-radius: 5px;
    background-color: var(--vx-accent-soft);
}

.prefab-icon {
    width: 14px;
    height: 14px;
    color: var(--vx-accent);
}

.prefab-name {
    font-weight: 600;
}

.prefab-hint {
    flex-grow: 1;
    color: var(--vx-muted);
    text-align: right;
}

/* The move, rotate and scale handles, drawn as shapes over the 3D view. */
.handles {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    pointer-events: none;
}

/* Over the 3D view: frosted glass, the view showing through blurred under a
   lighter wash of the overlay colour. */
.overlay {
    position: absolute;
    border-radius: 7px;
    background-color: var(--vx-glass);
    backdrop-filter: blur(16px);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.35);
}

.tools {
    left: 8px;
    top: 8px;
    flex-direction: row;
    align-items: center;
    padding: 2px;
    gap: 2px;
}

.tool-modes {
    height: 24px;
    padding: 0px;
    gap: 2px;
    background-color: transparent;
}

.tool-modes .segment {
    width: 24px;
    height: 24px;
    padding: 0px;
    border-radius: 5px;
}

.tool-modes .segment > Icon {
    width: 13px;
    height: 13px;
}

.tool-modes .segment:checked {
    background-color: var(--vx-accent-soft);
    box-shadow: none;
    color: var(--vx-accent);
}

.tool-divider {
    width: 1px;
    height: 14px;
    margin: 0px 3px;
    background-color: var(--vx-line-2);
}

.tool-toggle {
    height: 24px;
    padding: 0px 7px;
    gap: 5px;
    border-radius: 5px;
    border-width: 0px;
    background-color: transparent;
    color: var(--vx-text-2);
    font-weight: 400;
}

.tool-toggle > Icon {
    width: 13px;
    height: 13px;
    color: var(--vx-muted);
}

.tool-toggle:hover {
    background-color: var(--vx-hover);
}

.chip {
    left: 8px;
    bottom: 8px;
    height: 24px;
    padding: 0px 9px;
    border-radius: 7px;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

.gizmo-box {
    right: 8px;
    bottom: 8px;
    flex-direction: row;
    align-items: center;
    padding: 3px 10px 3px 4px;
    gap: 6px;
}

.gizmo {
    width: 30px;
    height: 30px;
}

.projection {
    color: var(--vx-text-2);
}

/* The Inspector. */

.inspector {
    padding: 8px 10px 12px 10px;
}

.inspector-header {
    gap: 2px;
    padding-bottom: 8px;
}

.header-row {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
}

/* Tag and Layer side by side under the name, then Static and Persistent on
   a short row, as Unity's header keeps them short. */
.header-tags {
    display: grid;
    grid-template-columns: auto minmax(0px, 1fr) auto minmax(0px, 1fr);
    column-gap: 6px;
    align-items: center;
}

.header-tags > Dropdown {
    min-width: 0px;
}

.header-checks {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    margin-top: 4px;
}

.header-label {
    color: var(--vx-muted);
}

.header-check {
    flex-shrink: 0;
    gap: 5px;
    align-items: center;
}

.header-check > .toggle-label {
    color: var(--vx-muted);
}

.obj-tile {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    background-color: var(--vx-accent-soft);
    color: var(--vx-accent);
}

.obj-tile > Icon {
    width: 13px;
    height: 13px;
}

.obj-name {
    flex-grow: 1;
    flex-basis: 0px;
    font-weight: 600;
}

/* How many Objs an edit goes to, beside the name, with several selected. */
.inspector-many {
    flex-shrink: 0;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    white-space: nowrap;
    color: var(--vx-text-2);
    background-color: var(--vx-selected);
}

.prop-label {
    color: var(--vx-muted);
}

/* A value kept after play: its label in the accent, as a reminder. */
.kept > .prop-label, .kept > .obj-tile {
    color: var(--vx-accent);
}

/* A value a prefab instance changes from its prefab, as Unity marks one: a
   bar beside it, and its label bold. */
.prop.overridden > .prop-label {
    border-left: 2px solid var(--vx-accent);
    padding-left: 4px;
    color: var(--vx-text);
    font-weight: 600;
}

.overridden > .foldout-title {
    font-weight: 600;
}

.divider {
    height: 1px;
    flex-shrink: 0;
    background-color: var(--vx-line);
}

.section > .foldout-header {
    height: 30px;
}

.section > .foldout-content {
    padding-left: 0px;
    padding-bottom: 8px;
    gap: 0px;
}

.section .foldout-icon {
    width: 13px;
    height: 13px;
}

/* A component a prefab locks for designers: a padlock in its header, and,
   in the prefab, its values designers do not see dimmed. */
.lock-mark {
    width: 13px;
    height: 13px;
    color: var(--vx-muted);
}

.hidden-from-designers {
    opacity: 0.45;
}

.prop {
    display: grid;
    grid-template-columns: 80px minmax(0px, 1fr);
    column-gap: 6px;
    align-items: center;
    min-height: 26px;
}

.prop > Dropdown, .prop > TextField {
    min-width: 0px;
}

.vector {
    display: grid;
    grid-template-columns: repeat(3, minmax(0px, 1fr));
    column-gap: 4px;
}

.axis-field {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding-left: 6px;
    gap: 4px;
    min-width: 0px;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.axis-input {
    font-family: mono;
    font-size: 11px;
    min-width: 0px;
}

.axis-letter {
    font-size: 10px;
    font-weight: 600;
    flex-shrink: 0;
}

.axis-x {
    color: var(--vx-x);
}

.axis-y {
    color: var(--vx-y);
}

.axis-z {
    color: var(--vx-z);
}

/* A colour: its swatch, then red, green and blue. */
.vector.color {
    grid-template-columns: 22px repeat(3, minmax(0px, 1fr));
}

.swatch {
    height: 22px;
    border-radius: 5px;
    border: 1px solid var(--vx-field-line);
}

/* A click on a swatch opens the colour picker. */
.swatch:hover {
    border-color: var(--vx-muted);
}

/* The colour picker's popup: the palette's look, sized to the picker. */
.color-popup {
    flex-direction: column;
    gap: 6px;
    width: 250px;
    padding: 8px;
}

.axis-r {
    color: var(--vx-x);
}

.axis-g {
    color: var(--vx-y);
}

.axis-b {
    color: var(--vx-z);
}

.value-input {
    height: 22px;
    font-size: 11px;
}

.number-input {
    font-family: mono;
}

.vector.vector-2 {
    grid-template-columns: repeat(2, minmax(0px, 1fr));
}

.vector.vector-4 {
    grid-template-columns: repeat(4, minmax(0px, 1fr));
}

/* A value with a button beside it: a list's add, or an item's remove. */
.prop-value {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    min-width: 0px;
}

.prop-value > .value-input, .prop-value > .value-picker, .prop-value > .vector, .prop-value > .value {
    flex-grow: 1;
    min-width: 0px;
}

.list-add, .list-remove {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

/* The collection field, every list's look, as Unity 6's reorderable lists: a
   box of items, each on a ground of its own with a line between, a grip at
   its left that drags it, and its remove button at its right; the add button
   hangs under the box at its right. */
.collection {
    flex-direction: column;
    margin: 2px 0px 6px 0px;
}

.collection-items {
    flex-direction: column;
    border: 1px solid var(--vx-field-line);
    border-radius: 6px;
    background-color: var(--vx-panel);
    overflow: hidden;
}

.collection-item {
    flex-direction: row;
    align-items: flex-start;
    gap: 4px;
    padding: 3px 4px 3px 2px;
    background-color: var(--vx-panel);
    border-top: 1px solid var(--vx-line);
}

.collection-item.first {
    border-top: 0px;
}

.collection-item.odd {
    background-color: var(--vx-hover);
}

.collection-item.reorder-lifted {
    background-color: var(--vx-selected);
    border: 1px solid var(--vx-accent);
    border-radius: 5px;
}

.collection-grip {
    width: 16px;
    height: 22px;
    flex-shrink: 0;
    color: var(--vx-muted);
}

.collection-grip:hover, .reorder-lifted > .collection-grip {
    color: var(--vx-text);
}

.collection-grip.disabled {
    color: transparent;
}

.collection-body {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0px;
    gap: 2px;
}

.collection-body > .prop {
    padding-left: 0px;
}

.collection-remove {
    width: 20px;
    height: 20px;
    margin-top: 1px;
    flex-shrink: 0;
}

.collection-empty {
    padding: 6px 10px;
    border: 1px solid var(--vx-field-line);
    border-radius: 6px;
    font-size: 11px;
    color: var(--vx-muted);
}

/* Empty, the box takes no room but stays laid out, so a field added to it can be focused at once. */
.collection-items.none {
    border: 0px solid transparent;
}

.collection-footer {
    flex-direction: row;
    justify-content: flex-end;
}

.collection-footer > .collection-add {
    margin-top: -1px;
    padding: 1px 10px;
    min-width: 28px;
    height: 20px;
    /* A side's border keeps the colour of the rest, so the top is left out by width alone. */
    border: 1px solid var(--vx-field-line);
    border-top: 0px;
    border-radius: 0px;
    background-color: var(--vx-panel);
}

.collection-footer > .icon-button.collection-add {
    width: 34px;
    padding: 0px;
}

.collection-footer > .collection-add:hover {
    background-color: var(--vx-hover);
}

/* A level's scene in the Inspector: whether it is active, and required. */
.level-flag {
    gap: 5px;
    font-size: 11px;
}

/* One of a level's scenes: a reference to it and its remove button, then its
   boxes and weight under it. */
.level-scene {
    flex-direction: column;
    gap: 4px;
    padding: 3px 0px;
}

.level-scene-top {
    align-items: center;
    gap: 6px;
    min-height: 26px;
}

.level-scene-top > .value-picker {
    flex-grow: 1;
}

.level-weight-group {
    flex-direction: row;
    align-items: center;
    gap: 5px;
    margin-left: auto;
}

/* Narrow, the weight goes under the boxes rather than off the edge. */
.level-scene-flags {
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    row-gap: 4px;
    padding-left: 2px;
}

/* A string table's text: a language without the key's text has a border in
   the warning colour, and text past the key's limit is in it. */
.value-input.missing {
    border-color: var(--vx-warning);
}

.value-input.too-long {
    color: var(--vx-warning);
}

/* The project's layers: layer 0's name, which stays Default, and the
   Layer Collision Matrix, a triangle of ticks under the layers' numbers. */
.layer-fixed {
    padding-left: 7px;
    color: var(--vx-text-2);
}

.layer-matrix {
    flex-direction: column;
    gap: 2px;
    padding: 4px 0px 2px 0px;
}

.layer-matrix-row {
    flex-direction: row;
    align-items: center;
    gap: 2px;
}

.layer-matrix-name {
    width: 104px;
    flex-shrink: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--vx-muted);
}

.layer-matrix-number {
    width: 20px;
    flex-shrink: 0;
    text-align: center;
    font-size: 10px;
    color: var(--vx-muted);
}

.layer-matrix-name.lit, .layer-matrix-number.lit {
    color: var(--vx-accent);
}

.layer-matrix-check {
    width: 20px;
    flex-shrink: 0;
    justify-content: center;
}

.layer-pair {
    min-height: 18px;
    font-size: 11px;
    color: var(--vx-text-2);
}

.level-weight-label {
    font-size: 11px;
    color: var(--vx-muted);
}

.level-weight {
    width: 40px;
    min-width: 40px;
    flex-grow: 0;
    flex-shrink: 0;
}

.picker-icon {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    color: var(--vx-text-2);
}

/* A scene dragged over Add Scene, ready to drop. */
.add-component.drop-hover {
    border-color: var(--vx-accent);
    background-color: var(--vx-selected);
}

/* A reference: what it points at, opening a menu to pick another. */
.value-picker {
    height: 22px;
    padding: 0px 6px 0px 8px;
    gap: 6px;
    align-items: center;
    min-width: 0px;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
    transition: border-color var(--vx-fade);
}

.value-picker:hover {
    border-color: var(--vx-line-2);
}

/* Something dragged over a reference, ready to drop. */
.value-picker.drop-hover {
    border-color: var(--vx-accent);
    background-color: var(--vx-selected);
}

.picker-label {
    flex-grow: 1;
    min-width: 0px;
    overflow: hidden;
    white-space: nowrap;
    font-size: 11px;
}

/* A reference's arrow, which opens the menu to pick another; the rest of the field pings what it points at. */
.picker-arrow {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-right: -4px;
    border-radius: 4px;
}

/* An asset field's preview, before its name. */
.field-thumb {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-left: -4px;
    border-radius: 3px;
}

/* The Inspector's large preview of an asset, which a drag turns. */
.asset-preview {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    height: 208px;
    margin: 4px 0px 8px 0px;
    border-radius: 8px;
    background-color: var(--vx-bg);
}

.asset-preview-image {
    width: 200px;
    height: 200px;
    border-radius: 8px;
}

.asset-preview-hint {
    position: absolute;
    right: 8px;
    bottom: 6px;
    font-size: 10px;
    color: var(--vx-muted);
}

.value {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

.add-component {
    margin-top: 10px;
    height: 28px;
    border: 1px dashed var(--vx-line-2);
    background-color: transparent;
    color: var(--vx-muted);
    font-weight: 500;
}

/* A model's import settings' Revert and Apply, at the section's end. */
.import-buttons {
    justify-content: flex-end;
    gap: 6px;
    padding-top: 8px;
}

.import-button {
    height: 24px;
    padding: 0px 12px;
    border-radius: 6px;
}

/* A sound's Play button, which reads Stop while the sound plays. */
.listen {
    margin-top: 8px;
    height: 26px;
    gap: 6px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
}

.listen Icon {
    width: 12px;
    height: 12px;
}

.add-component:hover {
    border-color: var(--vx-accent);
    background-color: var(--vx-accent-soft);
    color: var(--vx-text);
}

/* The Project: folders on the left, what is in the open one on the right,
   as tiles when there is room and as rows when there is not. */

DockSpace .project-split > .split-divider {
    width: 1px;
    background-color: var(--vx-line);
}

.folders {
    padding-top: 2px;
}

.files-pane {
    flex-grow: 1;
    min-width: 0px;
}

.breadcrumb {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0px 10px;
    gap: 6px;
    flex-shrink: 0;
}

.crumbs {
    flex-grow: 1;
    flex-basis: 0px;
    color: var(--vx-muted);
}

.count {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
}

/* How big the Project panel's tiles are, rows at its far left, as Unity's. */
.size-slider {
    width: 72px;
    flex-shrink: 0;
    margin-left: 10px;
}

.size-slider > .slider-value {
    display: none;
}

.file-size {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

/* Rows keep clear of the scroll bar, sizes and arrows lined up down the list. */
.files .list-row {
    padding-right: 10px;
}

.part-arrow.unused {
    opacity: 0;
}

.tile-row {
    padding: 0px 2px;
    gap: 2px;
    align-items: stretch;
}

.tile-row:hover, .tile-row:selected {
    background-color: transparent;
}

.tile {
    width: 70px;
    padding: 6px 3px 4px 3px;
    gap: 4px;
    align-items: center;
    overflow: hidden;
    border-radius: 6px;
    transition: background-color var(--vx-fade);
}

.tile:hover {
    background-color: var(--vx-hover);
}

.tile:checked {
    background-color: var(--vx-selected);
}

/* A script's code in the Inspector, coloured as a code editor colours it. */
.code-preview {
    padding: 8px 10px;
    border-radius: 6px;
    background-color: var(--vx-bg);
    font-family: mono;
    font-size: 11px;
    line-height: 17px;
    color: var(--vx-text-2);
}

/* The arrow that opens a model out to its parts: on a tile's right edge, at a row's end. */
.part-arrow {
    width: 18px;
    height: 18px;
    padding: 1px;
}

.tile .part-arrow {
    position: absolute;
    right: -4px;
    top: 16px;
}

/* A model's part, after the model: indented in rows, on a ground of its own as tiles. */
.list-row.part {
    padding-left: 26px;
}

.tile.part {
    background-color: var(--vx-field);
}

/* A folder, as a tile or in the tree, that an Obj dragged over it would be
   made a prefab in. */
.tile.drop-hover, .folder-row.drop-hover {
    background-color: var(--vx-accent-soft);
    border-radius: 6px;
}

/* A row or tile a log line points at, lit for a moment, as Unity pings. */
.list-row.pinged, .tile.pinged {
    background-color: var(--vx-accent-soft);
    color: var(--vx-text);
}

.tile-icon {
    width: 26px;
    height: 26px;
    color: var(--vx-muted);
}

.tile:checked .tile-icon {
    color: var(--vx-accent);
}

/* A tile's or row's icon, or the preview in its place. */
.tile-thumb, .row-thumb, .picker-thumb {
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.tile-thumb {
    width: 44px;
    height: 44px;
}

.row-thumb {
    width: 16px;
    height: 16px;
}

.picker-thumb {
    width: 22px;
    height: 22px;
}

.thumb-image {
    width: 100%;
    height: 100%;
    border-radius: 4px;
}

.tile-thumb > .thumb-image {
    border-radius: 6px;
}

.tile-name {
    font-size: 11px;
    text-align: center;
    color: var(--vx-text-2);
}

/* The Levels panel. */

.level-heading {
    font-size: 11px;
    font-weight: 600;
    color: var(--vx-muted);
}

.level-heading:hover, .level-heading:selected {
    background-color: transparent;
}

.level-current .row-name {
    color: var(--vx-text);
    font-weight: 600;
}

.level-current .row-icon {
    color: var(--vx-accent);
}

.level-play {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

.level-play > Icon {
    width: 10px;
    height: 10px;
}

.level-progress {
    margin: 0px 8px 8px 8px;
    gap: 5px;
    flex-shrink: 0;
}

.level-progress-text {
    font-size: 11px;
    color: var(--vx-text-2);
}

.level-progress-track {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-seg-on);
}

.level-progress-fill {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-accent);
    transition: background-color var(--vx-fade);
}

/* The Console. */

/* The Console, after Sifter: a toolbar, one line per row in columns, and
   the selected line's stack under them. Monospaced throughout. */
.console-panel {
    flex-direction: column;
    font-family: mono;
    font-size: 11px;
}

/* It wraps, so a narrow Console keeps every control on screen. */
.console-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    min-height: 30px;
    padding: 4px 8px;
    column-gap: 6px;
    row-gap: 4px;
}

.console-button {
    height: 22px;
    padding: 0px 8px;
    flex-shrink: 0;
    border-radius: 5px;
    font-family: sans;
    color: var(--vx-muted);
    background-color: transparent;
}

.console-button:hover {
    color: var(--vx-text);
    background-color: var(--vx-field);
}

.console-button:checked {
    color: var(--vx-text);
    background-color: var(--vx-selected);
}

.console-search {
    flex-basis: 180px;
    flex-grow: 1;
    max-width: 320px;
    flex-shrink: 0;
}

.console-search.bad {
    border-color: var(--vx-x);
}

.console-level {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 22px;
    padding: 0px 6px;
    gap: 4px;
    border-radius: 5px;
    color: var(--vx-muted);
    opacity: 0.5;
}

.console-level:checked {
    opacity: 1;
    background-color: var(--vx-field);
}

.console-level-icon {
    width: 12px;
    height: 12px;
}

.level-warning .console-level-icon {
    color: var(--ed-warn);
}

.level-error .console-level-icon {
    color: var(--vx-x);
}

.console-problem {
    flex-shrink: 0;
    padding: 3px 10px;
    color: var(--vx-x);
}

.console .list-row {
    flex-direction: row;
    align-items: center;
    padding: 0px 8px;
    gap: 8px;
    color: var(--vx-text-2);
}

.console-icon {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
    color: var(--vx-muted);
}

.console-time {
    width: 62px;
    flex-shrink: 0;
    color: var(--vx-muted);
}

/* A line's category, in the colour the project gave it. */
.console-category {
    width: 76px;
    flex-shrink: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--vx-muted);
}

.console-filter-name {
    flex-basis: 180px;
    flex-shrink: 0;
}

.console-message {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    white-space: nowrap;
    overflow: hidden;
}

.console-count {
    flex-shrink: 0;
    padding: 0px 5px;
    border-radius: 7px;
    font-size: 10px;
    color: var(--vx-text);
    background-color: var(--vx-selected);
}

.console-source {
    flex-shrink: 0;
    color: var(--vx-muted);
}

/* Warnings and errors take their own colour, which the eye lands on: the
   mark always, the line when Colour by kind is on. */
.list-row.log-warn, .console-icon.warn {
    color: var(--ed-warn);
}

.list-row.log-error, .console-icon.error {
    color: var(--vx-x);
}

/* Alternating rows, kept under hover and selection. */
.console .list-row.odd {
    background-color: rgba(255, 255, 255, 0.025);
}

.console .list-row.odd:hover {
    background-color: var(--vx-hover);
}

.console .list-row.odd:selected {
    background-color: var(--vx-selected);
}

/* A category shown as a dot in its colour. */
.console-category.dot {
    width: 10px;
}

.console-detail {
    flex-direction: column;
}

.console-detail-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 28px;
    padding: 0px 8px;
    gap: 6px;
}

.console-info {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    white-space: nowrap;
    overflow: hidden;
    color: var(--vx-muted);
}

.console-detail-body {
    padding: 4px 12px 10px 12px;
    gap: 6px;
}

.console-detail-message {
    color: var(--vx-text);
}

.console-detail-message.log-warn {
    color: var(--ed-warn);
}

.console-detail-message.log-error {
    color: var(--vx-x);
}

.console-trace {
    line-height: 17px;
    link-color: #c3a6ff;
}

/* The status bar: a light and what the editor is doing on the left, the
   numbers on the right. */

.statusbar {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0px 12px;
    gap: 12px;
    font-size: 11px;
    color: var(--vx-muted);
}

.status-dot {
    width: 6px;
    height: 6px;
    margin-right: -6px;
    border-radius: 3px;
    background-color: var(--vx-success);
}

/* While the scripts build, the dot breathes in the accent colour. */
@keyframes busy-pulse {
    from { opacity: 1; }
    to { opacity: 0.25; }
}

.status-dot.busy {
    background-color: var(--vx-accent);
    animation: busy-pulse 700ms ease-in-out infinite alternate;
}

.status-text {
    color: var(--vx-text-2);
}

/* Numbers that change, in figures of one width so they do not shift. */
.status-number {
    font-family: mono;
    font-size: 10px;
}

.status-branch {
    flex-direction: row;
    align-items: center;
    gap: 4px;
}

.status-branch > Icon {
    width: 12px;
    height: 12px;
}

/* The Profiler: recent frames as a chart, over one frame broken down. */
.profiler-panel {
    flex-direction: column;
    font-size: 11px;
}

.profiler-summary {
    flex-grow: 1;
    text-align: right;
    font-family: mono;
    color: var(--vx-text-2);
}

.profiler-chart {
    flex-shrink: 0;
    height: 120px;
    margin: 8px 10px 4px 10px;
    border-radius: 6px;
    background-color: var(--vx-bg);
}

.profiler-guide {
    position: absolute;
    left: 6px;
    font-family: mono;
    font-size: 10px;
    color: var(--vx-muted);
}

.profiler-legend {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    height: 24px;
    padding: 0px 10px;
    color: var(--vx-muted);
}

.profiler-swatch {
    width: 10px;
    height: 3px;
    border-radius: 2px;
}

.profiler-swatch.cpu {
    background-color: var(--vx-accent);
}

.profiler-swatch.gpu {
    background-color: var(--vx-success);
}

.profiler-picked {
    flex-grow: 1;
    text-align: right;
    font-family: mono;
}

/* Below the chart: the Hierarchy of samples, and the GPU's passes and the
   frame's counts beside it. */
.profiler-lower {
    flex-direction: row;
    align-items: stretch;
}

.profiler-hierarchy {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
}

/* Lined up with the tree's rows: their margin and padding, and their gap. */
.profiler-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    height: 24px;
    padding: 0px 14px 0px 32px;
    border-bottom: 1px solid var(--vx-line);
    color: var(--vx-muted);
}

.profiler-tree .list-row {
    padding-right: 10px;
}

.profiler-tree .tree-content {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0px;
}

.profiler-cell-name {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    color: var(--vx-text-2);
}

.profiler-cell {
    flex-shrink: 0;
    width: 62px;
    text-align: right;
    font-family: mono;
    color: var(--vx-text-2);
}

.profiler-header > .profiler-cell, .profiler-header > .profiler-cell-name {
    font-family: sans;
    color: var(--vx-muted);
}

.profiler-side {
    flex-direction: column;
    flex-shrink: 0;
    width: 280px;
    gap: 14px;
    padding: 8px 10px;
    border-left: 1px solid var(--vx-line);
    overflow: scroll;
}

.profiler-column {
    flex-direction: column;
    flex-shrink: 0;
    gap: 2px;
}

.profiler-heading {
    height: 20px;
    font-weight: 600;
    color: var(--vx-text);
}

.profiler-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 8px;
    height: 20px;
}

.profiler-name {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    color: var(--vx-text-2);
}

.profiler-track {
    flex-shrink: 0;
    width: 60px;
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-field);
}

.profiler-fill {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-accent);
}

.profiler-value {
    flex-shrink: 0;
    width: 64px;
    text-align: right;
    font-family: mono;
    color: var(--vx-text-2);
}

/* The object picker: the palette's look, under a reference field, with a
   title naming what the field takes and its own search box. */
.picker {
    flex-direction: column;
    gap: 4px;
}

.picker-title {
    padding: 4px 6px 0px 6px;
    font-weight: 600;
    color: var(--vx-text);
}

/* The picker's title, with a back button while it is inside a folder. */
.picker-head {
    flex-direction: row;
    align-items: center;
}

.picker-back {
    width: 22px;
    height: 22px;
    margin: 2px 0px 0px 2px;
    padding: 0px;
    justify-content: center;
    align-items: center;
    background-color: transparent;
    border-color: transparent;
}

.picker-search {
    flex-shrink: 0;
}

/* The Build window: profiles on the left, the picked one's settings and its
   build beside them. */
.build-panel {
    flex-direction: column;
    font-size: 12px;
    /* Sized by its dock area, as VoxDocs is, rather than by the settings in it. */
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
}

.build-main {
    flex-direction: row;
    align-items: stretch;
    min-height: 0px;
}

.build-profiles {
    flex-direction: column;
    flex-shrink: 0;
    width: 200px;
    padding: 6px 0px;
    background-color: var(--vx-bg);
    min-height: 0px;
}

.build-heading {
    height: 22px;
    padding: 0px 10px;
    font-weight: 600;
    color: var(--vx-muted);
}

.build-profile-name {
    flex-grow: 1;
    min-width: 0px;
}

.build-empty {
    flex-direction: column;
    gap: 8px;
    padding: 4px 10px;
}

.build-hint {
    white-space: normal;
    color: var(--vx-text-2);
}

.build-detail {
    flex-direction: column;
    min-width: 0px;
    min-height: 0px;
}

.build-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    height: 40px;
    padding: 0px 10px;
}

.build-title {
    flex-grow: 1;
    min-width: 0px;
    font-size: 14px;
    font-weight: 600;
    color: var(--vx-text);
}

.build-button {
    height: 24px;
    padding: 0px 10px;
    flex-shrink: 0;
    border-radius: 6px;
}

/* Shrinks and scrolls when the window is short, leaving the log room. */
.build-settings {
    flex-direction: column;
    flex-shrink: 1;
    min-height: 80px;
    gap: 2px;
    padding: 0px 10px 8px 10px;
    overflow: scroll;
}

.build-setting {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    height: 26px;
}

.build-key {
    flex-shrink: 0;
    width: 110px;
    color: var(--vx-muted);
}

.build-problem {
    white-space: normal;
    color: var(--vx-x);
}

/* Each stage as a chip: a dot that lights while it runs and stays lit once
   done, its name, and its time. */
.build-stages {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    height: 36px;
    padding: 0px 10px;
}

.build-stage {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0px 8px;
    border-radius: 6px;
    color: var(--vx-muted);
    background-color: var(--vx-field);
}

.build-stage-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--vx-line-2);
}

.build-stage.running {
    color: var(--vx-text);
}

.build-stage.running .build-stage-dot {
    background-color: var(--vx-accent);
}

.build-stage.done .build-stage-dot {
    background-color: var(--vx-success);
}

.build-stage.failed .build-stage-dot {
    background-color: var(--vx-x);
}

.build-stage-time {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

.build-result {
    flex-grow: 1;
    min-width: 0px;
    text-align: right;
    color: var(--vx-text-2);
}

.build-progress {
    flex-direction: column;
    flex-shrink: 0;
    gap: 5px;
    padding: 0px 10px 8px 10px;
}

.build-progress-text {
    font-size: 11px;
    color: var(--vx-text-2);
}

.build-progress-track {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-seg-on);
}

.build-progress-fill {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-accent);
}

/* The build's settings, edited in place, and the log's level buttons. */
.build-control {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    max-width: 320px;
}

/* The profile's name, typed in to rename it: a title until it is clicked. */
TextField.build-title {
    background-color: transparent;
    border: 0px solid transparent;
    padding: 0px 4px;
}

TextField.build-title:focus {
    background-color: var(--vx-field);
}

/* New and Remove, under the profiles. */
.build-profile-tools {
    flex-direction: row;
    gap: 6px;
    padding: 6px 8px 0px 8px;
}

/* A setting shown as fields: the level fields and the list of defines. */
.build-setting-list {
    height: auto;
    align-items: flex-start;
    padding: 2px 0px;
}

.build-setting-list .build-key {
    padding-top: 4px;
}

.build-fields-items {
    flex-direction: column;
    gap: 4px;
}

.build-field-row {
    flex-direction: row;
    align-items: center;
    gap: 4px;
}

.build-level-field, .build-word-field {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
}

.build-level-field {
    justify-content: flex-start;
}

/* A list setting's collection field fills the row, each field its item's width. */
.build-setting-list > .collection {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    margin: 0px;
}

.collection-body > .build-level-field, .collection-body > .build-word-field {
    flex-grow: 0;
    flex-basis: auto;
}

.build-fields-empty {
    color: var(--vx-muted);
    padding: 4px 0px;
}

.build-fields-add {
    align-self: flex-start;
    margin-top: 4px;
}

.build-base {
    flex-shrink: 0;
    margin-right: 8px;
    font-size: 11px;
    color: var(--vx-muted);
}

.build-log-levels {
    flex-direction: row;
    flex-shrink: 0;
    gap: 4px;
    padding: 0px 8px 4px 8px;
}

.build-log-level {
    height: 22px;
    padding: 0px 8px;
    border-radius: 5px;
    font-size: 11px;
    color: var(--vx-muted);
    background-color: transparent;
    border-color: transparent;
}

.build-log-level:checked {
    color: var(--vx-text);
    background-color: var(--vx-selected);
}

.build-log {
    margin: 0px 6px 6px 6px;
    border-radius: 6px;
    font-family: mono;
    font-size: 11px;
    background-color: var(--vx-bg);
    /* Room for a few lines, which the settings above give up first. */
    min-height: 100px;
}

.build-log-message {
    flex-grow: 1;
    min-width: 0px;
}

/* Inspector attributes on script fields. */

/* [HideLabel]: the control takes the whole row. */
.prop.no-label {
    grid-template-columns: minmax(0px, 1fr);
}

/* [EnableIf] and [DisableIf] that do not hold. */
.prop.disabled {
    opacity: 0.45;
}

.attr-title {
    margin-top: 6px;
    font-weight: 600;
    color: var(--vx-text);
}

.attr-title-line {
    height: 1px;
    flex-shrink: 0;
    margin-bottom: 2px;
    background-color: var(--vx-line);
}

.attr-foldout > .foldout-header {
    height: 26px;
    color: var(--vx-text-2);
}

.attr-box {
    flex-direction: column;
    flex-shrink: 0;
    gap: 2px;
    margin: 4px 0px;
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid var(--vx-line-2);
}

.attr-box-title {
    font-weight: 600;
    color: var(--vx-text-2);
}

.attr-horizontal {
    flex-direction: row;
    gap: 8px;
}

.attr-horizontal > .prop {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
}

.attr-tabs {
    margin: 4px 0px;
}

.attr-tab-page {
    flex-direction: column;
    padding-top: 4px;
}

.attr-suffix {
    flex-shrink: 0;
    color: var(--vx-muted);
    font-size: 11px;
}

.attr-range {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    min-width: 0px;
}

.prop-value > .attr-range, .prop-value > .attr-buttons, .prop-value > .attr-progress {
    flex-grow: 1;
}

.attr-slider {
    flex-grow: 1;
    min-width: 0px;
}

/* The field beside it shows the value, and takes typing. */
.attr-slider > .slider-value {
    display: none;
}

.attr-range-input {
    flex-shrink: 0;
    width: 58px;
}

.attr-buttons {
    min-width: 0px;
}

/* A [TableList]: a column for each field, a row for each item. */
.attr-table {
    display: grid;
    column-gap: 4px;
    row-gap: 3px;
    margin: 2px 0px 4px 0px;
}

.attr-table-head {
    font-size: 11px;
    color: var(--vx-muted);
    white-space: nowrap;
}

.attr-table-cell {
    min-width: 0px;
    align-items: center;
}

.attr-table-cell > .value-input {
    flex-grow: 1;
    min-width: 0px;
}

/* A [ListDrawerSettings] list's page buttons. */
.attr-pager {
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    margin: 2px 0px 4px 0px;
}

.attr-pager-text {
    font-size: 11px;
    color: var(--vx-muted);
}

/* A [ColorPalette]'s swatches under its colour. */
.attr-palette {
    flex-wrap: wrap;
    gap: 4px;
    margin: 2px 0px 4px 0px;
    justify-content: flex-end;
}

.attr-palette-swatch {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid var(--vx-field-line);
}

.attr-palette-swatch:hover {
    border-color: var(--vx-text-2);
}

/* A behaviour's [Button]s, under its fields. */
.attr-buttons-column {
    gap: 4px;
    margin-top: 6px;
}

.attr-progress {
    height: 20px;
    justify-content: center;
    border-radius: 5px;
    overflow: hidden;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.attr-progress-fill {
    position: absolute;
    left: 0px;
    top: 0px;
    bottom: 0px;
    background-color: var(--vx-accent-soft);
}

.attr-progress-value {
    text-align: center;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text);
}

/* A LOD Group's levels as a bar, as Unity draws it: most detailed on the
   left, edges to drag between levels, the selected level outlined, and the
   camera's mark on a ruler above. */
.lod-ruler {
    height: 16px;
    margin-top: 2px;
}

.lod-eye {
    position: absolute;
    top: 0px;
    pointer-events: none;
    align-items: center;
    gap: 3px;
    margin-left: -6px;
}

.lod-eye-icon {
    width: 12px;
    height: 12px;
    color: var(--vx-text-2);
}

.lod-eye-text {
    font-family: mono;
    font-size: 10px;
    color: var(--vx-text-2);
}

.lod-bar {
    flex-direction: row;
    height: 36px;
    margin-bottom: 6px;
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid var(--vx-field-line);
    background-color: var(--vx-field);
}

.lod-segment {
    position: absolute;
    top: 0px;
    bottom: 0px;
    justify-content: center;
    padding: 0px 7px;
    overflow: hidden;
    border: 1px solid transparent;
}

.lod-segment.lod-selected {
    border-color: var(--vx-accent);
}

.lod-segment-name {
    font-size: 11px;
    white-space: nowrap;
    color: var(--vx-text);
}

.lod-segment-end {
    font-family: mono;
    font-size: 10px;
    white-space: nowrap;
    color: var(--vx-muted);
}

.lod-level-0 { background-color: rgba(76, 183, 130, 0.30); }
.lod-level-1 { background-color: rgba(64, 170, 190, 0.30); }
.lod-level-2 { background-color: rgba(94, 139, 240, 0.30); }
.lod-level-3 { background-color: rgba(140, 120, 240, 0.30); }
.lod-level-4 { background-color: rgba(200, 110, 210, 0.30); }
.lod-level-5 { background-color: rgba(226, 179, 64, 0.30); }

.lod-culled {
    background-color: rgba(235, 87, 87, 0.18);
}

.lod-edge {
    position: absolute;
    top: 0px;
    bottom: 0px;
    width: 8px;
    margin-left: -4px;
    align-items: center;
}

.lod-edge-line {
    width: 2px;
    height: 100%;
    background-color: var(--vx-panel);
}

.lod-edge:hover > .lod-edge-line {
    background-color: var(--vx-accent);
}

.lod-marker {
    position: absolute;
    top: 0px;
    bottom: 0px;
    width: 2px;
    margin-left: -1px;
    background-color: var(--vx-text);
    pointer-events: none;
}

/* A mesh's LODs on the same bar: the one drawn now outlined, and one forced
   filled. */
.lod-segment.lod-drawn {
    border-color: var(--vx-accent);
}

.lod-segment.lod-forced > .lod-segment-name {
    color: var(--vx-accent);
}

.attr-preview {
    justify-content: flex-end;
    padding: 4px 0px;
}

.attr-preview > Image {
    border-radius: 6px;
    background-color: var(--vx-field);
}

/* [InfoBox] and [Required]: a note, a warning or an error above a field. */
.info-box {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    gap: 6px;
    margin: 3px 0px;
    padding: 6px 8px;
    border-radius: 6px;
    background-color: rgba(121, 136, 255, 0.10);
    border: 1px solid rgba(121, 136, 255, 0.30);
}

.info-box.warning {
    background-color: rgba(226, 179, 64, 0.10);
    border-color: rgba(226, 179, 64, 0.35);
}

.info-box.error {
    background-color: rgba(235, 87, 87, 0.10);
    border-color: rgba(235, 87, 87, 0.40);
}

.info-icon {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    color: var(--vx-accent);
}

.info-box.warning > .info-icon {
    color: #e2b340;
}

.info-box.error > .info-icon {
    color: var(--vx-x);
}

.info-text {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    color: var(--vx-text-2);
}

/* [Tooltip], under a field's label. */
.tooltip {
    position: absolute;
    z-index: 30;
    max-width: 280px;
    padding: 5px 8px;
    border-radius: 5px;
    pointer-events: none;
    background-color: var(--vx-overlay);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 6px 16px rgba(0, 0, 0, 0.4);
    color: var(--vx-text);
    font-size: 11px;
}

/* A field the scripts' drawers draw: their markup in a row, with the Inspector's own control in their "next" element. */
.field-drawer-slot, .field-drawer, .field-drawer-next {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    flex-grow: 1;
    min-width: 0px;
}

/* A behaviour's inspector stacks its elements down the section, its usual fields among them. */
.behaviour-inspector {
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
}

.field-drawer-slot > .value-input, .field-drawer-slot > .value-picker, .field-drawer-slot > .vector, .field-drawer-slot > .value,
.field-drawer-next > .value-input, .field-drawer-next > .value-picker, .field-drawer-next > .vector, .field-drawer-next > .value {
    flex-grow: 1;
    min-width: 0px;
}

/* The Entities panel, the ECS inspector: archetypes, their entities, the picked one's components, and the systems. */
.entities-summary {
    flex-grow: 1;
    color: var(--vx-text-2);
}

.entities-search {
    width: 280px;
}

.entities-columns {
    flex-direction: row;
    align-items: stretch;
}

/* Each list in a pane of its own, the lines between them dragging to share the room out. */
.entities-column {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    padding: 6px 8px;
}

.entities-details, .entities-schedule {
    gap: 2px;
    overflow: scroll;
}

.entities-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 0px 6px;
}

.entities-row-name {
    flex-grow: 1;
    min-width: 0px;
    overflow: hidden;
    white-space: nowrap;
}

.entities-archetype-count {
    width: 92px;
}

/* The picked archetype's chunks, each a bar filled as far as it is. */
.entities-chunks {
    flex-wrap: wrap;
    gap: 2px;
    margin-bottom: 6px;
}

.entities-chunk {
    width: 8px;
    height: 18px;
    border-radius: 2px;
    background-color: var(--vx-field);
    justify-content: flex-end;
}

.entities-chunk-fill {
    border-radius: 2px;
    background-color: var(--vx-accent);
}

.entities-value-input {
    width: 150px;
    height: 20px;
}

.entities-row-count, .entities-value-text {
    flex-shrink: 0;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

.entities-component {
    flex-direction: column;
    gap: 2px;
    padding: 4px 0px;
}

.entities-component-name, .entities-stage {
    font-weight: 600;
    color: var(--vx-text);
}

.entities-stage {
    margin-top: 6px;
}

.entities-value {
    flex-direction: row;
    gap: 8px;
}

.entities-value-name {
    flex-grow: 1;
    min-width: 0px;
    color: var(--vx-muted);
}

.entities-script {
    color: var(--vx-accent);
}

.entities-hint {
    color: var(--vx-muted);
}

/* The Memory panel: its amounts' part and change columns line up. */
.memory-part {
    flex-shrink: 0;
    width: 96px;
    color: var(--vx-muted);
    white-space: nowrap;
}

.memory-change {
    flex-shrink: 0;
    width: 84px;
    text-align: right;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

/* The lines between columns that drag: a hairline in a wider strip that takes the pointer, lit while it is. */
DockSpace .resizable-columns > .split-divider {
    width: 7px;
}

DockSpace .resizable-columns > .split-divider > .split-handle {
    width: 1px;
    height: 100%;
    max-height: 100000px;
    border-radius: 0px;
    background-color: var(--vx-line);
}

DockSpace .resizable-columns > .split-divider:hover > .split-handle,
DockSpace .resizable-columns > .split-divider:active > .split-handle {
    width: 2px;
    background-color: var(--vx-accent);
}

/* A table's header, whose column edges drag, and its rows, whose cells line up with it and cut off what does not
   fit. */
.table-header {
    flex-shrink: 0;
    height: 22px;
    padding: 0px 6px;
}

.table-heading {
    min-width: 0px;
    padding-top: 4px;
    overflow: hidden;
    white-space: nowrap;
    font-size: 11px;
    color: var(--vx-muted);
}

.table-row {
    gap: 0px;
}

.table-row > Label {
    min-width: 0px;
    padding-right: 8px;
    overflow: hidden;
    white-space: nowrap;
}

/* The Frame Debugger: the frame's passes, the picked pass's images, and the picked image as it was. */
.frame-debugger-panel {
    flex-direction: column;
    font-size: 11px;
}

.frame-passes {
    border-left: 0px solid var(--vx-line);
}

.frame-view {
    flex-grow: 2.4;
    gap: 6px;
    overflow: scroll;
}

.frame-view-title {
    color: var(--vx-text);
}

.frame-view-controls {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.frame-view-mip {
    width: 140px;
}

.frame-view-exposure {
    width: 120px;
}

/* The stops beside it say what the slider is at. */
.frame-view-exposure .slider-value {
    display: none;
}

.frame-view-image {
    width: 100%;
    border-radius: 4px;
    border: 1px solid var(--vx-line);
}

/* The Profiler's Timeline: the frame's runs as bars, the one pointed at named above. */
.profiler-view {
    margin-left: 6px;
}

.profiler-timeline {
    padding: 4px 8px;
    gap: 4px;
}

.profiler-hovered {
    flex-shrink: 0;
    height: 18px;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

/* As tall as its lanes, which the code sets, in a view that scrolls them. */
.profiler-canvas {
    flex-shrink: 0;
}

/* A worker thread's title above its lane of bars. */
.profiler-thread-title {
    color: var(--vx-muted);
    font-weight: 600;
}

.profiler-bar-name {
    position: absolute;
    font-size: 11px;
    color: #ffffff;
    white-space: nowrap;
    pointer-events: none;
}

/* [Documentation]: a book button on a section or beside a field, opening
   its VoxDocs page. */
.docs-link {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--vx-muted);
}

.docs-link:hover {
    color: var(--vx-accent);
}

/* [Excerpt]: part of a VoxDocs page above a field, in a fold. */
.excerpt {
    flex-shrink: 0;
    margin: 3px 0px;
    border-radius: 6px;
    background-color: var(--vx-field);
}

.excerpt > .foldout-header {
    height: 26px;
    padding: 0px 8px;
}

.excerpt .foldout-icon {
    width: 13px;
    height: 13px;
    color: var(--vx-accent);
}

.excerpt > .foldout-content {
    padding: 0px 10px 8px 10px;
}

.excerpt-missing {
    color: var(--vx-muted);
}

/* The Console's settings, in its place: a sample drawn as the Console draws
   its lines, then each option, its words on the left and its choices on the
   right. */
.console-settings-head {
    align-items: center;
    flex-shrink: 0;
    gap: 8px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--vx-line);
}

.console-settings-body {
    padding: 0px 14px 18px 14px;
    gap: 6px;
}

.console-settings-title {
    flex-grow: 1;
    font-size: 13px;
    font-weight: 600;
    color: var(--vx-text);
}

.console-settings-section {
    flex-shrink: 0;
    margin-top: 10px;
    font-weight: 600;
    color: var(--vx-text);
}

.console-settings-box {
    flex-shrink: 0;
    border-radius: 7px;
    border: 1px solid var(--vx-line);
    padding: 4px 0px;
}

.console-sample {
    flex-shrink: 0;
    padding: 4px 0px;
}

.console-sample-trace {
    padding: 6px 12px 2px 12px;
}

.console-option {
    flex-shrink: 0;
    align-items: center;
    gap: 14px;
    padding: 6px 12px;
}

.console-option-words {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    gap: 2px;
}

.console-option-title {
    color: var(--vx-text);
}

.console-option-note, .console-settings-note {
    color: var(--vx-muted);
}

.console-settings-note {
    padding: 4px 12px;
}

.console-option-control {
    flex-shrink: 0;
    gap: 2px;
}

.console-segment {
    height: 22px;
    padding: 0px 9px;
    border-radius: 5px;
    color: var(--vx-text-2);
    background-color: var(--vx-field);
}

.console-segment:checked {
    color: var(--vx-on-accent);
    background-color: var(--vx-accent);
}

.console-swatch {
    width: 16px;
    height: 16px;
    padding: 0px;
    border-radius: 8px;
    border: 2px solid transparent;
}

.console-swatch-own {
    background-color: var(--vx-field);
    border-color: var(--vx-line-2);
}

.console-swatch:checked {
    border-color: var(--vx-text);
}

.console-settings-reset {
    align-self: flex-start;
    margin: 6px 12px 4px 12px;
}

/* The Input Actions window: a bar over the key map, and its legend. */
.input-panel {
    flex-direction: column;
    padding: 8px 10px;
    gap: 8px;
}

.input-bar {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

/* What a string table's sheet read back would add, change and take away, a line a key. */
.strings-report {
    color: var(--vx-muted);
    font-family: mono;
    padding: 4px 0px;
}

/* The Localization Tables window: the search over its keys, and under the table the picked key's rename field and
   where it is used. */
.localization-search {
    width: 220px;
}

.localization-details {
    flex-direction: column;
    gap: 4px;
    padding: 8px 10px;
    border-top: 1px solid var(--vx-line);
    flex-shrink: 0;
}

.localization-rename {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.localization-usage {
    color: var(--vx-muted);
    font-family: mono;
}

/* The window's two views, Actions and Layout, each a column filling it. */
.input-view {
    flex-direction: column;
    gap: 8px;
}

/* Each Actions column's title, with the buttons that add to it. */
.input-heading {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
}

/* An Actions row: its icon, what it says, its control's device after it, and a mark when it conflicts; every
   other row a shade lighter, to follow along. */
.input-row.odd {
    background-color: rgba(255, 255, 255, 0.025);
}

.input-row.odd:hover {
    background-color: var(--vx-hover);
}

.input-row.odd:selected {
    background-color: var(--vx-selected);
}

.input-row-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--vx-muted);
}

.input-row-detail {
    flex-shrink: 0;
    font-size: 11px;
    color: var(--vx-muted);
}

.input-row-conflict {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--vx-danger);
}

.input-row.conflict > .entities-row-name {
    color: var(--vx-danger);
}

/* A binding or part not given a control yet: "None", quietly, as a placeholder. */
.input-row.unset > .entities-row-name {
    color: var(--vx-muted);
}

/* A new action's name, typed over in its row. */
.input-row-rename {
    flex-grow: 1;
    min-width: 0px;
    height: 20px;
}

/* The binding's control, which opens the control picker, reads as a field. */
.input-picker {
    justify-content: flex-start;
    min-width: 0px;
    overflow: hidden;
    white-space: nowrap;
}

.input-icon-name {
    color: var(--vx-muted);
}

/* A processor: its kind, then a short field for each of its values after its name, across the whole width and
   onto another line when the column is narrow. */
.input-processor-row {
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    padding-left: 12px;
}

/* The processor's kind and values. */
.input-processor {
    flex-shrink: 0;
}

.input-value-name {
    color: var(--vx-muted);
    flex-shrink: 0;
}

.input-value {
    width: 44px;
    flex-shrink: 1;
    min-width: 32px;
}

.input-properties {
    flex-direction: column;
    gap: 4px;
}

.input-property {
    width: 76px;
    flex-shrink: 0;
    color: var(--vx-muted);
}

/* A property's text field takes the rest of its row. */
.input-field {
    flex-grow: 1;
}

.input-legend {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
}

.input-legend-entry {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.keymap-key.input-legend-swatch {
    width: 14px;
    height: 14px;
    border-radius: 3px;
}

.input-legend-label {
    color: var(--vx-muted);
}

/* The Package Manager, as Unity's: the toolbar, the project's packages on the left with the progress line under
   them, and the picked one's details on the right. The forms open under the + button, and the dialog asking before
   code arrives covers the window. */
.packages-panel {
    flex-direction: column;
    font-size: 12px;
    /* Sized by its dock area, as the Build window is, so its forms and dialog can cover it. */
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
}

.packages-add {
    flex-direction: row;
    align-items: center;
    gap: 2px;
    padding: 0px 6px;
}

.packages-add-arrow {
    width: 12px;
    height: 12px;
    color: var(--vx-muted);
}

.packages-search {
    width: 220px;
    margin: 0px;
}

.packages-side {
    background-color: var(--vx-bg);
}

.packages-row {
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    gap: 2px;
}

.packages-row-top {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.packages-row-title {
    flex-grow: 1;
    min-width: 0px;
    overflow: hidden;
    font-weight: 500;
    color: var(--vx-text);
}

.packages-row-version {
    flex-shrink: 0;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

/* A newer release or commit, in the accent beside the version in use. */
.packages-row-update {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 2px;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-accent);
}

.packages-row-update > Icon {
    width: 12px;
    height: 12px;
}

.packages-row-line {
    overflow: hidden;
    font-size: 11px;
    color: var(--vx-muted);
}

.packages-error {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    gap: 6px;
    margin: 4px 6px;
    padding: 6px 8px;
    border-radius: 6px;
    background-color: rgba(235, 87, 87, 0.12);
    border: 1px solid rgba(235, 87, 87, 0.35);
}

.packages-error-text {
    flex-grow: 1;
    min-width: 0px;
    white-space: normal;
    color: var(--vx-x);
}

.packages-error > .icon-button {
    width: 18px;
    height: 18px;
}

.packages-foot {
    flex-shrink: 0;
    min-height: 34px;
    justify-content: center;
    border-top: 1px solid var(--vx-line);
}

.packages-status {
    padding: 0px 10px;
    font-size: 11px;
    color: var(--vx-text-2);
}

.packages-progress {
    padding-top: 6px;
}

.packages-progress .build-progress-track {
    overflow: hidden;
}

.packages-detail {
    position: relative;
}

.packages-detail-body {
    flex-direction: column;
    gap: 4px;
    padding: 10px 14px;
    overflow: scroll;
}

.packages-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    min-height: 28px;
}

.packages-title {
    flex-grow: 1;
    min-width: 0px;
    font-size: 16px;
    font-weight: 600;
    color: var(--vx-text);
}

.packages-subtitle {
    flex-shrink: 0;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
    margin-bottom: 6px;
}

.packages-fields {
    flex-shrink: 0;
    gap: 2px;
    margin-bottom: 6px;
}

.packages-field {
    flex-direction: row;
    align-items: flex-start;
    gap: 8px;
    min-height: 20px;
}

.packages-value {
    flex-grow: 1;
    min-width: 0px;
    white-space: normal;
    color: var(--vx-text-2);
}

.packages-text {
    flex-shrink: 0;
    white-space: normal;
    color: var(--vx-text-2);
}

.packages-readme {
    flex-direction: column;
    flex-shrink: 0;
    gap: 6px;
    padding: 4px 10px 10px 10px;
    border-radius: 6px;
    background-color: var(--vx-bg);
}

/* The README's Markdown, as VoxDocs draws a page but smaller. */
.packages-readme .md-p, .packages-readme .md-item-body {
    white-space: normal;
    color: var(--vx-text-2);
    line-height: 18px;
}

.packages-readme .md-h {
    white-space: normal;
    color: var(--vx-text);
    font-weight: 600;
    margin-top: 6px;
}

.packages-readme .md-h1 {
    font-size: 15px;
}

.packages-readme .md-h2 {
    font-size: 13px;
}

.packages-readme .md-list {
    gap: 3px;
}

.packages-readme .md-item {
    flex-direction: row;
    align-items: flex-start;
    gap: 8px;
}

.packages-readme .md-bullet, .packages-readme .md-number {
    width: 14px;
    flex-shrink: 0;
    color: var(--vx-muted);
    text-align: right;
}

.packages-readme .md-item-body {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
}

.packages-readme .md-quote {
    padding: 6px 10px;
    border-radius: 6px;
    background-color: var(--vx-field);
}

.packages-readme .md-code {
    border-radius: 6px;
    border: 1px solid var(--vx-line);
    overflow: hidden;
}

.packages-readme .md-code-bar {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0px 4px 0px 10px;
}

.packages-readme .md-code-language {
    flex-grow: 1;
    font-size: 11px;
    color: var(--vx-muted);
}

.packages-readme .md-code-text {
    padding: 6px 10px;
    font-family: mono;
    font-size: 11px;
    line-height: 17px;
}

.packages-readme .md-rule {
    height: 1px;
    background-color: var(--vx-line);
}

.packages-readme .md-image {
    flex-direction: row;
    gap: 6px;
    color: var(--vx-muted);
}

.packages-heading {
    margin-top: 8px;
    flex-shrink: 0;
}

.packages-doc {
    flex-shrink: 0;
    padding-left: 8px;
    color: var(--vx-text-2);
}

.packages-sample {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 8px;
    height: 28px;
    padding-left: 8px;
}

.packages-sample-name {
    flex-grow: 1;
    min-width: 0px;
    color: var(--vx-text-2);
}

/* Add from Git URL and Add from Registry, under the toolbar's + button. */
.packages-popup {
    position: absolute;
    left: 8px;
    top: 36px;
    z-index: 30;
    flex-direction: column;
    gap: 8px;
    width: 380px;
    padding: 10px;
    border-radius: 8px;
    background-color: var(--vx-panel);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 12px 32px rgba(0, 0, 0, 0.45);
}

.packages-input {
    height: 24px;
    padding: 0px 7px;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.packages-popup-row {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.packages-popup-row > .packages-input {
    flex-grow: 1;
    min-width: 0px;
}

.packages-rev {
    width: 130px;
    flex-shrink: 0;
}

.packages-buttons {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    gap: 6px;
}

.packages-registry {
    width: 440px;
}

.packages-registry-search {
    margin: 0px;
}

.packages-registry-list {
    height: 240px;
    border-radius: 6px;
    background-color: var(--vx-bg);
}

/* The dialog before code arrives: what comes, goes and moves, and Add. */
.packages-cover {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    z-index: 40;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.packages-dialog {
    flex-direction: column;
    gap: 8px;
    width: 460px;
    max-height: 90%;
    padding: 14px;
    border-radius: 10px;
    background-color: var(--vx-panel);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 16px 40px rgba(0, 0, 0, 0.5);
}

.packages-dialog-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--vx-text);
}

.packages-dialog-hint {
    color: var(--vx-muted);
}

.packages-dialog-lines {
    flex-direction: column;
    flex-shrink: 1;
    min-height: 0px;
    gap: 2px;
    padding: 8px 10px;
    border-radius: 6px;
    background-color: var(--vx-bg);
    overflow: scroll;
}

.packages-dialog-line {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    height: 22px;
    flex-shrink: 0;
}

.packages-dialog-mark {
    width: 12px;
    font-family: mono;
    font-weight: 600;
}

.packages-added {
    color: var(--vx-success);
}

.packages-removed {
    color: var(--vx-x);
}

.packages-moved {
    color: var(--vx-accent);
}

.packages-dialog-name {
    flex-grow: 1;
    min-width: 0px;
    font-weight: 500;
    color: var(--vx-text);
}

.packages-dialog-detail {
    flex-shrink: 0;
    padding-left: 20px;
    white-space: normal;
    font-size: 11px;
    color: var(--vx-text-2);
}

.packages-runs-code {
    color: var(--vx-warning);
}
