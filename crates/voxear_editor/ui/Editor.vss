/* The editor's look, after the editor concept: near-black panels with 6px
   gaps on a darker window, thin borders, one periwinkle accent, Inter for
   text and JetBrains Mono for numbers, and compact rows. Tokens and
   controls come from the default theme; this sheet lays the editor out and
   dresses its panels. */

:root {
    --ed-logo-top: #aab3ff;
    --ed-logo-left: #7988ff;
    --ed-logo-right: #4c56b8;
    --ed-warn: #e2b340;
}

.editor {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
}

.spacer {
    flex-grow: 1;
}

.fill {
    flex-grow: 1;
    flex-basis: 0px;
}

.mono {
    font-family: mono;
    font-size: 11px;
}

/* The top bar: brand, workspaces and the command bar on the left, play
   controls in the middle, the account and Build on the right. */

.topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 40px;
    padding: 0px 8px;
    column-gap: 8px;
}

.topbar-left {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    min-width: 0px;
    overflow: hidden;
}

.logo {
    width: 18px;
    height: 18px;
    margin-left: 4px;
    flex-shrink: 0;
}

.logo > Icon {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 18px;
    height: 18px;
}

.logo-top {
    color: var(--ed-logo-top);
}

.logo-left {
    color: var(--ed-logo-left);
}

.logo-right {
    color: var(--ed-logo-right);
}

.brand {
    font-size: 13px;
    font-weight: 600;
    color: var(--vx-text);
    margin-right: 6px;
}

.workspaces {
    padding: 0px;
    background-color: transparent;
}

.workspaces .segment {
    height: 24px;
    padding: 0px 8px;
    border-radius: 5px;
    font-weight: 500;
}

.workspaces .segment:checked {
    background-color: var(--vx-selected);
    box-shadow: none;
}

.command {
    flex-direction: row;
    align-items: center;
    width: 260px;
    height: 26px;
    padding: 0px 5px 0px 9px;
    gap: 7px;
    margin-left: 6px;
    flex-shrink: 1;
    border-radius: 6px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.command-icon, .search-icon {
    width: 13px;
    height: 13px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

.command-field, .search-field, .axis-input {
    flex-grow: 1;
    height: 20px;
    padding: 0px;
    border-width: 0px;
    background-color: transparent;
}

.kbd {
    height: 16px;
    padding: 0px 4px;
    flex-shrink: 0;
    border-radius: 4px;
    border: 1px solid var(--vx-line-2);
    font-family: mono;
    font-size: 10px;
    line-height: 14px;
    color: var(--vx-muted);
}

/* Play, pause and step in a pill; play is the accent. */
.play {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    gap: 4px;
    border-radius: 7px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.play > Button {
    width: 28px;
    height: 22px;
}

.play Icon {
    width: 11px;
    height: 11px;
}

.play-button {
    color: var(--vx-accent);
}

.play-button:hover {
    color: var(--vx-accent-hover);
}

.topbar-right {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
}

.avatar {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: var(--vx-accent-soft);
    color: var(--vx-text);
    font-size: 10px;
    font-weight: 600;
    text-align: center;
}

.build {
    height: 26px;
    padding: 0px 12px;
}

/* The body: the rail, then the dock. */

.body {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0px;
    padding: 0px 6px 0px 0px;
    gap: 2px;
}

.rail {
    width: 44px;
    padding: 2px 0px 4px 0px;
    gap: 4px;
    align-items: center;
    flex-shrink: 0;
}

.rail-button {
    width: 32px;
    height: 32px;
    border-radius: 7px;
}

.rail-button > Icon {
    width: 16px;
    height: 16px;
}

.dock {
    flex-grow: 1;
}

.dock-content {
    padding-top: 6px;
    gap: 4px;
}

/* A panel's own controls, at the right of its header. */
.panel-actions {
    position: absolute;
    top: -32px;
    right: 4px;
    height: 32px;
    flex-direction: row;
    align-items: center;
    gap: 2px;
}

.header-button {
    height: 22px;
    padding: 0px 7px;
    border-width: 0px;
    background-color: transparent;
    color: var(--vx-text-2);
    font-weight: 400;
}

.header-button:hover {
    background-color: var(--vx-hover);
}

.shading {
    height: 22px;
    padding: 0px 6px;
    gap: 4px;
    border-width: 0px;
    background-color: transparent;
}

.shading:hover {
    background-color: var(--vx-hover);
}

.search {
    flex-direction: row;
    align-items: center;
    height: 24px;
    margin: 0px 6px;
    padding: 0px 7px;
    gap: 6px;
    flex-shrink: 0;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.placeholder {
    color: var(--vx-muted);
    padding: 4px 10px;
}

/* Rows of the Hierarchy and the Project. */

.row-icon {
    width: 13px;
    height: 13px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

.list-row:selected .row-icon {
    color: var(--vx-accent);
}

.row-name {
    flex-grow: 1;
    flex-basis: 0px;
}

.row-count {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

/* The Scene panel: its area lets the 3D view show through, and its
   overlays float over it. The frame is drawn over the view's edge, in the
   window's layer, so the view's corners follow the panel's. */

.viewport-area {
    background-color: transparent;
}

.viewport-area > .tab-bar {
    background-color: var(--vx-panel);
}

.viewport {
    flex-grow: 1;
}

.viewport-frame {
    position: absolute;
    display: none;
    pointer-events: none;
    border-radius: 8px;
    border: 1px solid var(--vx-line);
    box-shadow: 0px 0px 0px 4px var(--vx-bg);
}

.overlay {
    position: absolute;
    border-radius: 7px;
    background-color: var(--vx-overlay);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.35);
}

.tools {
    left: 8px;
    top: 8px;
    flex-direction: row;
    align-items: center;
    padding: 2px;
    gap: 2px;
}

.tool-modes {
    height: 24px;
    padding: 0px;
    gap: 2px;
    background-color: transparent;
}

.tool-modes .segment {
    width: 24px;
    height: 24px;
    padding: 0px;
    border-radius: 5px;
}

.tool-modes .segment > Icon {
    width: 13px;
    height: 13px;
}

.tool-modes .segment:checked {
    background-color: var(--vx-accent-soft);
    box-shadow: none;
    color: var(--vx-accent);
}

.tool-divider {
    width: 1px;
    height: 14px;
    margin: 0px 3px;
    background-color: var(--vx-line-2);
}

.tool-toggle {
    height: 24px;
    padding: 0px 7px;
    gap: 5px;
    border-radius: 5px;
    border-width: 0px;
    background-color: transparent;
    color: var(--vx-text-2);
    font-weight: 400;
}

.tool-toggle > Icon {
    width: 13px;
    height: 13px;
    color: var(--vx-muted);
}

.tool-toggle:hover {
    background-color: var(--vx-hover);
}

.chip {
    left: 8px;
    bottom: 8px;
    height: 24px;
    padding: 0px 9px;
    border-radius: 7px;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

.gizmo-box {
    right: 8px;
    bottom: 8px;
    flex-direction: row;
    align-items: center;
    padding: 3px 10px 3px 4px;
    gap: 6px;
}

.gizmo {
    width: 30px;
    height: 30px;
}

.projection {
    color: var(--vx-text-2);
}

/* The Inspector. */

.inspector {
    padding: 8px 10px 12px 10px;
}

.inspector-header {
    gap: 2px;
    padding-bottom: 8px;
}

.header-row {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
}

.obj-tile {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    background-color: var(--vx-accent-soft);
    color: var(--vx-accent);
}

.obj-tile > Icon {
    width: 13px;
    height: 13px;
}

.obj-name {
    flex-grow: 1;
    flex-basis: 0px;
    font-weight: 600;
}

.prop-label {
    color: var(--vx-muted);
}

.divider {
    height: 1px;
    flex-shrink: 0;
    background-color: var(--vx-line);
}

.section > .foldout-header {
    height: 30px;
}

.section > .foldout-content {
    padding-left: 0px;
    padding-bottom: 8px;
    gap: 0px;
}

.section .foldout-icon {
    width: 13px;
    height: 13px;
}

.prop {
    display: grid;
    grid-template-columns: 80px minmax(0px, 1fr);
    column-gap: 6px;
    align-items: center;
    min-height: 26px;
}

.prop > Dropdown, .prop > TextField {
    min-width: 0px;
}

.vector {
    display: grid;
    grid-template-columns: repeat(3, minmax(0px, 1fr));
    column-gap: 4px;
}

.axis-field {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding-left: 6px;
    gap: 4px;
    min-width: 0px;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.axis-input {
    font-family: mono;
    font-size: 11px;
    min-width: 0px;
}

.axis-letter {
    font-size: 10px;
    font-weight: 600;
    flex-shrink: 0;
}

.axis-x {
    color: var(--vx-x);
}

.axis-y {
    color: var(--vx-y);
}

.axis-z {
    color: var(--vx-z);
}

.value {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

.add-component {
    margin-top: 10px;
    height: 28px;
    border: 1px dashed var(--vx-line-2);
    background-color: transparent;
    color: var(--vx-muted);
    font-weight: 500;
}

.add-component:hover {
    border-color: var(--vx-accent);
    background-color: var(--vx-accent-soft);
    color: var(--vx-text);
}

/* The Project: folders on the left, what is in the open one on the right,
   as tiles when there is room and as rows when there is not. */

DockSpace .project-split > .split-divider {
    width: 1px;
    background-color: var(--vx-line);
}

.folders {
    padding-top: 2px;
}

.files-pane {
    flex-grow: 1;
    min-width: 0px;
}

.breadcrumb {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0px 10px;
    gap: 6px;
    flex-shrink: 0;
}

.crumbs {
    flex-grow: 1;
    flex-basis: 0px;
    color: var(--vx-muted);
}

.count {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
}

.file-size {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

.tile-row {
    padding: 0px 2px;
    gap: 2px;
    align-items: stretch;
}

.tile-row:hover, .tile-row:selected {
    background-color: transparent;
}

.tile {
    width: 70px;
    padding: 6px 3px 4px 3px;
    gap: 4px;
    align-items: center;
    overflow: hidden;
    border-radius: 6px;
    transition: background-color var(--vx-fade);
}

.tile:hover {
    background-color: var(--vx-hover);
}

.tile:checked {
    background-color: var(--vx-selected);
}

.tile-icon {
    width: 26px;
    height: 26px;
    color: var(--vx-muted);
}

.tile:checked .tile-icon {
    color: var(--vx-accent);
}

.tile-name {
    font-size: 11px;
    text-align: center;
    color: var(--vx-text-2);
}

/* The Console. */

.console .list-row {
    padding: 0px 8px;
}

.log-line {
    flex-grow: 1;
    flex-basis: 0px;
    font-family: mono;
    font-size: 11px;
}

.log-warn {
    color: var(--ed-warn);
}

.log-error {
    color: var(--vx-x);
}

/* The status bar: a light and what the editor is doing on the left, the
   numbers on the right. */

.statusbar {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0px 12px;
    gap: 12px;
    font-size: 11px;
    color: var(--vx-muted);
}

.status-dot {
    width: 6px;
    height: 6px;
    margin-right: -6px;
    border-radius: 3px;
    background-color: var(--vx-success);
}

.status-text {
    color: var(--vx-text-2);
}

.status-branch {
    flex-direction: row;
    align-items: center;
    gap: 4px;
}

.status-branch > Icon {
    width: 12px;
    height: 12px;
}
