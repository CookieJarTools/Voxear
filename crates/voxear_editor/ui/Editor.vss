/* The editor's look, after the editor concept: near-black panels with 6px
   gaps on a darker window, thin borders, one periwinkle accent, Inter for
   text and JetBrains Mono for numbers, and compact rows. Tokens and
   controls come from the default theme; this sheet lays the editor out and
   dresses its panels. */

:root {
    --ed-logo-top: #aab3ff;
    --ed-logo-left: #7988ff;
    --ed-logo-right: #4c56b8;
    --ed-warn: #e2b340;
}

.editor {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
}

.spacer {
    flex-grow: 1;
}

.fill {
    flex-grow: 1;
    flex-basis: 0px;
}

.mono {
    font-family: mono;
    font-size: 11px;
}

/* The top bar: brand, workspaces and the command bar on the left, play
   controls in the middle, the account and Build on the right. */

.topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 40px;
    padding: 0px 8px;
    column-gap: 8px;
}

.topbar-left {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    min-width: 0px;
    overflow: hidden;
}

.logo {
    width: 18px;
    height: 18px;
    margin-left: 4px;
    flex-shrink: 0;
}

.logo > Icon {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 18px;
    height: 18px;
}

.logo-top {
    color: var(--ed-logo-top);
}

.logo-left {
    color: var(--ed-logo-left);
}

.logo-right {
    color: var(--ed-logo-right);
}

.brand {
    font-size: 13px;
    font-weight: 600;
    color: var(--vx-text);
    margin-right: 6px;
}

.workspaces {
    padding: 0px;
    background-color: transparent;
}

.workspaces .segment {
    height: 24px;
    padding: 0px 8px;
    border-radius: 5px;
    font-weight: 500;
}

.workspaces .segment:checked {
    background-color: var(--vx-selected);
    box-shadow: none;
}

.command {
    flex-direction: row;
    align-items: center;
    width: 260px;
    height: 26px;
    padding: 0px 5px 0px 9px;
    gap: 7px;
    margin-left: 6px;
    flex-shrink: 1;
    border-radius: 6px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.command-icon, .search-icon {
    width: 13px;
    height: 13px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

.command-field, .search-field, .axis-input {
    flex-grow: 1;
    height: 20px;
    padding: 0px;
    border-width: 0px;
    background-color: transparent;
}

/* The Settings panel: groups of settings, laid out as the Inspector's rows. */
.settings-body {
    padding: 4px 12px 12px 12px;
}

.settings-group {
    margin-top: 12px;
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: 600;
    color: var(--vx-muted);
}

.setting .prop-label {
    color: var(--vx-text-2);
}

.setting.found .prop-label {
    color: var(--vx-accent);
}

/* Names in full, as settings have room the Inspector's fields do not. */
.prop.setting {
    grid-template-columns: minmax(0px, 1fr) 132px;
}

.setting-unit {
    flex-shrink: 0;
    font-size: 11px;
    color: var(--vx-muted);
}

/* The command palette, under the command bar. */
.palette {
    position: absolute;
    width: 460px;
    padding: 4px;
    z-index: 20;
    border-radius: 8px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 12px 32px rgba(0, 0, 0, 0.45);
}

.palette-list .list-row {
    align-items: center;
    gap: 8px;
    padding: 0px 8px;
    border-radius: 5px;
}

.palette-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--vx-muted);
}

.palette-title {
    flex-grow: 1;
    min-width: 0px;
    color: var(--vx-text);
}

.palette-detail {
    flex-shrink: 0;
    font-size: 11px;
    color: var(--vx-muted);
}

.palette-empty {
    padding: 8px;
    color: var(--vx-muted);
}

.kbd {
    height: 16px;
    padding: 0px 4px;
    flex-shrink: 0;
    border-radius: 4px;
    border: 1px solid var(--vx-line-2);
    font-family: mono;
    font-size: 10px;
    line-height: 14px;
    color: var(--vx-muted);
}

/* Play, pause and step in a pill; play is the accent. */
.play {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    gap: 4px;
    border-radius: 7px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.play > Button {
    width: 28px;
    height: 22px;
}

.play Icon {
    width: 11px;
    height: 11px;
}

.play-button {
    color: var(--vx-accent);
}

.play-button:hover {
    color: var(--vx-accent-hover);
}

.topbar-right {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
}

.build {
    height: 26px;
    padding: 0px 12px;
}

/* The body: the rail, then the dock. */

.body {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0px;
    padding: 0px 6px 0px 0px;
    gap: 2px;
}

.rail {
    width: 44px;
    padding: 2px 0px 4px 0px;
    gap: 4px;
    align-items: center;
    flex-shrink: 0;
}

.rail-button {
    width: 32px;
    height: 32px;
    border-radius: 7px;
}

.rail-button > Icon {
    width: 16px;
    height: 16px;
}

.rail-button:checked {
    color: var(--vx-text);
    background-color: var(--vx-selected);
}

/* The Project panel's rename bar, over its files while a name is typed. */
.project-rename {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 30px;
    padding: 0px 8px;
    gap: 8px;
    background-color: var(--vx-field);
    border-radius: 5px;
    margin: 0px 6px 4px 6px;
}

.project-rename-label {
    font-size: 11px;
    color: var(--vx-muted);
}

.project-rename-field {
    flex-grow: 1;
}

/* The rail's drawer: Levels or Settings, over the left of the dock, a third of the window wide: under the 40px
   top bar, over the 22px status bar, and right of the 44px rail. */
.drawer {
    position: absolute;
    left: 46px;
    top: 40px;
    bottom: 23px;
    width: 33%;
    min-width: 340px;
    flex-direction: column;
    border-radius: 8px;
    background-color: var(--vx-panel);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 12px 32px rgba(0, 0, 0, 0.45);
}

.drawer-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 34px;
    padding: 0px 6px 0px 12px;
}

.drawer-title {
    flex-grow: 1;
    font-weight: 600;
}

.drawer-page {
    flex-direction: column;
}

/* Settings: a tab for each group down the left, its settings beside them. */
.settings-root {
    flex-direction: row;
}

.settings-tabs {
    flex-direction: column;
    flex-shrink: 0;
    width: 128px;
    padding: 4px 6px;
    gap: 2px;
}

.settings-tab {
    height: 26px;
    padding: 0px 10px;
    border-radius: 5px;
    border-color: transparent;
    justify-content: flex-start;
    text-align: left;
    color: var(--vx-muted);
    background-color: transparent;
}

.settings-tab:focus {
    border-color: transparent;
}

.settings-tab:hover {
    color: var(--vx-text);
    background-color: var(--vx-hover);
}

.settings-tab:checked {
    color: var(--vx-text);
    background-color: var(--vx-selected);
}

.settings-main {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
}

.dock {
    flex-grow: 1;
}

.dock-content {
    padding-top: 6px;
    gap: 4px;
}

/* A panel's own controls, at the right of its header. */
.panel-actions {
    position: absolute;
    top: -32px;
    right: 4px;
    height: 32px;
    flex-direction: row;
    align-items: center;
    gap: 2px;
}

.header-button {
    height: 22px;
    padding: 0px 7px;
    border-width: 0px;
    background-color: transparent;
    color: var(--vx-text-2);
    font-weight: 400;
}

.header-button:hover {
    background-color: var(--vx-hover);
}

.shading {
    height: 22px;
    padding: 0px 6px;
    gap: 4px;
    border-width: 0px;
    background-color: transparent;
}

.shading:hover {
    background-color: var(--vx-hover);
}

.search {
    flex-direction: row;
    align-items: center;
    height: 24px;
    margin: 0px 6px;
    padding: 0px 7px;
    gap: 6px;
    flex-shrink: 0;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.placeholder {
    color: var(--vx-muted);
    padding: 4px 10px;
}

/* Rows of the Hierarchy and the Project. */

.row-icon {
    width: 13px;
    height: 13px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

.list-row:selected .row-icon {
    color: var(--vx-accent);
}

.row-name {
    flex-grow: 1;
    flex-basis: 0px;
}

.row-count {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

/* A scene's header in the Hierarchy, as Unity heads each open scene. */
.scene-header .row-name {
    font-weight: 600;
    color: var(--vx-text);
}

.scene-header .row-icon {
    color: var(--vx-text-2);
}

/* An Obj with an IInstance behaviour: a small pill after its name. */
.row-badge {
    flex-shrink: 0;
    padding: 0px 5px;
    margin-right: 4px;
    border-radius: 4px;
    font-size: 10px;
    color: var(--vx-accent);
    background-color: var(--vx-selected);
}

/* Prefab instances are tinted, as Unity tints them: the root, and lighter what is inside. */
.row-name.prefab-root {
    color: #7cb1ff;
}

.row-name.prefab-member {
    color: #a3c6f5;
}

/* The Scene panel: its area lets the 3D view show through, and its
   overlays float over it. The frame is drawn over the view's edge, in the
   window's layer, so the view's corners follow the panel's. */

.viewport-area {
    background-color: transparent;
}

.viewport-area > .tab-bar {
    background-color: var(--vx-panel);
}

.viewport {
    flex-grow: 1;
}

/* Prefab mode: what is open, and the way back to the level. */
.prefab-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    height: 30px;
    padding: 0px 8px 0px 4px;
    background-color: var(--vx-panel);
    border-bottom: 1px solid var(--vx-line);
}

.prefab-back {
    flex-direction: row;
    align-items: center;
    gap: 2px;
}

.prefab-icon {
    width: 14px;
    height: 14px;
    color: var(--vx-accent);
}

.prefab-name {
    font-weight: 600;
}

.prefab-hint {
    flex-grow: 1;
    color: var(--vx-muted);
    text-align: right;
}

.viewport-frame {
    position: absolute;
    display: none;
    pointer-events: none;
    border-radius: 8px;
    border: 1px solid var(--vx-line);
    box-shadow: 0px 0px 0px 4px var(--vx-bg);
}

/* The move, rotate and scale handles, drawn as shapes over the 3D view. */
.handles {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    pointer-events: none;
}

.overlay {
    position: absolute;
    border-radius: 7px;
    background-color: var(--vx-overlay);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.35);
}

.tools {
    left: 8px;
    top: 8px;
    flex-direction: row;
    align-items: center;
    padding: 2px;
    gap: 2px;
}

.tool-modes {
    height: 24px;
    padding: 0px;
    gap: 2px;
    background-color: transparent;
}

.tool-modes .segment {
    width: 24px;
    height: 24px;
    padding: 0px;
    border-radius: 5px;
}

.tool-modes .segment > Icon {
    width: 13px;
    height: 13px;
}

.tool-modes .segment:checked {
    background-color: var(--vx-accent-soft);
    box-shadow: none;
    color: var(--vx-accent);
}

.tool-divider {
    width: 1px;
    height: 14px;
    margin: 0px 3px;
    background-color: var(--vx-line-2);
}

.tool-toggle {
    height: 24px;
    padding: 0px 7px;
    gap: 5px;
    border-radius: 5px;
    border-width: 0px;
    background-color: transparent;
    color: var(--vx-text-2);
    font-weight: 400;
}

.tool-toggle > Icon {
    width: 13px;
    height: 13px;
    color: var(--vx-muted);
}

.tool-toggle:hover {
    background-color: var(--vx-hover);
}

.chip {
    left: 8px;
    bottom: 8px;
    height: 24px;
    padding: 0px 9px;
    border-radius: 7px;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

.gizmo-box {
    right: 8px;
    bottom: 8px;
    flex-direction: row;
    align-items: center;
    padding: 3px 10px 3px 4px;
    gap: 6px;
}

.gizmo {
    width: 30px;
    height: 30px;
}

.projection {
    color: var(--vx-text-2);
}

/* The Inspector. */

.inspector {
    padding: 8px 10px 12px 10px;
}

.inspector-header {
    gap: 2px;
    padding-bottom: 8px;
}

.header-row {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
}

.obj-tile {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    background-color: var(--vx-accent-soft);
    color: var(--vx-accent);
}

.obj-tile > Icon {
    width: 13px;
    height: 13px;
}

.obj-name {
    flex-grow: 1;
    flex-basis: 0px;
    font-weight: 600;
}

.prop-label {
    color: var(--vx-muted);
}

/* A value kept after play: its label in the accent, as a reminder. */
.kept > .prop-label, .kept > .obj-tile {
    color: var(--vx-accent);
}

.divider {
    height: 1px;
    flex-shrink: 0;
    background-color: var(--vx-line);
}

.section > .foldout-header {
    height: 30px;
}

.section > .foldout-content {
    padding-left: 0px;
    padding-bottom: 8px;
    gap: 0px;
}

.section .foldout-icon {
    width: 13px;
    height: 13px;
}

/* A component a prefab locks for designers: a padlock in its header, and,
   in the prefab, its values designers do not see dimmed. */
.lock-mark {
    width: 13px;
    height: 13px;
    color: var(--vx-muted);
}

.hidden-from-designers {
    opacity: 0.45;
}

.prop {
    display: grid;
    grid-template-columns: 80px minmax(0px, 1fr);
    column-gap: 6px;
    align-items: center;
    min-height: 26px;
}

.prop > Dropdown, .prop > TextField {
    min-width: 0px;
}

.vector {
    display: grid;
    grid-template-columns: repeat(3, minmax(0px, 1fr));
    column-gap: 4px;
}

.axis-field {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding-left: 6px;
    gap: 4px;
    min-width: 0px;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.axis-input {
    font-family: mono;
    font-size: 11px;
    min-width: 0px;
}

.axis-letter {
    font-size: 10px;
    font-weight: 600;
    flex-shrink: 0;
}

.axis-x {
    color: var(--vx-x);
}

.axis-y {
    color: var(--vx-y);
}

.axis-z {
    color: var(--vx-z);
}

/* A colour: its swatch, then red, green and blue. */
.vector.color {
    grid-template-columns: 22px repeat(3, minmax(0px, 1fr));
}

.swatch {
    height: 22px;
    border-radius: 5px;
    border: 1px solid var(--vx-field-line);
}

/* A click on a swatch opens the colour picker. */
.swatch:hover {
    border-color: var(--vx-muted);
}

/* The colour picker's popup: the palette's look, sized to the picker. */
.color-popup {
    flex-direction: column;
    gap: 6px;
    width: 250px;
    padding: 8px;
}

.axis-r {
    color: var(--vx-x);
}

.axis-g {
    color: var(--vx-y);
}

.axis-b {
    color: var(--vx-z);
}

.value-input {
    height: 22px;
    font-size: 11px;
}

.number-input {
    font-family: mono;
}

.vector.vector-2 {
    grid-template-columns: repeat(2, minmax(0px, 1fr));
}

.vector.vector-4 {
    grid-template-columns: repeat(4, minmax(0px, 1fr));
}

/* A value with a button beside it: a list's add, or an item's remove. */
.prop-value {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    min-width: 0px;
}

.prop-value > .value-input, .prop-value > .value-picker, .prop-value > .vector, .prop-value > .value {
    flex-grow: 1;
    min-width: 0px;
}

.list-add, .list-remove {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

/* A reference: what it points at, opening a menu to pick another. */
.value-picker {
    height: 22px;
    padding: 0px 6px 0px 8px;
    gap: 6px;
    align-items: center;
    min-width: 0px;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
    transition: border-color var(--vx-fade);
}

.value-picker:hover {
    border-color: var(--vx-line-2);
}

/* Something dragged over a reference, ready to drop. */
.value-picker.drop-hover {
    border-color: var(--vx-accent);
    background-color: var(--vx-selected);
}

.picker-label {
    flex-grow: 1;
    min-width: 0px;
    font-size: 11px;
}

/* An asset field's preview, before its name. */
.field-thumb {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-left: -4px;
    border-radius: 3px;
}

/* The Inspector's large preview of an asset, which a drag turns. */
.asset-preview {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    height: 208px;
    margin: 4px 0px 8px 0px;
    border-radius: 8px;
    background-color: var(--vx-bg);
}

.asset-preview-image {
    width: 200px;
    height: 200px;
    border-radius: 8px;
}

.asset-preview-hint {
    position: absolute;
    right: 8px;
    bottom: 6px;
    font-size: 10px;
    color: var(--vx-muted);
}

.value {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

.add-component {
    margin-top: 10px;
    height: 28px;
    border: 1px dashed var(--vx-line-2);
    background-color: transparent;
    color: var(--vx-muted);
    font-weight: 500;
}

.add-component:hover {
    border-color: var(--vx-accent);
    background-color: var(--vx-accent-soft);
    color: var(--vx-text);
}

/* The Project: folders on the left, what is in the open one on the right,
   as tiles when there is room and as rows when there is not. */

DockSpace .project-split > .split-divider {
    width: 1px;
    background-color: var(--vx-line);
}

.folders {
    padding-top: 2px;
}

.files-pane {
    flex-grow: 1;
    min-width: 0px;
}

.breadcrumb {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0px 10px;
    gap: 6px;
    flex-shrink: 0;
}

.crumbs {
    flex-grow: 1;
    flex-basis: 0px;
    color: var(--vx-muted);
}

.count {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
}

.file-size {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

.tile-row {
    padding: 0px 2px;
    gap: 2px;
    align-items: stretch;
}

.tile-row:hover, .tile-row:selected {
    background-color: transparent;
}

.tile {
    width: 70px;
    padding: 6px 3px 4px 3px;
    gap: 4px;
    align-items: center;
    overflow: hidden;
    border-radius: 6px;
    transition: background-color var(--vx-fade);
}

.tile:hover {
    background-color: var(--vx-hover);
}

.tile:checked {
    background-color: var(--vx-selected);
}

.tile-icon {
    width: 26px;
    height: 26px;
    color: var(--vx-muted);
}

.tile:checked .tile-icon {
    color: var(--vx-accent);
}

/* A tile's or row's icon, or the preview in its place. */
.tile-thumb, .row-thumb, .picker-thumb {
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.tile-thumb {
    width: 44px;
    height: 44px;
}

.row-thumb {
    width: 16px;
    height: 16px;
}

.picker-thumb {
    width: 22px;
    height: 22px;
}

.thumb-image {
    width: 100%;
    height: 100%;
    border-radius: 4px;
}

.tile-thumb > .thumb-image {
    border-radius: 6px;
}

.tile-name {
    font-size: 11px;
    text-align: center;
    color: var(--vx-text-2);
}

/* The Levels panel. */

.level-heading {
    font-size: 11px;
    font-weight: 600;
    color: var(--vx-muted);
}

.level-heading:hover, .level-heading:selected {
    background-color: transparent;
}

.level-current .row-name {
    color: var(--vx-text);
    font-weight: 600;
}

.level-current .row-icon {
    color: var(--vx-accent);
}

.level-play {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

.level-play > Icon {
    width: 10px;
    height: 10px;
}

.level-progress {
    margin: 0px 8px 8px 8px;
    gap: 5px;
    flex-shrink: 0;
}

.level-progress-text {
    font-size: 11px;
    color: var(--vx-text-2);
}

.level-progress-track {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-seg-on);
}

.level-progress-fill {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-accent);
    transition: background-color var(--vx-fade);
}

/* The Console. */

/* The Console, after Sifter: a toolbar, one line per row in columns, and
   the selected line's stack under them. Monospaced throughout. */
.console-panel {
    flex-direction: column;
    font-family: mono;
    font-size: 11px;
}

/* It wraps, so a narrow Console keeps every control on screen. */
.console-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    min-height: 30px;
    padding: 4px 8px;
    column-gap: 6px;
    row-gap: 4px;
}

.console-button {
    height: 22px;
    padding: 0px 8px;
    flex-shrink: 0;
    border-radius: 5px;
    font-family: sans;
    color: var(--vx-muted);
    background-color: transparent;
}

.console-button:hover {
    color: var(--vx-text);
    background-color: var(--vx-field);
}

.console-button:checked {
    color: var(--vx-text);
    background-color: var(--vx-selected);
}

.console-search {
    flex-basis: 180px;
    flex-grow: 1;
    max-width: 320px;
    flex-shrink: 0;
}

.console-search.bad {
    border-color: var(--vx-x);
}

.console-level {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 22px;
    padding: 0px 6px;
    gap: 4px;
    border-radius: 5px;
    color: var(--vx-muted);
    opacity: 0.5;
}

.console-level:checked {
    opacity: 1;
    background-color: var(--vx-field);
}

.console-level-icon {
    width: 12px;
    height: 12px;
}

.level-warning .console-level-icon {
    color: var(--ed-warn);
}

.level-error .console-level-icon {
    color: var(--vx-x);
}

.console-problem {
    flex-shrink: 0;
    padding: 3px 10px;
    color: var(--vx-x);
}

.console .list-row {
    flex-direction: row;
    align-items: center;
    padding: 0px 8px;
    gap: 8px;
    color: var(--vx-text-2);
}

.console-icon {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
    color: var(--vx-muted);
}

.console-time {
    width: 62px;
    flex-shrink: 0;
    color: var(--vx-muted);
}

/* A line's category, in the colour the project gave it. */
.console-category {
    width: 76px;
    flex-shrink: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--vx-muted);
}

.console-filter-name {
    flex-basis: 180px;
    flex-shrink: 0;
}

.console-message {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    white-space: nowrap;
    overflow: hidden;
}

.console-count {
    flex-shrink: 0;
    padding: 0px 5px;
    border-radius: 7px;
    font-size: 10px;
    color: var(--vx-text);
    background-color: var(--vx-selected);
}

.console-source {
    flex-shrink: 0;
    color: var(--vx-muted);
}

/* Warnings and errors take their own colour, which the eye lands on. */
.list-row.log-warn, .list-row.log-warn .console-icon {
    color: var(--ed-warn);
}

.list-row.log-error, .list-row.log-error .console-icon {
    color: var(--vx-x);
}

.console-detail {
    flex-direction: column;
}

.console-detail-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 28px;
    padding: 0px 8px;
    gap: 6px;
}

.console-info {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    white-space: nowrap;
    overflow: hidden;
    color: var(--vx-muted);
}

.console-detail-body {
    padding: 4px 12px 10px 12px;
    gap: 6px;
}

.console-detail-message {
    color: var(--vx-text);
}

.console-detail-message.log-warn {
    color: var(--ed-warn);
}

.console-detail-message.log-error {
    color: var(--vx-x);
}

.console-trace {
    line-height: 17px;
    link-color: #c3a6ff;
}

/* The status bar: a light and what the editor is doing on the left, the
   numbers on the right. */

.statusbar {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0px 12px;
    gap: 12px;
    font-size: 11px;
    color: var(--vx-muted);
}

.status-dot {
    width: 6px;
    height: 6px;
    margin-right: -6px;
    border-radius: 3px;
    background-color: var(--vx-success);
}

.status-text {
    color: var(--vx-text-2);
}

/* Numbers that change, in figures of one width so they do not shift. */
.status-number {
    font-family: mono;
    font-size: 10px;
}

.status-branch {
    flex-direction: row;
    align-items: center;
    gap: 4px;
}

.status-branch > Icon {
    width: 12px;
    height: 12px;
}

/* The Profiler: recent frames as a chart, over one frame broken down. */
.profiler-panel {
    flex-direction: column;
    font-size: 11px;
}

.profiler-summary {
    flex-grow: 1;
    text-align: right;
    font-family: mono;
    color: var(--vx-text-2);
}

.profiler-chart {
    flex-shrink: 0;
    height: 120px;
    margin: 8px 10px 4px 10px;
    border-radius: 6px;
    background-color: var(--vx-bg);
}

.profiler-guide {
    position: absolute;
    left: 6px;
    font-family: mono;
    font-size: 10px;
    color: var(--vx-muted);
}

.profiler-legend {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    height: 24px;
    padding: 0px 10px;
    color: var(--vx-muted);
}

.profiler-swatch {
    width: 10px;
    height: 3px;
    border-radius: 2px;
}

.profiler-swatch.cpu {
    background-color: var(--vx-accent);
}

.profiler-swatch.gpu {
    background-color: var(--vx-success);
}

.profiler-picked {
    flex-grow: 1;
    text-align: right;
    font-family: mono;
}

/* Below the chart: the Hierarchy of samples, and the GPU's passes and the
   frame's counts beside it. */
.profiler-lower {
    flex-direction: row;
    align-items: stretch;
}

.profiler-hierarchy {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
}

/* Lined up with the tree's rows: their margin and padding, and their gap. */
.profiler-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    height: 24px;
    padding: 0px 14px 0px 32px;
    border-bottom: 1px solid var(--vx-line);
    color: var(--vx-muted);
}

.profiler-tree .list-row {
    padding-right: 10px;
}

.profiler-tree .tree-content {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0px;
}

.profiler-cell-name {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    color: var(--vx-text-2);
}

.profiler-cell {
    flex-shrink: 0;
    width: 62px;
    text-align: right;
    font-family: mono;
    color: var(--vx-text-2);
}

.profiler-header > .profiler-cell, .profiler-header > .profiler-cell-name {
    font-family: sans;
    color: var(--vx-muted);
}

.profiler-side {
    flex-direction: column;
    flex-shrink: 0;
    width: 280px;
    gap: 14px;
    padding: 8px 10px;
    border-left: 1px solid var(--vx-line);
    overflow: scroll;
}

.profiler-column {
    flex-direction: column;
    flex-shrink: 0;
    gap: 2px;
}

.profiler-heading {
    height: 20px;
    font-weight: 600;
    color: var(--vx-text);
}

.profiler-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 8px;
    height: 20px;
}

.profiler-name {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    color: var(--vx-text-2);
}

.profiler-track {
    flex-shrink: 0;
    width: 60px;
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-field);
}

.profiler-fill {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-accent);
}

.profiler-value {
    flex-shrink: 0;
    width: 64px;
    text-align: right;
    font-family: mono;
    color: var(--vx-text-2);
}

/* The object picker: the palette's look, under a reference field, with a
   title naming what the field takes and its own search box. */
.picker {
    flex-direction: column;
    gap: 4px;
}

.picker-title {
    padding: 4px 6px 0px 6px;
    font-weight: 600;
    color: var(--vx-text);
}

.picker-search {
    flex-shrink: 0;
}

/* The Build window: profiles on the left, the picked one's settings and its
   build beside them. */
.build-panel {
    flex-direction: column;
    font-size: 12px;
}

.build-main {
    flex-direction: row;
    align-items: stretch;
}

.build-profiles {
    flex-direction: column;
    flex-shrink: 0;
    width: 200px;
    padding: 6px 0px;
    background-color: var(--vx-bg);
}

.build-heading {
    height: 22px;
    padding: 0px 10px;
    font-weight: 600;
    color: var(--vx-muted);
}

.build-profile-name {
    flex-grow: 1;
    min-width: 0px;
}

.build-empty {
    flex-direction: column;
    gap: 8px;
    padding: 4px 10px;
}

.build-hint {
    white-space: normal;
    color: var(--vx-text-2);
}

.build-detail {
    flex-direction: column;
    min-width: 0px;
}

.build-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    height: 40px;
    padding: 0px 10px;
}

.build-title {
    flex-grow: 1;
    min-width: 0px;
    font-size: 14px;
    font-weight: 600;
    color: var(--vx-text);
}

.build-button {
    height: 24px;
    padding: 0px 10px;
    flex-shrink: 0;
    border-radius: 6px;
}

.build-settings {
    flex-direction: column;
    flex-shrink: 0;
    gap: 2px;
    padding: 0px 10px 8px 10px;
}

.build-setting {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    height: 20px;
}

.build-key {
    flex-shrink: 0;
    width: 110px;
    color: var(--vx-muted);
}

.build-value {
    flex-grow: 1;
    min-width: 0px;
    color: var(--vx-text-2);
}

.build-problem {
    white-space: normal;
    color: var(--vx-x);
}

/* Each stage as a chip: a dot that lights while it runs and stays lit once
   done, its name, and its time. */
.build-stages {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 6px;
    height: 36px;
    padding: 0px 10px;
}

.build-stage {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0px 8px;
    border-radius: 6px;
    color: var(--vx-muted);
    background-color: var(--vx-field);
}

.build-stage-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--vx-line-2);
}

.build-stage.running {
    color: var(--vx-text);
}

.build-stage.running .build-stage-dot {
    background-color: var(--vx-accent);
}

.build-stage.done .build-stage-dot {
    background-color: var(--vx-success);
}

.build-stage.failed .build-stage-dot {
    background-color: var(--vx-x);
}

.build-stage-time {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

.build-result {
    flex-grow: 1;
    min-width: 0px;
    text-align: right;
    color: var(--vx-text-2);
}

.build-progress {
    flex-direction: column;
    flex-shrink: 0;
    gap: 5px;
    padding: 0px 10px 8px 10px;
}

.build-progress-text {
    font-size: 11px;
    color: var(--vx-text-2);
}

.build-progress-track {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-seg-on);
}

.build-progress-fill {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-accent);
}

.build-log {
    margin: 0px 6px 6px 6px;
    border-radius: 6px;
    font-family: mono;
    font-size: 11px;
    background-color: var(--vx-bg);
}

.build-log-message {
    flex-grow: 1;
    min-width: 0px;
}
