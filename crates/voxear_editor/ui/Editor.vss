/* The editor's look, Graphite + Abyss: near-black panels with 10px gaps,
   thin borders, one indigo accent, Inter for text and JetBrains Mono for
   numbers. Tokens and controls come from the default theme; this sheet lays
   the editor out and dresses its panels. */

:root {
    --ed-logo-top: #9aa2ee;
    --ed-logo-left: #5e6ad2;
    --ed-logo-right: #3d4596;
    --ed-warn: #e2b340;
}

.editor {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
}

.spacer {
    flex-grow: 1;
}

.fill {
    flex-grow: 1;
    flex-basis: 0px;
}

.mono {
    font-family: mono;
    font-size: 11px;
}

/* The top bar: brand, workspaces and the command bar on the left, play
   controls in the middle, the account and Build on the right. */

.topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 52px;
    padding: 0px 10px;
    column-gap: 10px;
}

.topbar-left {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    min-width: 0px;
    overflow: hidden;
}

.logo {
    width: 20px;
    height: 20px;
    margin-left: 6px;
    flex-shrink: 0;
}

.logo > Icon {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 20px;
    height: 20px;
}

.logo-top {
    color: var(--ed-logo-top);
}

.logo-left {
    color: var(--ed-logo-left);
}

.logo-right {
    color: var(--ed-logo-right);
}

.brand {
    font-size: 13px;
    font-weight: 600;
    color: var(--vx-text);
    margin-right: 6px;
}

.workspaces {
    padding: 0px;
    border-width: 0px;
    background-color: transparent;
}

.workspaces .segment {
    height: 28px;
    padding: 0px 10px;
    border-radius: 7px;
    font-weight: 500;
}

.workspaces .segment:checked {
    background-color: var(--vx-selected);
    box-shadow: none;
}

.command {
    flex-direction: row;
    align-items: center;
    width: 300px;
    height: 30px;
    padding: 0px 6px 0px 10px;
    gap: 8px;
    margin-left: 4px;
    flex-shrink: 1;
    border-radius: 10px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.command-icon, .search-icon {
    color: var(--vx-muted);
    flex-shrink: 0;
}

.command-field, .search-field, .axis-input {
    flex-grow: 1;
    height: 22px;
    padding: 0px;
    border-width: 0px;
    background-color: transparent;
}

.kbd {
    height: 18px;
    padding: 0px 5px;
    flex-shrink: 0;
    border-radius: 5px;
    border: 1px solid var(--vx-line-2);
    font-family: mono;
    font-size: 10px;
    color: var(--vx-muted);
}

.play {
    flex-direction: row;
    align-items: center;
    padding: 3px;
    gap: 2px;
    border-radius: 10px;
    background-color: var(--vx-panel);
    border: 1px solid var(--vx-line);
}

.play-button {
    background-color: var(--vx-accent);
    color: var(--vx-on-accent);
}

.play-button:hover {
    background-color: #6c77da;
    color: var(--vx-on-accent);
}

.topbar-right {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
}

.avatar {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: var(--vx-seg-on);
    border: 1px solid var(--vx-line-2);
    color: var(--vx-text);
    font-size: 11px;
    font-weight: 600;
    text-align: center;
}

.build {
    height: 30px;
    padding: 0px 14px;
}

/* The body: the rail, then the dock. */

.body {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0px;
    padding: 0px 10px;
    gap: 10px;
}

.rail {
    width: 52px;
    padding: 6px 0px;
    gap: 4px;
    align-items: center;
    flex-shrink: 0;
    border-radius: 12px;
    background-color: var(--vx-panel);
    border: 1px solid var(--vx-line);
}

.rail-button {
    width: 40px;
    height: 40px;
    border-radius: 12px;
}

.rail-button > Icon {
    width: 18px;
    height: 18px;
}

.dock {
    flex-grow: 1;
}

.dock-content {
    padding-top: 8px;
    gap: 6px;
}

/* A panel's own buttons, at the right of its header. */
.panel-actions {
    position: absolute;
    top: -40px;
    right: 6px;
    height: 40px;
    flex-direction: row;
    align-items: center;
    gap: 2px;
}

.search {
    flex-direction: row;
    align-items: center;
    height: 28px;
    margin: 0px 10px;
    padding: 0px 8px;
    gap: 6px;
    flex-shrink: 0;
    border-radius: 7px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.placeholder {
    color: var(--vx-muted);
    padding: 4px 12px;
}

/* Rows of the Hierarchy and the Project. */

.row-icon {
    color: var(--vx-muted);
    flex-shrink: 0;
}

.list-row:selected .row-icon {
    color: var(--vx-accent);
}

.row-name {
    flex-grow: 1;
    flex-basis: 0px;
}

.row-count {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

/* The Scene panel: its area lets the 3D view show through, and its
   overlays float over it. The frame is drawn over the view's edge, in the
   window's layer, so the view's corners follow the panel's. */

.viewport-area {
    background-color: transparent;
}

.viewport-area > .tab-bar {
    background-color: var(--vx-panel);
}

.viewport {
    flex-grow: 1;
}

.viewport-frame {
    position: absolute;
    display: none;
    pointer-events: none;
    border-radius: 12px;
    border: 1px solid var(--vx-line);
    box-shadow: 0px 0px 0px 5px var(--vx-bg);
}

.overlay {
    position: absolute;
    border-radius: 12px;
    background-color: var(--vx-overlay);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 16px 40px rgba(0, 0, 0, 0.4);
}

.tools {
    left: 10px;
    top: 10px;
    flex-direction: row;
    align-items: center;
    padding: 4px;
    gap: 4px;
}

.tool-modes {
    height: 28px;
    padding: 0px;
    gap: 2px;
    border-width: 0px;
    background-color: transparent;
}

.tool-modes .segment {
    width: 28px;
    height: 28px;
    padding: 0px;
    border-radius: 8px;
}

.tool-modes .segment:checked {
    background-color: var(--vx-accent-soft);
    box-shadow: none;
    color: var(--vx-accent);
}

.tool-divider {
    width: 1px;
    height: 18px;
    margin: 0px 2px;
    background-color: var(--vx-line-2);
}

.tool-toggle {
    height: 28px;
    padding: 0px 8px;
    border-radius: 8px;
    border-width: 0px;
    background-color: transparent;
    color: var(--vx-text-2);
    font-weight: 400;
}

.tool-toggle > Icon {
    color: var(--vx-muted);
}

.tool-toggle:hover {
    background-color: var(--vx-hover);
}

.chip {
    left: 10px;
    bottom: 10px;
    height: 28px;
    padding: 0px 10px;
    border-radius: 10px;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

.gizmo-box {
    right: 10px;
    bottom: 10px;
    padding: 6px 6px 4px 6px;
    align-items: center;
}

.gizmo {
    width: 64px;
    height: 64px;
}

.gizmo-letter {
    position: absolute;
    width: 14px;
    height: 14px;
    font-size: 10px;
    font-weight: 600;
    line-height: 14px;
    text-align: center;
    color: #08090a;
}

.projection {
    font-size: 11px;
    color: var(--vx-muted);
}

/* The Inspector. */

.inspector {
    padding: 12px 12px 16px 12px;
}

.inspector-header {
    gap: 10px;
    padding-bottom: 12px;
}

.header-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.obj-tile {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background-color: var(--vx-accent-soft);
    color: var(--vx-accent);
}

.obj-name {
    flex-grow: 1;
    flex-basis: 0px;
    font-weight: 600;
}

.meta-row {
    display: grid;
    grid-template-columns: auto minmax(0px, 1fr) auto minmax(0px, 1fr);
    column-gap: 8px;
    align-items: center;
}

.meta-row > Dropdown {
    min-width: 0px;
    overflow: hidden;
}

.meta-label, .prop-label {
    color: var(--vx-muted);
}

.divider {
    height: 1px;
    flex-shrink: 0;
    background-color: var(--vx-line);
}

.section > .foldout-header {
    height: 36px;
}

.section > .foldout-content {
    padding-left: 0px;
    padding-bottom: 10px;
    gap: 0px;
}

.section-icon {
    color: var(--vx-muted);
}

.prop {
    display: grid;
    grid-template-columns: 88px minmax(0px, 1fr);
    column-gap: 8px;
    align-items: center;
    min-height: 28px;
}

.vector {
    display: grid;
    grid-template-columns: repeat(3, minmax(0px, 1fr));
    column-gap: 6px;
}

.axis-field {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding-left: 7px;
    gap: 5px;
    min-width: 0px;
    border-radius: 7px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
}

.axis-input {
    font-family: mono;
    font-size: 11px;
    min-width: 0px;
}

.axis-letter {
    font-size: 10px;
    font-weight: 600;
    flex-shrink: 0;
}

.axis-x {
    color: var(--vx-x);
}

.axis-y {
    color: var(--vx-y);
}

.axis-z {
    color: var(--vx-z);
}

.value {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
}

.add-component {
    margin-top: 14px;
    height: 32px;
    border: 1px dashed var(--vx-line-2);
    background-color: transparent;
    color: var(--vx-muted);
    font-weight: 500;
}

.add-component:hover {
    border-color: var(--vx-accent);
    background-color: var(--vx-accent-soft);
    color: var(--vx-text);
}

/* The Project: folders on the left, what is in the open one on the right,
   as tiles when there is room and as rows when there is not. */

DockSpace .project-split > .split-divider {
    width: 1px;
    background-color: var(--vx-line);
}

.folders {
    padding-top: 2px;
}

.files-pane {
    flex-grow: 1;
    min-width: 0px;
}

.breadcrumb {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding: 0px 12px;
    gap: 6px;
    flex-shrink: 0;
}

.crumbs {
    flex-grow: 1;
    flex-basis: 0px;
    color: var(--vx-muted);
}

.count {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
}

.file-size {
    font-family: mono;
    font-size: 11px;
    color: var(--vx-muted);
    flex-shrink: 0;
}

.tile-row {
    padding: 0px 2px;
    gap: 4px;
    align-items: stretch;
}

.tile-row:hover, .tile-row:selected {
    background-color: transparent;
}

.tile {
    width: 76px;
    padding: 8px 4px 6px 4px;
    gap: 6px;
    align-items: center;
    overflow: hidden;
    border-radius: 8px;
    transition: background-color var(--vx-fade);
}

.tile:hover {
    background-color: var(--vx-hover);
}

.tile:checked {
    background-color: var(--vx-selected);
}

.tile-icon {
    width: 30px;
    height: 30px;
    color: var(--vx-muted);
}

.tile:checked .tile-icon {
    color: var(--vx-accent);
}

.tile-name {
    font-size: 11px;
    text-align: center;
    color: var(--vx-text-2);
}

/* The Console. */

.console .list-row {
    padding: 0px 10px;
}

.log-line {
    flex-grow: 1;
    flex-basis: 0px;
    font-family: mono;
    font-size: 11px;
}

.log-warn {
    color: var(--ed-warn);
}

.log-error {
    color: var(--vx-x);
}

/* The status bar: a light, what the editor is doing, and the numbers. */

.statusbar {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0px 14px;
    gap: 8px;
    font-size: 11px;
    color: var(--vx-muted);
}

.status-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--vx-success);
}

.status-text {
    color: var(--vx-text-2);
}

.status-numbers {
    font-family: mono;
}
