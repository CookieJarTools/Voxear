<vui>
    <Style src="Editor.vss" />
    <Panel name="editor" class="editor">
        <Panel class="topbar">
            <Panel class="topbar-left">
                <Panel class="logo">
                    <Icon icon="logo-top" class="logo-top" />
                    <Icon icon="logo-left" class="logo-left" />
                    <Icon icon="logo-right" class="logo-right" />
                </Panel>
                <Label class="brand">Voxear</Label>
                <Button name="layouts" class="layouts-button"><Icon icon="panels" /><Label name="layout-name">Default</Label><Icon icon="chevron-down" class="layouts-arrow" /></Button>
                <Panel class="command">
                    <Icon icon="search" class="command-icon" />
                    <TextField name="command" class="command-field" placeholder="Search or run a command" />
                    <Label class="kbd">Ctrl K</Label>
                </Panel>
            </Panel>
            <Panel class="play">
                <Button name="play" class="icon-button play-button"><Icon icon="play" /></Button>
                <Button name="pause" class="icon-button"><Icon icon="pause" /></Button>
                <Button name="step" class="icon-button"><Icon icon="step" /></Button>
            </Panel>
            <Panel class="topbar-right">
                <Button name="windows" class="icon-button"><Icon icon="panels" /></Button>
                <Button name="build" class="primary build"><Label>Build</Label></Button>
            </Panel>
        </Panel>
        <Panel class="body">
            <Panel class="rail">
                <Button name="rail-levels" class="icon-button rail-button"><Icon icon="level" /></Button>
                <!-- The game's own buttons and items, from its scripts. -->
                <Panel name="rail-scripts" class="rail-scripts" />
                <Panel class="spacer" />
                <Button name="rail-settings" class="icon-button rail-button"><Icon icon="settings" /></Button>
            </Panel>
            <DockSpace name="dock" class="dock">
                <!-- Built from Hierarchy.vui, as each Hierarchy opened from a window's menu is. -->
                <DockPanel id="hierarchy" title="Hierarchy" class="dock-content" name="hierarchy-panel" />
                <!-- Built from Project.vui, as each Project opened from a window's menu is. -->
                <DockPanel id="project" title="Project" class="dock-content" name="project-panel" />
                <DockPanel id="console" title="Console" class="dock-content">
                    <Panel name="console-panel" class="fill console-panel" />
                </DockPanel>
                <DockPanel id="scene" title="Scene" icon="cube" name="scene-panel" />
                <DockPanel id="game" title="Game" icon="play">
                    <Panel name="game-viewport" class="viewport">
                        <Label name="game-empty" class="placeholder">No camera renders this level.</Label>
                    </Panel>
                </DockPanel>
                <DockPanel id="docs" title="VoxDocs" icon="book" name="docs" />
                <DockPanel id="profiler" title="Profiler" class="dock-content">
                    <Panel name="profiler-panel" class="fill profiler-panel" />
                </DockPanel>
                <DockPanel id="entities" title="Entities" class="dock-content">
                    <Panel name="entities-panel" class="fill entities-panel" />
                </DockPanel>
                <DockPanel id="frames" title="Frame Debugger" class="dock-content">
                    <Panel name="frame-debugger-panel" class="fill frame-debugger-panel" />
                </DockPanel>
                <DockPanel id="memory" title="Memory" class="dock-content">
                    <Panel name="memory-panel" class="fill frame-debugger-panel" />
                </DockPanel>
                <DockPanel id="localization" title="Localization Tables" icon="globe" class="dock-content">
                    <Panel name="localization-panel" class="fill frame-debugger-panel" />
                </DockPanel>
                <DockPanel id="audio" title="Audio" class="dock-content">
                    <Panel name="audio-panel" class="fill frame-debugger-panel" />
                </DockPanel>
                <DockPanel id="input" title="Input Actions" icon="gamepad" class="dock-content">
                    <Panel name="input-panel" class="fill input-panel" />
                </DockPanel>
                <DockPanel id="build" title="Build" class="dock-content">
                    <Panel name="build-panel" class="fill build-panel" />
                </DockPanel>
                <DockPanel id="inspector" title="Inspector">
                    <Panel class="panel-actions">
                        <Button name="inspector-lock" class="icon-button inspector-lock"><Icon icon="lock" /></Button>
                    </Panel>
                    <ScrollView name="inspector" class="fill inspector" />
                </DockPanel>
            </DockSpace>
        </Panel>
        <Panel class="statusbar">
            <Panel name="status-dot" class="status-dot" />
            <Label name="status-left" class="status-text">Ready</Label>
            <Label name="status-time" />
            <Panel class="spacer" />
            <Label name="status-renderer">Vulkan</Label>
            <Label name="status-fps" class="status-number" />
            <Label name="status-memory" class="status-number" />
            <Panel name="status-branch" class="status-branch">
                <Icon icon="branch" />
                <Label name="status-branch-name" />
            </Panel>
        </Panel>
        <!-- Debug draw's texts, at the points in the 3D view they name. Under the drawer and menus. -->
        <Panel name="debug-texts" class="debug-texts" />
        <!-- Opens from the rail over the dock's left side: Levels, or Settings. -->
        <Panel name="drawer" class="drawer">
            <Panel class="drawer-header">
                <Label name="drawer-title" class="drawer-title">Levels</Label>
                <Button name="drawer-close" class="icon-button"><Icon icon="close" /></Button>
            </Panel>
            <Panel name="drawer-levels" class="fill drawer-page">
                <Panel class="search">
                    <Icon icon="search" class="search-icon" />
                    <TextField name="levels-filter" class="search-field" placeholder="Find a level or scene" />
                </Panel>
                <ListView name="levels-list" class="fill levels" item-height="24" />
                <Panel name="levels-progress" class="level-progress">
                    <Label name="levels-progress-text" class="level-progress-text" />
                    <Panel class="level-progress-track">
                        <Panel name="levels-progress-fill" class="level-progress-fill" />
                    </Panel>
                </Panel>
            </Panel>
            <Panel name="drawer-settings" class="fill drawer-page">
                <Panel class="fill settings-root">
                    <Panel name="settings-tabs" class="settings-tabs" />
                    <Panel class="settings-main">
                        <Panel class="search">
                            <Icon icon="search" class="search-icon" />
                            <TextField name="settings-filter" class="search-field" placeholder="Search settings" />
                        </Panel>
                        <ScrollView name="settings" class="fill settings" />
                    </Panel>
                </Panel>
            </Panel>
        </Panel>
        <!-- The colour picker, under the swatch it opened from; the picker itself is built in code. -->
        <Panel name="color-popup" class="palette color-popup">
            <Label name="color-title" class="picker-title" />
        </Panel>
        <!-- A reference field's search, under the field it opened from. -->
        <Panel name="picker" class="palette picker">
            <Panel class="picker-head">
                <Button name="picker-back" class="picker-back"><Icon icon="chevron-left" /></Button>
                <Label name="picker-title" class="picker-title" />
            </Panel>
            <Panel class="search picker-search">
                <Icon icon="search" class="search-icon" />
                <TextField name="picker-field" class="search-field" placeholder="Search" />
            </Panel>
            <ListView name="picker-list" class="palette-list" item-height="28" />
            <Label name="picker-empty" class="palette-empty">Nothing matches</Label>
        </Panel>
        <!-- Last, so it is over everything and takes the pointer first. -->
        <Panel name="palette" class="palette">
            <ListView name="palette-list" class="palette-list" item-height="28" />
            <Label name="palette-empty" class="palette-empty">Nothing matches</Label>
        </Panel>
        <!-- Save Layout As asks for the new layout's name here, under the Layout menu's button. -->
        <Panel name="layout-prompt" class="layout-prompt">
            <Label class="layout-prompt-title">Save the layout as</Label>
            <Panel class="layout-prompt-row">
                <TextField name="layout-prompt-name" class="search-field layout-prompt-name" placeholder="Layout name" />
                <Button name="layout-prompt-save" class="primary">Save</Button>
            </Panel>
        </Panel>
        <!-- A script field's tooltip, under its label. It takes no pointer, so it is after the palette. -->
        <Label name="tooltip" class="tooltip" />
    </Panel>
</vui>
