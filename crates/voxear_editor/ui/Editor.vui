<vui>
    <Style src="Editor.vss" />
    <Panel name="editor" class="editor">
        <Panel class="topbar">
            <Panel class="topbar-left">
                <Panel class="logo">
                    <Icon icon="logo-top" class="logo-top" />
                    <Icon icon="logo-left" class="logo-left" />
                    <Icon icon="logo-right" class="logo-right" />
                </Panel>
                <Label class="brand">Voxear</Label>
                <Segmented name="workspaces" class="workspaces">
                    <Segment text="World" />
                    <Segment text="Animation" />
                    <Segment text="Profiling" />
                </Segmented>
                <Panel class="command">
                    <Icon icon="search" class="command-icon" />
                    <TextField name="command" class="command-field" placeholder="Search or run a command" />
                    <Label class="kbd">Ctrl K</Label>
                </Panel>
            </Panel>
            <Panel class="play">
                <Button name="play" class="icon-button play-button"><Icon icon="play" /></Button>
                <Button name="pause" class="icon-button"><Icon icon="pause" /></Button>
                <Button name="step" class="icon-button"><Icon icon="step" /></Button>
            </Panel>
            <Panel class="topbar-right">
                <Label name="avatar" class="avatar" />
                <Button name="build" class="primary build"><Label>Build</Label></Button>
            </Panel>
        </Panel>
        <Panel class="body">
            <Panel class="rail">
                <Button name="rail-scene" class="icon-button rail-button"><Icon icon="cube" /></Button>
                <Button class="icon-button rail-button"><Icon icon="level" /></Button>
                <Button class="icon-button rail-button"><Icon icon="code" /></Button>
                <Button class="icon-button rail-button"><Icon icon="audio" /></Button>
                <Button class="icon-button rail-button"><Icon icon="profiler" /></Button>
                <Panel class="spacer" />
                <Button class="icon-button rail-button"><Icon icon="branch" /></Button>
            </Panel>
            <DockSpace name="dock" class="dock">
                <DockPanel id="hierarchy" title="Hierarchy" class="dock-content">
                    <Panel class="panel-actions">
                        <Button class="icon-button"><Icon icon="plus" /></Button>
                        <Button class="icon-button"><Icon icon="more" /></Button>
                    </Panel>
                    <Panel class="search">
                        <Icon icon="search" class="search-icon" />
                        <TextField name="hierarchy-filter" class="search-field" placeholder="Filter" />
                    </Panel>
                    <TreeView name="hierarchy-tree" class="fill" item-height="24" />
                </DockPanel>
                <DockPanel id="levels" title="Levels" icon="level" class="dock-content">
                    <Panel class="search">
                        <Icon icon="search" class="search-icon" />
                        <TextField name="levels-filter" class="search-field" placeholder="Find a level or scene" />
                    </Panel>
                    <ListView name="levels-list" class="fill levels" item-height="24" />
                    <Panel name="levels-progress" class="level-progress">
                        <Label name="levels-progress-text" class="level-progress-text" />
                        <Panel class="level-progress-track">
                            <Panel name="levels-progress-fill" class="level-progress-fill" />
                        </Panel>
                    </Panel>
                </DockPanel>
                <DockPanel id="project" title="Project" class="dock-content">
                    <Panel class="panel-actions">
                        <Button class="icon-button"><Icon icon="plus" /></Button>
                        <Button class="icon-button"><Icon icon="more" /></Button>
                    </Panel>
                    <SplitView name="project-split" class="fill project-split" size="200">
                        <TreeView name="project-folders" class="fill folders" item-height="24" />
                        <Panel class="files-pane">
                            <Panel class="breadcrumb">
                                <Label name="project-path" class="crumbs" />
                                <Label name="project-count" class="count" />
                            </Panel>
                            <ListView name="project-files" class="fill files" item-height="24" />
                        </Panel>
                    </SplitView>
                </DockPanel>
                <DockPanel id="console" title="Console" class="dock-content">
                    <ListView name="console-list" class="fill console" item-height="20" />
                </DockPanel>
                <DockPanel id="scene" title="Scene" icon="cube">
                    <Panel class="panel-actions">
                        <Dropdown name="shading" class="shading">
                            <Option>Lit</Option>
                            <Option>Unlit</Option>
                            <Option>Wireframe</Option>
                        </Dropdown>
                        <Button name="gizmos" class="header-button">Gizmos</Button>
                        <Button class="icon-button"><Icon icon="maximize" /></Button>
                    </Panel>
                    <Panel name="viewport" class="viewport">
                        <Panel name="handles" class="handles" />
                        <Panel name="tool-strip" class="overlay tools">
                            <Segmented name="tool" class="tool-modes" value="1">
                                <Segment icon="select" />
                                <Segment icon="move" />
                                <Segment icon="rotate" />
                                <Segment icon="scale" />
                            </Segmented>
                            <Panel class="tool-divider" />
                            <Button name="pivot" class="tool-toggle">Pivot</Button>
                            <Button name="space" class="tool-toggle">Global</Button>
                            <Panel class="tool-divider" />
                            <Button name="snap" class="tool-toggle"><Icon icon="grid" /><Label>0.25 m</Label></Button>
                        </Panel>
                        <Label name="scene-stats" class="overlay chip" />
                        <Panel name="view-gizmo" class="overlay gizmo-box">
                            <Panel name="gizmo" class="gizmo" />
                            <Label class="projection">Persp</Label>
                        </Panel>
                    </Panel>
                </DockPanel>
                <DockPanel id="game" title="Game" icon="play">
                    <Panel name="game-viewport" class="viewport">
                        <Label name="game-empty" class="placeholder">No camera renders this level.</Label>
                    </Panel>
                </DockPanel>
                <DockPanel id="cookbook" title="Cookbook" icon="book" name="cookbook" />
                <DockPanel id="inspector" title="Inspector">
                    <Panel class="panel-actions">
                        <Button class="icon-button"><Icon icon="more" /></Button>
                    </Panel>
                    <ScrollView name="inspector" class="fill inspector" />
                </DockPanel>
            </DockSpace>
        </Panel>
        <Panel class="statusbar">
            <Panel class="status-dot" />
            <Label name="status-left" class="status-text">Ready</Label>
            <Label name="status-time" />
            <Panel class="spacer" />
            <Label name="status-renderer">Vulkan</Label>
            <Label name="status-fps" />
            <Label name="status-memory" />
            <Panel name="status-branch" class="status-branch">
                <Icon icon="branch" />
                <Label name="status-branch-name" />
            </Panel>
        </Panel>
        <Panel name="viewport-frame" class="viewport-frame" />
    </Panel>
</vui>
