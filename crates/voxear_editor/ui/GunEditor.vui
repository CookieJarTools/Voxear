<!-- The Gun Editor: a gun's handling, the character holding it in the view, what it does along the bottom, and
     what is picked on the right. Its action buttons, timeline and details are made in code. -->
<vui>
    <Panel class="gun-bar">
        <Button name="gun-handling" class="gun-asset"><Icon icon="crosshair" /><Label name="gun-handling-name">None</Label><Icon icon="chevron-down" class="layouts-arrow" /></Button>
        <Button name="gun-new" class="icon-button"><Icon icon="plus" /></Button>
        <Panel class="tool-divider" />
        <Dropdown name="gun-character" class="gun-character">
            <Option>No character</Option>
        </Dropdown>
        <Panel class="spacer" />
        <Segmented name="gun-view" class="gun-views">
            <Segment text="First Person" />
            <Segment text="Side" />
            <Segment text="Front" />
            <Segment text="Orbit" />
        </Segmented>
        <Panel class="tool-divider" />
        <Button name="gun-undo" class="icon-button"><Icon icon="undo" /></Button>
        <Button name="gun-redo" class="icon-button"><Icon icon="redo" /></Button>
    </Panel>
    <Panel class="gun-bar gun-states">
        <Segmented name="gun-pose" class="gun-pose">
            <Segment text="Hip" />
            <Segment text="Aim" />
        </Segmented>
        <Button name="gun-fire" class="tool-toggle">Fire</Button>
        <Panel class="tool-divider" />
        <Panel name="gun-actions" class="gun-actions" />
        <Button name="gun-add-action" class="icon-button"><Icon icon="plus" /></Button>
        <Panel class="spacer" />
        <Button name="gun-play" class="icon-button"><Icon name="gun-play-icon" icon="play" /></Button>
        <Button name="gun-loop" class="icon-button gun-loop"><Icon icon="loop" /></Button>
        <Dropdown name="gun-speed" class="gun-speed">
            <Option>1×</Option>
            <Option>0.5×</Option>
            <Option>0.25×</Option>
            <Option>0.1×</Option>
        </Dropdown>
        <Panel class="tool-divider" />
        <Segmented name="gun-ammo" class="gun-ammo">
            <Segment text="Full" />
            <Segment text="Half" />
            <Segment text="Empty" />
            <Segment text="Dry" />
        </Segmented>
        <Toggle name="gun-walk" class="checkbox">Walk</Toggle>
    </Panel>
    <SplitView direction="column" size="62%" min="120" class="fill">
        <SplitView size="74%" min="160" class="fill">
            <Panel name="gun-viewport" class="viewport gun-viewport">
                <Panel name="gun-handles" class="handles" />
                <Label name="gun-empty" class="placeholder gun-empty">Pick a Gun Handling and a character holding a gun.</Label>
                <Label name="gun-time" class="overlay chip gun-time" />
            </Panel>
            <ScrollView name="gun-details" class="fill gun-details" />
        </SplitView>
        <Panel class="fill gun-bottom">
            <Panel name="gun-timeline" class="fill gun-timeline" />
            <Panel name="gun-problems" class="gun-problems" />
        </Panel>
    </SplitView>
</vui>
