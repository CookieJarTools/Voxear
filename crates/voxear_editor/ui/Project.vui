<!-- A Project panel: the folder tree beside the files of the folder it shows, with the path, the count and the
     rename bar above them. Every Project panel is built from this, the first and any opened from a window's menu. -->
<vui>
    <Panel class="panel-actions">
        <Button class="icon-button"><Icon icon="plus" /></Button>
    </Panel>
    <SplitView name="project-split" class="fill project-split" size="200">
        <TreeView name="project-folders" class="fill folders" item-height="24" />
        <Panel class="files-pane">
            <Panel class="breadcrumb">
                <Label name="project-path" class="crumbs" />
                <Label name="project-count" class="count" />
            </Panel>
            <Panel name="project-rename" class="project-rename">
                <Label class="project-rename-label">Rename</Label>
                <TextField name="project-rename-field" class="search-field project-rename-field" />
            </Panel>
            <ListView name="project-files" class="fill files" item-height="24" />
        </Panel>
    </SplitView>
</vui>
