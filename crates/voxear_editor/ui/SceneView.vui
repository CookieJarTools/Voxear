<!-- A Scene view: its header's controls, the bar naming a prefab or a particle effect open on its own, and the 3D
     view with the tool strip, the particles' playback, stats and axis gizmo over it. Every Scene view is built
     from this, the first and any opened from a window's menu. -->
<vui>
    <Panel class="panel-actions">
        <Dropdown name="shading" class="shading">
            <Option>Lit</Option>
            <Option>Unlit</Option>
            <Option>Wireframe</Option>
            <Option>Lit Wireframe</Option>
        </Dropdown>
        <Button name="gizmos" class="header-button">Gizmos</Button>
        <Button name="gizmos-menu" class="icon-button"><Icon icon="chevron-down" /></Button>
        <Button name="scene-maximize" class="icon-button"><Icon icon="maximize" /></Button>
    </Panel>
    <!-- Over the view while a prefab is open on its own, as Unity's prefab mode. -->
    <Panel name="prefab-bar" class="prefab-bar">
        <Button name="prefab-back" class="header-button prefab-back"><Icon icon="chevron-left" /><Label>Back</Label></Button>
        <Icon name="prefab-icon" icon="cube" class="prefab-icon" />
        <Label name="prefab-name" class="prefab-name" />
        <Label name="prefab-hint" class="prefab-hint">Lock a component for designers from its menu</Label>
        <Button name="prefab-close" class="header-button prefab-close"><Icon icon="close" /><Label name="prefab-close-label">Close Prefab</Label></Button>
    </Panel>
    <Panel name="viewport" class="viewport">
        <Panel name="handles" class="handles" />
        <Panel name="tool-strip" class="overlay tools">
            <Segmented name="tool" class="tool-modes" value="1">
                <Segment icon="select" />
                <Segment icon="move" />
                <Segment icon="rotate" />
                <Segment icon="scale" />
            </Segmented>
            <Panel class="tool-divider" />
            <Button name="pivot" class="tool-toggle">Pivot</Button>
            <Button name="space" class="tool-toggle">Global</Button>
            <Panel class="tool-divider" />
            <Button name="snap" class="tool-toggle"><Icon icon="grid" /><Label>0.25 m</Label></Button>
        </Panel>
        <!-- While a Particle System is selected, or an effect is open: its playback. -->
        <Panel name="particle-strip" class="overlay particle-strip">
            <Button name="particle-play" class="tool-toggle"><Icon name="particle-play-icon" icon="pause" /></Button>
            <Button name="particle-restart" class="tool-toggle">Restart</Button>
            <Button name="particle-speed" class="tool-toggle">1×</Button>
            <Slider name="particle-scrub" class="particle-scrub" min="0" max="1" value="0" />
            <Label name="particle-time" class="particle-time">0.00 s</Label>
        </Panel>
        <Label name="scene-stats" class="overlay chip" />
        <Panel name="view-gizmo" class="overlay gizmo-box">
            <Panel name="gizmo" class="gizmo" />
            <Label class="projection">Persp</Label>
        </Panel>
    </Panel>
</vui>
