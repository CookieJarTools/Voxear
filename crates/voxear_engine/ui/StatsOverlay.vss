/* The stats overlay (F1), styled as the editor will be: a near-black
   panel, one accent, Inter for names and a monospaced face for numbers. */

:root {
    --surface: #111216eb;
    --edge: #2a2b30;
    --text: #e8e8ec;
    --muted: #8b8c96;
    --faint: #5c5d66;
    --accent: #8b93ff;
}

.stats {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 228px;
    padding: 12px;
    gap: 6px;
    border-radius: 10px;
    background-color: var(--surface);
    border: 1px solid var(--edge);
    font-size: 12px;
    color: var(--muted);
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.title {
    color: var(--text);
    font-weight: 600;
}

.header:hover .title {
    color: var(--accent);
}

.hint {
    font-family: mono;
    font-size: 11px;
    color: var(--faint);
}

.body {
    gap: 6px;
}

/* Clicking the header folds the panel down to it. */
.collapsed .body {
    display: none;
}

.divider {
    height: 1px;
    background-color: var(--edge);
}

.row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.value {
    font-family: mono;
    color: var(--text);
}

.accent {
    color: var(--accent);
}

/* The console: over the top of the game, the log as it comes, and a prompt. */
.console {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    height: 42%;
    padding: 8px 12px;
    gap: 6px;
    background-color: #111216;
    font-size: 12px;
    color: var(--text);
}

.console-lines {
    flex-grow: 1;
}

.console-line {
    font-family: mono;
    font-size: 12px;
    white-space: nowrap;
}

.console-line.warning {
    color: #f2c55c;
}

.console-line.error {
    color: #ff6b6b;
}

.console-line.typed {
    color: var(--accent);
}

.console-prompt {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0px 8px;
    border-radius: 6px;
    background-color: #0a0b0e;
    border: 1px solid var(--edge);
}

.console-caret {
    font-family: mono;
    color: var(--accent);
}

/* The prompt is the box; the field in it has none of its own. */
.console-input, .console-input:hover, .console-input:focus {
    flex-grow: 1;
    padding: 0px;
    background-color: #00000000;
    border: 0px solid #00000000;
    font-family: mono;
}

/* While the console is open, it covers where the stats show. */
.under-console {
    display: none;
}

.graph {
    height: 44px;
    border-radius: 6px;
    background-color: #0a0b0e;
}

