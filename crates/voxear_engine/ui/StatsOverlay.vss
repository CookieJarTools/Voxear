/* The stats overlay (F1), styled as the editor will be: a near-black
   panel, one accent, Inter for names and a monospaced face for numbers. */

:root {
    --surface: #111216eb;
    --edge: #2a2b30;
    --text: #e8e8ec;
    --muted: #8b8c96;
    --faint: #5c5d66;
    --accent: #8b93ff;
}

.stats {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 228px;
    padding: 12px;
    gap: 6px;
    border-radius: 10px;
    background-color: var(--surface);
    border: 1px solid var(--edge);
    font-size: 12px;
    color: var(--muted);
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.title {
    color: var(--text);
    font-weight: 600;
}

.header:hover .title {
    color: var(--accent);
}

.hint {
    font-family: mono;
    font-size: 11px;
    color: var(--faint);
}

.body {
    gap: 6px;
}

/* Clicking the header folds the panel down to it. */
.collapsed .body {
    display: none;
}

.divider {
    height: 1px;
    background-color: var(--edge);
}

.row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.value {
    font-family: mono;
    color: var(--text);
}

.accent {
    color: var(--accent);
}
