<vui>
    <Style src="StatsOverlay.vss" />
    <Panel name="stats" class="stats">
        <Panel name="header" class="header">
            <Label class="title">Stats</Label>
            <Label class="hint">F1</Label>
        </Panel>
        <Panel class="body">
            <Panel class="divider" />
            <Panel class="row"><Label>Frame rate</Label><Label name="fps" class="value accent">–</Label></Panel>
            <!-- What the CPU spent on a frame, less its waits for the GPU and the display. -->
            <Panel class="row"><Label>CPU</Label><Label name="frame" class="value">–</Label></Panel>
            <Panel class="row"><Label>GPU</Label><Label name="gpu" class="value">–</Label></Panel>
            <!-- The last few seconds of frame times, under a line at 60 frames a second. -->
            <Panel name="graph" class="graph" />
            <Panel class="divider" />
            <Panel class="row"><Label>Draws</Label><Label name="draws" class="value">–</Label></Panel>
            <Panel class="row"><Label>Shadow draws</Label><Label name="shadow-draws" class="value">–</Label></Panel>
            <Panel class="row"><Label>Culled</Label><Label name="culled" class="value">–</Label></Panel>
            <!-- Meshlets drawn, of those tested. -->
            <Panel class="row"><Label>Meshlets</Label><Label name="meshlets" class="value">–</Label></Panel>
            <Panel class="divider" />
            <Panel class="row"><Label>Lights per cluster</Label><Label name="lights" class="value">–</Label></Panel>
            <Panel class="row"><Label>Exposure</Label><Label name="exposure" class="value">–</Label></Panel>
            <!-- While networked: the session, its round trip and loss, and what goes each way. -->
            <Panel name="network" class="network">
                <Panel class="divider" />
                <Panel class="row"><Label>Network</Label><Label name="net-role" class="value">–</Label></Panel>
                <Panel class="row"><Label>Ping</Label><Label name="net-ping" class="value">–</Label></Panel>
                <Panel class="row"><Label>Loss</Label><Label name="net-loss" class="value">–</Label></Panel>
                <Panel class="row"><Label>Up / down</Label><Label name="net-rate" class="value">–</Label></Panel>
            </Panel>
        </Panel>
    </Panel>
    <!-- The console, on the key left of 1: the log, and a line to run commands from. -->
    <Panel name="console" class="console">
        <ListView name="console-lines" class="console-lines" item-height="18" />
        <Panel class="console-prompt">
            <Label class="console-caret">›</Label>
            <TextField name="console-input" class="console-input" placeholder="A command or variable, or help" />
        </Panel>
    </Panel>
</vui>
