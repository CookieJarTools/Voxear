/* Voxear's default look, after the editor concept: near-black panels on a
   darker window, thin borders, one periwinkle accent, and compact 24px rows,
   with shadows only on what floats. Every Ui starts with it on its root. A
   sheet of your own overrides any of it, and changing the variables is the
   quickest way to retheme. Theme (theme.rs) makes every colour here from a
   base, an accent and a contrast, and gives these for its DARK. */

:root {
    --vx-bg: #0c0e10;
    --vx-panel: #191a1c;
    --vx-overlay: rgba(28, 29, 33, 0.92);
    --vx-glass: rgba(28, 29, 33, 0.6);
    --vx-line: #25272b;
    --vx-line-2: #2e3036;
    --vx-field: #212227;
    --vx-field-line: #2e3036;
    --vx-hover: #232428;
    --vx-selected: #2d3039;
    --vx-seg-on: #393c45;
    --vx-text: #eceded;
    --vx-text-2: #c8ccd1;
    --vx-muted: #9ea4ae;
    --vx-accent: #7988ff;
    --vx-accent-hover: #8a97ff;
    --vx-accent-soft: rgba(121, 136, 255, 0.2);
    --vx-on-accent: #ffffff;
    --vx-success: #4cb782;
    --vx-warning: #e2b340;
    --vx-danger: #e5534b;
    --vx-prefab: #7cb1ff;
    --vx-prefab-member: #a3c6f5;
    --vx-x: #eb5757;
    --vx-y: #4cb782;
    --vx-z: #5e8bf0;
    --vx-fade: 120ms ease-out;

    font-size: 12px;
    line-height: 16px;
    color: var(--vx-text-2);
    link-color: var(--vx-accent);
    code-background: var(--vx-selected);
    mark-color: rgba(226, 179, 64, 0.22);
}

Button {
    height: 24px;
    padding: 0px 10px;
    gap: 6px;
    justify-content: center;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
    color: var(--vx-text);
    font-weight: 500;
    text-align: center;
    transition: background-color var(--vx-fade), border-color var(--vx-fade), color var(--vx-fade);
}

Button:hover {
    background-color: var(--vx-hover);
    border-color: var(--vx-line-2);
}

Button:active {
    background-color: var(--vx-selected);
}

/* Only when reached with Tab: a button pressed with the pointer keeps no ring. */
Button:focus-visible {
    border-color: var(--vx-accent);
}

/* The one call to action on a surface. */
.primary {
    border-radius: 6px;
    background-color: var(--vx-accent);
    border-color: var(--vx-accent);
    color: var(--vx-on-accent);
    font-weight: 600;
}

.primary:hover {
    background-color: var(--vx-accent-hover);
    border-color: var(--vx-accent-hover);
}

/* A square button holding one icon, quiet until the pointer finds it. */
.icon-button {
    width: 24px;
    height: 24px;
    padding: 0px;
    border-radius: 5px;
    background-color: transparent;
    border-color: transparent;
    color: var(--vx-muted);
}

.icon-button:hover {
    background-color: var(--vx-hover);
    border-color: transparent;
    color: var(--vx-text);
}

.icon-button:checked {
    background-color: var(--vx-accent-soft);
    color: var(--vx-accent);
}

Button:disabled, TextField:disabled, Toggle:disabled, Slider:disabled, Dropdown:disabled {
    opacity: 0.45;
}

TextField {
    padding: 0px 7px;
    height: 24px;
    justify-content: center;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
    color: var(--vx-text);
    selection-color: rgba(121, 136, 255, 0.4);
    transition: border-color var(--vx-fade);
}

TextField:hover {
    border-color: var(--vx-line-2);
}

TextField:focus {
    border-color: var(--vx-accent);
}

/* Toggles are switches: a 26 by 14 pill with a white knob that slides over
   when on. The `checkbox` class makes one a ticked box instead. */

Toggle {
    gap: 8px;
}

.toggle-box {
    width: 26px;
    height: 14px;
    padding: 2px;
    justify-content: flex-start;
    border-radius: 7px;
    background-color: var(--vx-seg-on);
    transition: background-color var(--vx-fade);
}

.toggle-mark {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #ffffff;
}

.toggle-check {
    display: none;
}

Toggle:hover .toggle-box {
    background-color: #44474f;
}

Toggle:checked .toggle-box {
    justify-content: flex-end;
    background-color: var(--vx-accent);
}

Toggle:focus-visible .toggle-box {
    border: 1px solid var(--vx-accent);
    padding: 1px;
}

.checkbox .toggle-box {
    width: 14px;
    height: 14px;
    padding: 0px;
    justify-content: center;
    border-radius: 3px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-line-2);
}

.checkbox .toggle-mark {
    display: none;
}

.checkbox .toggle-check {
    display: flex;
    width: 10px;
    height: 10px;
    color: transparent;
}

.checkbox:hover .toggle-box {
    background-color: var(--vx-hover);
}

.checkbox:checked .toggle-box {
    background-color: var(--vx-accent);
    border-color: var(--vx-accent);
}

.checkbox:checked .toggle-check {
    color: var(--vx-on-accent);
}

Slider {
    height: 20px;
    gap: 10px;
}

.slider-track {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-seg-on);
}

.slider-fill {
    border-radius: 2px;
    background-color: var(--vx-accent);
}

.slider-thumb {
    width: 12px;
    height: 12px;
    top: -4px;
    margin-left: -6px;
    border-radius: 6px;
    background-color: #ffffff;
}

.slider-value {
    min-width: 30px;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
    text-align: right;
}

.foldout-header {
    height: 26px;
    gap: 6px;
}

.foldout-arrow {
    width: 12px;
    height: 12px;
    color: var(--vx-muted);
}

.foldout-icon {
    color: var(--vx-muted);
}

.foldout-title {
    flex-grow: 1;
    color: var(--vx-text);
    font-weight: 600;
}

Foldout:focus-visible .foldout-title {
    color: var(--vx-accent);
}

.foldout-content {
    padding-left: 18px;
    gap: 4px;
}

/* Rows: 24px, inset from the list's sides, with an accent bar down the
   left of a selected one. */

.list-row {
    margin: 0px 4px;
    padding: 0px 6px;
    gap: 6px;
    overflow: hidden;
    white-space: nowrap;
    border-radius: 5px;
    color: var(--vx-text-2);
    transition: background-color var(--vx-fade);
}

.list-row:hover {
    background-color: var(--vx-hover);
}

.list-row:selected {
    background-color: var(--vx-selected);
    color: var(--vx-text);
}

.row-bar {
    display: none;
    left: 0px;
    top: 2px;
    bottom: 2px;
    width: 2px;
    border-radius: 1px;
    background-color: var(--vx-accent);
}

.list-row:selected > .row-bar {
    display: flex;
}

.tree-row {
    padding-left: 2px;
}

.tree-arrow {
    height: 12px;
    color: var(--vx-muted);
}

.tree-content {
    gap: 6px;
}

.split-divider {
    background-color: var(--vx-line);
}

.split-row > .split-divider {
    width: 4px;
}

.split-column > .split-divider {
    height: 4px;
}

/* A divider being hovered or dragged lights a handle across its middle,
   rather than its whole length, drawn over everything so nothing beside
   the divider hides it. */
.split-handle {
    z-index: 10;
    border-radius: 2px;
    background-color: transparent;
    transition: background-color var(--vx-fade);
}

.split-row > .split-divider > .split-handle {
    width: 4px;
    height: 40%;
    min-height: 24px;
    max-height: 160px;
}

.split-column > .split-divider > .split-handle {
    width: 40%;
    height: 4px;
    min-width: 24px;
    max-width: 160px;
}

.split-divider:hover > .split-handle, .split-divider:active > .split-handle {
    background-color: var(--vx-accent);
}

.tab-bar {
    gap: 2px;
    align-items: center;
}

.tab {
    height: 22px;
    padding: 0px 8px;
    gap: 5px;
    border-radius: 5px;
    border: 0px transparent;
    background-color: transparent;
    color: var(--vx-muted);
    font-weight: 500;
}

.tab > Icon {
    width: 13px;
    height: 13px;
}

.tab:hover {
    background-color: var(--vx-hover);
    color: var(--vx-text-2);
}

.tab:checked {
    background-color: var(--vx-selected);
    color: var(--vx-text);
}

Dropdown {
    height: 24px;
    padding: 0px 7px;
    gap: 6px;
    border-radius: 5px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
    color: var(--vx-text);
    transition: background-color var(--vx-fade), border-color var(--vx-fade);
}

Dropdown:hover {
    border-color: var(--vx-line-2);
}

Dropdown:focus-visible {
    border-color: var(--vx-accent);
}

.dropdown-arrow {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    color: var(--vx-muted);
}

/* Squeezed, a dropdown cuts its text short and keeps its arrow. */
.dropdown-label {
    min-width: 0px;
    overflow: hidden;
    white-space: nowrap;
}

.dropdown-popup {
    padding: 4px;
    max-height: 240px;
    overflow: auto;
    border-radius: 7px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.4);
    color: var(--vx-text-2);
}

.dropdown-option {
    height: 24px;
    padding: 0px 7px;
    justify-content: center;
    border-radius: 5px;
    transition: background-color var(--vx-fade);
}

.dropdown-option:hover {
    background-color: var(--vx-selected);
    color: var(--vx-text);
}

.dropdown-option:checked {
    color: var(--vx-accent);
}

/* Context menus float like a dropdown's list, with a column for ticks. */

.menu-popup {
    min-width: 180px;
    max-height: 360px;
    overflow: auto;
    padding: 4px;
    border-radius: 7px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.4);
    color: var(--vx-text-2);
}

.menu-item {
    height: 24px;
    padding: 0px 12px 0px 6px;
    gap: 6px;
    align-items: center;
    border-radius: 5px;
    transition: background-color var(--vx-fade);
}

.menu-item:hover {
    background-color: var(--vx-selected);
    color: var(--vx-text);
}

.menu-item:disabled {
    background-color: transparent;
    color: var(--vx-muted);
    opacity: 0.6;
}

.menu-check {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--vx-accent);
}

.menu-shortcut {
    margin-left: auto;
    padding-left: 24px;
    color: var(--vx-muted);
}

.menu-separator {
    height: 1px;
    margin: 4px 2px;
    background-color: var(--vx-line-2);
}

/* A row dragged in a list lands on the row marked here. */

/* What is being dragged, following the pointer. */
.drag-ghost {
    padding: 3px 9px;
    border-radius: 6px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-accent);
    box-shadow: 0px 6px 18px rgba(0, 0, 0, 0.4);
    color: var(--vx-text);
}

/* What an element's tooltip says, under it once the pointer rests there. */
.tooltip {
    position: absolute;
    z-index: 30;
    max-width: 280px;
    padding: 5px 8px;
    border-radius: 5px;
    pointer-events: none;
    background-color: var(--vx-overlay);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 6px 16px rgba(0, 0, 0, 0.4);
    color: var(--vx-text);
    font-size: 11px;
}

/* An item lifted out of a reorderable list by its handle rides over the others,
   which slide out of its way. */
.reorder-lifted {
    z-index: 1;
    box-shadow: 0px 6px 18px rgba(0, 0, 0, 0.45);
}

/* A row dragged lands before or after the row marked so: a short bar on that
   edge, as the split handles show, over the rows either side. */
.drop-line {
    display: none;
    z-index: 10;
    left: 30%;
    width: 40%;
    min-width: 24px;
    max-width: 160px;
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-accent);
}

.list-row.drop-before > .drop-line {
    display: flex;
    top: -2px;
}

.list-row.drop-after > .drop-line {
    display: flex;
    bottom: -2px;
}

.list-row.drop-target {
    background-color: var(--vx-selected);
    border: 1px solid var(--vx-accent);
    border-radius: 5px;
}

/* Segmented controls sit in a field-coloured well; the segment that is on
   is raised a little. */

Segmented {
    height: 24px;
    padding: 2px;
    gap: 2px;
    border-radius: 6px;
    background-color: var(--vx-field);
}

.segment {
    height: 20px;
    padding: 0px 8px;
    border-radius: 4px;
    border: 0px transparent;
    background-color: transparent;
    color: var(--vx-muted);
}

.segment:hover {
    background-color: var(--vx-hover);
    color: var(--vx-text-2);
}

.segment:checked {
    background-color: var(--vx-seg-on);
    box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.4);
    color: var(--vx-text);
}

/* Docking: panels are rounded cards with narrow gaps between them. The
   gaps are the dividers, whose handles light up when the pointer finds them. */

DockSpace {
    padding: 0px;
}

.dock-area {
    overflow: hidden;
    border-radius: 8px;
    background-color: var(--vx-panel);
    border: 1px solid var(--vx-line);
}

/* The header: 32px of tabs with a line under it, drawn as a hard shadow
   so it needs no border of its own. */
.dock-area > .tab-bar {
    height: 32px;
    padding: 0px 32px 0px 5px;
    box-shadow: 0px 1px 0px var(--vx-line);
}

/* Every area's options button, at its tab bar's right end: the window's menu. */
.dock-menu {
    position: absolute;
    top: 5px;
    right: 4px;
    width: 22px;
    height: 22px;
}

DockSpace .split-divider {
    background-color: transparent;
}

DockSpace .split-row > .split-divider {
    width: 6px;
}

DockSpace .split-column > .split-divider {
    height: 6px;
}

.dock-ghost {
    height: 22px;
    padding: 0px 8px;
    justify-content: center;
    border-radius: 5px;
    background-color: var(--vx-selected);
    border: 1px solid var(--vx-accent);
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.4);
    color: var(--vx-text);
}

.dock-preview {
    border-radius: 8px;
    background-color: var(--vx-accent-soft);
    border: 1px solid var(--vx-accent);
}

/* A floating window: an area's card lifted over the dock, with a shadow,
   moved by its bar and resized by the grip in its corner. It is the dock's
   last child, so it is drawn over the areas without a z-index, which would
   put it over menus opened from it too. */
.dock-float {
    border-radius: 9px;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.3);
}

.dock-float > .dock-area {
    border: 1px solid var(--vx-line-2);
}

/* A floating window out on the desktop, in a window of its own: the desktop
   draws the window's edge and shadow, so the card fills it, square. */
.dock-window {
    border-radius: 0px;
    box-shadow: none;
    background-color: var(--vx-panel);
}

.dock-window > .dock-area {
    border-radius: 0px;
    border: 0px transparent;
}

.dock-float-grip {
    border-radius: 4px;
}

.dock-float-grip:hover {
    background-color: var(--vx-accent-soft);
}

/* The colour picker: a square of saturation and brightness for the hue on
   the bar under it, the colour before and now, and its values to type. */
.color-picker {
    flex-direction: column;
    gap: 8px;
    width: 232px;
}

.color-square {
    height: 152px;
    border-radius: 6px;
}

.color-mark {
    position: absolute;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    margin-top: -7px;
    border-radius: 7px;
    border: 2px solid #ffffff;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.5);
}

.color-hue {
    flex-direction: row;
    align-items: stretch;
    height: 12px;
}

.color-hue-segment {
    flex-grow: 1;
    flex-basis: 0px;
}

.color-hue-mark {
    position: absolute;
    top: -3px;
    width: 8px;
    height: 18px;
    margin-left: -4px;
    border-radius: 3px;
    border: 2px solid #ffffff;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.5);
}

.color-row {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.color-before, .color-now {
    flex-grow: 1;
    flex-basis: 0px;
    height: 24px;
    border-radius: 5px;
    border: 1px solid var(--vx-field-line);
}

.color-hex {
    width: 82px;
    font-family: mono;
    font-size: 11px;
}

.color-channel {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    gap: 4px;
}

.color-channel-letter {
    font-size: 10px;
    font-weight: 600;
    color: var(--vx-muted);
}

.color-channel-input {
    flex-grow: 1;
    min-width: 0px;
    font-family: mono;
    font-size: 11px;
}

.color-intensity-label {
    color: var(--vx-muted);
}

.color-intensity-slider {
    flex-grow: 1;
}

.color-intensity-input {
    width: 52px;
    font-family: mono;
    font-size: 11px;
}

/* Key maps: a device's keys, lit where bound, with labels round it naming
   their actions. A key's category colour, when it has one, is set on the
   key itself and wins over these. */
/* A device is drawn as it is, whichever way the game reads. */
.keymap {
    direction: ltr;
    position: relative;
    flex-grow: 1;
    min-height: 0px;
}

.keymap-lines {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
}

.keymap-key {
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 5px;
    border: 1px solid var(--vx-field-line);
    background-color: var(--vx-field);
    color: var(--vx-muted);
    transition: background-color var(--vx-fade);
}

.keymap-key.round, .keymap-key.stick {
    border-radius: 999px;
}

.keymap-key.pill {
    border-radius: 999px;
}

.keymap-key.stick {
    border: 3px solid var(--vx-field-line);
}

.keymap-key.assigned {
    background-color: var(--vx-accent);
    border-color: var(--vx-accent-hover);
    color: var(--vx-on-accent);
}

.keymap-key.hidden {
    background-color: var(--vx-panel);
    border-color: var(--vx-accent-soft);
    color: var(--vx-text-2);
}

.keymap-key.conflict {
    background-color: var(--vx-danger);
    border-color: #ff8f88;
    color: var(--vx-on-accent);
}

.keymap-key:hover {
    border-color: var(--vx-text);
}

.keymap-body-edge {
    background-color: var(--vx-line-2);
}

.keymap-body {
    background-color: var(--vx-bg);
}

.keymap-key-label {
    text-align: center;
    white-space: nowrap;
}

.keymap-callout {
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--vx-muted);
    background-color: var(--vx-panel);
}

.keymap-callout.conflict {
    border-color: var(--vx-danger);
}

.keymap-callout:hover {
    border-color: var(--vx-accent);
}

.keymap-callout-row {
    align-items: center;
    justify-content: center;
}

.keymap-callout-icon {
    width: 11px;
    height: 11px;
    margin-right: 4px;
    color: var(--vx-muted);
}

.keymap-callout-line {
    font-size: 11px;
    line-height: 14px;
    color: var(--vx-text);
    white-space: nowrap;
    text-align: center;
}

/* The ready-made controls screen (KeyBindingScreen in C#): over the whole
   game, a bar along the top, the key map, its legend, and the clicked key's
   actions with their Rebind buttons. */
.key-binding-screen {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    flex-direction: column;
    gap: 12px;
    padding: 20px 28px;
    background-color: rgba(10, 11, 13, 0.92);
}

.kbs-bar {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

.kbs-title {
    margin-right: 16px;
    font-size: 18px;
    line-height: 24px;
    font-weight: 600;
    color: var(--vx-text);
}

.kbs-spacer {
    flex-grow: 1;
}

.kbs-tab.selected {
    background-color: var(--vx-accent-soft);
    border-color: var(--vx-accent);
    color: var(--vx-text);
}

.kbs-legend {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
}

.kbs-legend-entry {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.keymap-key.kbs-swatch {
    width: 14px;
    height: 14px;
    border-radius: 3px;
}

.kbs-details {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    min-height: 32px;
    flex-shrink: 0;
}

.kbs-control {
    font-weight: 600;
    color: var(--vx-text);
}

.kbs-use {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 3px 4px 3px 10px;
    border: 1px solid var(--vx-field-line);
    border-radius: 6px;
    background-color: var(--vx-panel);
}

.kbs-status {
    color: var(--vx-muted);
    flex-shrink: 0;
}

.kbs-layout {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0px;
    gap: 12px;
}

.kbs-list {
    flex-grow: 1;
    min-height: 0px;
}

/* The ready-made menu of look packs (LookPackScreen in C#): a panel down
   the screen's left, so the game shows beside it as packs are tried, with a
   row for each pack. */
.look-pack-screen {
    position: absolute;
    left: 0px;
    top: 0px;
    bottom: 0px;
    width: 420px;
    flex-direction: column;
    gap: 12px;
    padding: 20px 24px;
    background-color: rgba(10, 11, 13, 0.92);
}

.lps-bar {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

.lps-title {
    font-size: 18px;
    line-height: 24px;
    font-weight: 600;
    color: var(--vx-text);
}

.lps-spacer {
    flex-grow: 1;
}

.lps-scroll {
    flex-grow: 1;
    min-height: 0px;
}

.lps-list {
    flex-direction: column;
    gap: 6px;
}

.lps-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 8px;
    height: auto;
    padding: 8px 12px;
    text-align: left;
}

.lps-row.selected {
    background-color: var(--vx-accent-soft);
    border-color: var(--vx-accent);
}

.lps-name {
    font-weight: 600;
    color: var(--vx-text);
}

.lps-source {
    font-size: 11px;
    color: var(--vx-accent);
}

.lps-description {
    width: 100%;
    color: var(--vx-muted);
    white-space: normal;
}

.lps-folder {
    flex-shrink: 0;
    font-size: 11px;
    color: var(--vx-muted);
    white-space: normal;
}

/* The controls as a list (ControlsList in C#): a row for each action, under
   its category, with a column of bindings for each device. */
.controls-list {
    flex-direction: column;
    gap: 2px;
    padding-bottom: 12px;
}

.controls-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    min-height: 34px;
    padding: 2px 8px;
    border-radius: 6px;
}

.controls-row:hover {
    background-color: var(--vx-hover);
}

.controls-header {
    color: var(--vx-muted);
    min-height: 24px;
}

.controls-header:hover {
    background-color: transparent;
}

.controls-heading {
    margin-top: 14px;
    padding: 0px 8px 4px 8px;
    font-weight: 600;
    color: var(--vx-text);
}

.controls-action {
    width: 200px;
    flex-shrink: 0;
    color: var(--vx-text);
}

.controls-cell {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    width: 260px;
    flex-shrink: 0;
}

.controls-binding {
    min-width: 44px;
}

.controls-binding.listening {
    background-color: var(--vx-accent-soft);
    border-color: var(--vx-accent);
    color: var(--vx-text);
}

.controls-none {
    color: var(--vx-muted);
}

.controls-conflict {
    color: var(--vx-warning);
}

/* Prompts: an action's controls as glyphs, as "press A to jump" shows them. Each glyph is a keycap, a round face
   button, a pill for a shoulder or trigger, a square for the d-pad, a ring for a stick, or bare for the mouse. */
.prompt {
    flex-direction: row;
    align-items: center;
    gap: 4px;
}

.prompt-glyph {
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0px 6px;
    border-radius: 5px;
    border: 1px solid var(--vx-field-line);
    background-color: var(--vx-field);
    color: var(--vx-text);
    font-size: 12px;
}

.prompt-glyph.key {
    border-bottom-width: 3px;
}

.prompt-glyph.round {
    width: 24px;
    padding: 0px;
    border-radius: 999px;
    background-color: #24262b;
    font-weight: 700;
}

.prompt-glyph.pill {
    border-radius: 999px;
    padding: 0px 8px;
}

.prompt-glyph.square {
    width: 24px;
    padding: 0px;
    border-radius: 4px;
}

.prompt-glyph.stick {
    width: 24px;
    padding: 0px;
    border-radius: 999px;
    border-width: 2px;
    background-color: transparent;
}

.prompt-glyph.bare {
    border-width: 0px;
    background-color: transparent;
    padding: 0px;
}

.prompt-icon {
    width: 16px;
    height: 16px;
}

.prompt-glyph.bare {
    width: 24px;
}

/* A control shown as a picture, Voxear's or a game's own Prompt Icons: the picture, sized as it is, with no outline. */
.prompt-glyph.sprite {
    min-width: 0px;
    height: auto;
    border-width: 0px;
    background-color: transparent;
    padding: 0px;
}

.prompt-sprite {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
}

/* A map of the game's world (see `map_view`): a minimap on the HUD, and a map opened over the game. The ground is
   drawn into its picture; markers and their labels lie over it. Each part's sizes are its own style, scaled with
   the screen; its colours and its type are here. */
.minimap {
    position: relative;
    flex-direction: column;
    flex-shrink: 0;
}

/* A map covers what it is in, as it is opened over the game. */
.map {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
}

.map-picture, .map-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
}

.map-overlay {
    pointer-events: none;
}

/* What every panel of a map is drawn as. */
.map-panel {
    background-color: rgba(13, 16, 22, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.14);
}

.map-region {
    position: absolute;
    flex-direction: column;
    pointer-events: none;
}

.map-title {
    font-weight: semibold;
    color: #ffffff;
}

.map-divider {
    height: 1px;
    align-self: stretch;
    background-color: rgba(255, 255, 255, 0.14);
}

.map-group {
    flex-direction: row;
    align-items: baseline;
}

.map-axis, .map-unit {
    font-family: mono;
    font-weight: medium;
    color: rgba(255, 255, 255, 0.74);
}

.map-number {
    font-family: mono;
    font-weight: medium;
    color: #ffffff;
}

.map-caption {
    font-weight: medium;
    color: rgba(255, 255, 255, 0.74);
}

.map-environment {
    position: absolute;
    flex-direction: row;
    pointer-events: none;
}

.map-cell {
    flex-direction: column;
}

.map-cell.first {
    border-right: 1px solid rgba(255, 255, 255, 0.14);
}

.map-cell.last {
    border-left: 1px solid rgba(255, 255, 255, 0.14);
}

.map-nav {
    position: absolute;
    flex-direction: column;
    align-items: center;
}

.map-compass, .minimap-compass {
    position: relative;
    pointer-events: none;
}

.minimap-compass {
    position: absolute;
}

.map-compass-north {
    position: absolute;
    font-weight: semibold;
    color: #ffd23f;
}

.map-compass-letter {
    position: absolute;
    font-weight: medium;
    color: rgba(255, 255, 255, 0.74);
}

.map-zoom {
    flex-direction: column;
}

.map-zoom-button {
    align-items: center;
    justify-content: center;
    border-width: 0px;
    border-radius: 0px;
    background-color: transparent;
    color: #ffffff;
}

.map-zoom-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.map-zoom-value {
    flex-direction: column;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
}

/* The name of what the maps follow, over where it is. */
.map-tag {
    position: absolute;
    flex-direction: row;
    align-items: center;
    pointer-events: none;
}

.map-avatar {
    background-color: #ffd23f;
}

.map-tag-name {
    font-weight: semibold;
    color: #ffffff;
}

/* What a marker on a map is called, beside it. */
.map-label {
    position: absolute;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 13px;
    color: #ffffff;
    background-color: rgba(13, 16, 22, 0.82);
}

.minimap-window {
    position: relative;
    overflow: hidden;
}

.minimap-zoom {
    position: absolute;
    flex-direction: row;
    align-items: baseline;
    pointer-events: none;
}

.minimap-info {
    flex-direction: column;
}

/* A row too long for a narrow minimap goes on to the next line. */
.minimap-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
}
