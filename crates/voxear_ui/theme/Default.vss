/* Voxear's default look, Graphite + Abyss: near-black surfaces, thin
   borders, one indigo accent, compact 28px rows, and shadows only on what
   floats. Every Ui starts with it on its root. A sheet of your own overrides
   any of it, and changing the variables is the quickest way to retheme. */

:root {
    --vx-bg: #08090a;
    --vx-panel: #0f1011;
    --vx-overlay: rgba(15, 16, 17, 0.82);
    --vx-line: #1f2023;
    --vx-line-2: #2e3035;
    --vx-field: #141518;
    --vx-field-line: #24262a;
    --vx-hover: #17181b;
    --vx-selected: #1c1e24;
    --vx-seg-on: #24262c;
    --vx-text: #f7f8f8;
    --vx-text-2: #d0d6e0;
    --vx-muted: #8a8f98;
    --vx-accent: #5e6ad2;
    --vx-accent-soft: rgba(94, 106, 210, 0.16);
    --vx-on-accent: #ffffff;
    --vx-success: #4cb782;
    --vx-x: #eb5757;
    --vx-y: #4cb782;
    --vx-z: #5e8bf0;
    --vx-fade: 120ms ease-out;

    font-size: 12px;
    line-height: 16px;
    color: var(--vx-text-2);
}

Button {
    height: 28px;
    padding: 0px 12px;
    gap: 6px;
    justify-content: center;
    border-radius: 7px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
    color: var(--vx-text);
    font-weight: 500;
    text-align: center;
    transition: background-color var(--vx-fade), border-color var(--vx-fade), color var(--vx-fade);
}

Button:hover {
    background-color: var(--vx-hover);
    border-color: var(--vx-line-2);
}

Button:active {
    background-color: var(--vx-selected);
}

Button:focus {
    border-color: var(--vx-accent);
}

/* The one call to action on a surface. */
.primary {
    border-radius: 10px;
    background-color: var(--vx-accent);
    border-color: var(--vx-accent);
    color: var(--vx-on-accent);
    font-weight: 600;
}

.primary:hover {
    background-color: #6c77da;
    border-color: #6c77da;
}

/* A square button holding one icon, quiet until the pointer finds it. */
.icon-button {
    width: 28px;
    height: 28px;
    padding: 0px;
    border-radius: 7px;
    background-color: transparent;
    border-color: transparent;
    color: var(--vx-muted);
}

.icon-button:hover {
    background-color: var(--vx-hover);
    border-color: transparent;
    color: var(--vx-text);
}

.icon-button:checked {
    background-color: var(--vx-accent-soft);
    color: var(--vx-accent);
}

Button:disabled, TextField:disabled, Toggle:disabled, Slider:disabled, Dropdown:disabled {
    opacity: 0.45;
}

TextField {
    padding: 0px 8px;
    height: 26px;
    justify-content: center;
    border-radius: 7px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
    color: var(--vx-text);
    selection-color: rgba(94, 106, 210, 0.4);
    transition: border-color var(--vx-fade);
}

TextField:hover {
    border-color: var(--vx-line-2);
}

TextField:focus {
    border-color: var(--vx-accent);
}

/* Toggles are switches: a 28 by 16 pill with a white knob that slides over
   when on. The `checkbox` class makes one a ticked box instead. */

Toggle {
    gap: 8px;
}

.toggle-box {
    width: 28px;
    height: 16px;
    padding: 2px;
    justify-content: flex-start;
    border-radius: 8px;
    background-color: var(--vx-line-2);
    transition: background-color var(--vx-fade);
}

.toggle-mark {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #ffffff;
}

.toggle-check {
    display: none;
}

Toggle:hover .toggle-box {
    background-color: #3a3c42;
}

Toggle:checked .toggle-box {
    justify-content: flex-end;
    background-color: var(--vx-accent);
}

Toggle:focus .toggle-box {
    border: 1px solid var(--vx-accent);
    padding: 1px;
}

.checkbox .toggle-box {
    width: 16px;
    height: 16px;
    padding: 0px;
    justify-content: center;
    border-radius: 4px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-line-2);
}

.checkbox .toggle-mark {
    display: none;
}

.checkbox .toggle-check {
    display: flex;
    width: 12px;
    height: 12px;
    color: transparent;
}

.checkbox:hover .toggle-box {
    background-color: var(--vx-hover);
}

.checkbox:checked .toggle-box {
    background-color: var(--vx-accent);
    border-color: var(--vx-accent);
}

.checkbox:checked .toggle-check {
    color: var(--vx-on-accent);
}

Slider {
    height: 24px;
    gap: 10px;
}

.slider-track {
    height: 4px;
    border-radius: 2px;
    background-color: var(--vx-line-2);
}

.slider-fill {
    border-radius: 2px;
    background-color: var(--vx-accent);
}

.slider-thumb {
    width: 12px;
    height: 12px;
    top: -4px;
    margin-left: -6px;
    border-radius: 6px;
    background-color: #ffffff;
}

.slider-value {
    min-width: 32px;
    font-family: mono;
    font-size: 11px;
    color: var(--vx-text-2);
    text-align: right;
}

.foldout-header {
    height: 28px;
    gap: 6px;
}

.foldout-arrow {
    color: var(--vx-muted);
}

.foldout-title {
    color: var(--vx-text);
    font-weight: 600;
}

Foldout:focus .foldout-title {
    color: var(--vx-accent);
}

.foldout-content {
    padding-left: 20px;
    gap: 4px;
}

/* Rows: 28px, inset 6px from the list's sides, with a 2px accent bar down
   the left of a selected one. */

.list-row {
    margin: 0px 6px;
    padding: 0px 8px;
    gap: 6px;
    border-radius: 7px;
    color: var(--vx-text-2);
    transition: background-color var(--vx-fade);
}

.list-row:hover {
    background-color: var(--vx-hover);
}

.list-row:selected {
    background-color: var(--vx-selected);
    color: var(--vx-text);
}

.row-bar {
    display: none;
    left: 0px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    border-radius: 1px;
    background-color: var(--vx-accent);
}

.list-row:selected > .row-bar {
    display: flex;
}

.tree-row {
    padding-left: 4px;
}

.tree-arrow {
    color: var(--vx-muted);
}

.tree-content {
    gap: 6px;
}

.split-divider {
    background-color: var(--vx-line);
    transition: background-color var(--vx-fade);
}

.split-row > .split-divider {
    width: 4px;
}

.split-column > .split-divider {
    height: 4px;
}

.split-divider:hover, .split-divider:active {
    background-color: var(--vx-accent);
}

.tab-bar {
    gap: 2px;
    align-items: center;
}

.tab {
    height: 28px;
    padding: 0px 10px;
    border-radius: 7px;
    border: 0px transparent;
    background-color: transparent;
    color: var(--vx-muted);
    font-weight: 500;
}

.tab:hover {
    background-color: var(--vx-hover);
    color: var(--vx-text-2);
}

.tab:checked {
    background-color: var(--vx-selected);
    color: var(--vx-text);
}

Dropdown {
    height: 26px;
    padding: 0px 8px;
    gap: 6px;
    border-radius: 7px;
    background-color: var(--vx-field);
    border: 1px solid var(--vx-field-line);
    color: var(--vx-text);
    transition: background-color var(--vx-fade), border-color var(--vx-fade);
}

Dropdown:hover {
    border-color: var(--vx-line-2);
}

Dropdown:focus {
    border-color: var(--vx-accent);
}

.dropdown-arrow {
    width: 12px;
    height: 12px;
    color: var(--vx-muted);
}

.dropdown-popup {
    padding: 4px;
    max-height: 240px;
    overflow: auto;
    border-radius: 10px;
    background-color: var(--vx-panel);
    border: 1px solid var(--vx-line-2);
    box-shadow: 0px 16px 40px rgba(0, 0, 0, 0.4);
    color: var(--vx-text-2);
}

.dropdown-option {
    height: 28px;
    padding: 0px 8px;
    justify-content: center;
    border-radius: 7px;
    transition: background-color var(--vx-fade);
}

.dropdown-option:hover {
    background-color: var(--vx-hover);
    color: var(--vx-text);
}

.dropdown-option:checked {
    color: var(--vx-accent);
}

/* Segmented controls sit in an inset well; the segment that is on is
   raised a little. */

Segmented {
    height: 28px;
    padding: 2px;
    gap: 2px;
    border-radius: 7px;
    background-color: var(--vx-bg);
    border: 1px solid var(--vx-line);
}

.segment {
    height: 22px;
    padding: 0px 8px;
    border-radius: 5px;
    border: 0px transparent;
    background-color: transparent;
    color: var(--vx-muted);
}

.segment:hover {
    background-color: var(--vx-hover);
    color: var(--vx-text-2);
}

.segment:checked {
    background-color: var(--vx-seg-on);
    box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.4);
    color: var(--vx-text);
}

/* Docking: panels are rounded near-black cards with gaps between them. The
   gaps are the dividers, which light up when the pointer finds them. */

DockSpace {
    padding: 0px;
}

.dock-area {
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--vx-panel);
    border: 1px solid var(--vx-line);
}

/* The header: 40px of tabs with a line under it, drawn as a hard shadow
   so it needs no border of its own. */
.dock-area > .tab-bar {
    height: 40px;
    padding: 0px 6px;
    box-shadow: 0px 1px 0px var(--vx-line);
}

DockSpace .split-divider {
    background-color: transparent;
}

DockSpace .split-row > .split-divider {
    width: 10px;
}

DockSpace .split-column > .split-divider {
    height: 10px;
}

DockSpace .split-divider:hover, DockSpace .split-divider:active {
    background-color: var(--vx-accent-soft);
}

.dock-ghost {
    height: 28px;
    padding: 0px 10px;
    justify-content: center;
    border-radius: 7px;
    background-color: var(--vx-selected);
    border: 1px solid var(--vx-accent);
    box-shadow: 0px 16px 40px rgba(0, 0, 0, 0.4);
    color: var(--vx-text);
}

.dock-preview {
    border-radius: 12px;
    background-color: var(--vx-accent-soft);
    border: 1px solid var(--vx-accent);
}
