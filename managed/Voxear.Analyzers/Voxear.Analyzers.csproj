<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Compile-time checks of the Inspector's attributes: a condition, callback, check or dropdown that names a member
		the type does not have, or one of the wrong shape, is an error where it is written rather than a puzzle in the
		editor. It also makes Strings from the project's string tables, so a key a script names is checked too, and Actions
		from its input actions. Game scripts get it through Voxear.Scripts.props. Built against an older Roslyn than the
		SDK's, which loads it, as analyzers are.
	-->
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<OutputPath>$(VoxearRoot)target/managed/$(Configuration)/</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
		<!-- Voxear's own input actions, which a project without a file of its own plays with, for its Actions. -->
		<EmbeddedResource Include="../../crates/voxear_input/src/defaults.inputactions" LogicalName="defaults.inputactions" />
	</ItemGroup>
</Project>
