<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Voxear</RootNamespace>
		<!-- Produces Voxear.Core.runtimeconfig.json, which the engine hands to hostfxr. -->
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<RollForward>LatestMajor</RollForward>
		<OutputPath>$(VoxearRoot)target/managed/$(Configuration)/</OutputPath>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<!-- The tests reach the field reader directly, without the engine. -->
		<InternalsVisibleTo Include="Voxear.Core.Tests" />
		<!-- The editor's tool that describes a game's behaviours from its build. -->
		<InternalsVisibleTo Include="Voxear.ScriptInfo" />
	</ItemGroup>
</Project>
