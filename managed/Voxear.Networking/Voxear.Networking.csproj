<Project Sdk="Microsoft.NET.Sdk">
	<!--
		The Networking module: hosting, joining, replication, RPCs and prediction. A game's scripts reference it only when
		its project has the module, through Voxear.Scripts.props, so a project without it has none of this API.
	-->
	<PropertyGroup>
		<RootNamespace>Voxear</RootNamespace>
		<OutputPath>$(VoxearRoot)target/managed/$(Configuration)/</OutputPath>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../Voxear.Core/Voxear.Core.csproj" Private="false" />
	</ItemGroup>
</Project>
