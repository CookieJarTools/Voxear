<Project>
	<!--
		What a game's scripts project needs from the engine it builds against: the settings Voxear.Core is built with,
		and Voxear.Core itself. The editor and vox pass the engine's folder as VoxearHome when they build scripts, so a
		project can live anywhere. In an install this file sits beside Voxear.Core.dll and references it; in a source
		checkout it references the Voxear.Core project instead, so a solution build builds that first. Either way the
		game does not ship its own copy, since Voxear.Core is shared from the engine. Voxear.Analyzers comes the same
		way, so a wrong name in an Inspector attribute is an error where it is written.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<!-- The scripts' /// comments, for VoxDocs' Code Reference. A public member without one is not a warning. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>
	<!-- A build profile's symbols for #if, such as DEMO, which vox passes as VoxearDefines. -->
	<PropertyGroup Condition="'$(VoxearDefines)' != ''">
		<DefineConstants>$(DefineConstants);$(VoxearDefines)</DefineConstants>
	</PropertyGroup>
	<!--
		The project's string tables, for Voxear.Analyzers to make Strings from, so Strings.Menu.Play names the key
		"menu.play". The project is the scripts folder's parent; its tables are found as the engine finds them, leaving
		out hidden folders, build output and the top's Docs.
	-->
	<PropertyGroup>
		<VoxearProjectFolder Condition="'$(VoxearProjectFolder)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../'))</VoxearProjectFolder>
	</PropertyGroup>
	<!--
		The project's packages, for the game's scripts: each package's scripts build into an assembly of its own, from a
		project Voxear writes in .voxear/Packages, and .voxear/Packages.props has the game use them all. A package's own
		project sets VoxearPackage, so it uses only the packages it needs.
	-->
	<Import Project="$(VoxearProjectFolder).voxear/Packages.props" Condition="'$(VoxearPackage)' == '' and Exists('$(VoxearProjectFolder).voxear/Packages.props')" />
	<!--
		The game's modules, as its .voxear/Modules.props has them: VoxearNetworking and the rest are true for the modules
		its Project Settings switch on, and their assemblies are used as Voxear.Core is. A package's scripts use the
		modules of the game they are built for, which their project names as VoxearGameFolder.
	-->
	<PropertyGroup>
		<VoxearGameFolder Condition="'$(VoxearGameFolder)' == ''">$(VoxearProjectFolder)</VoxearGameFolder>
	</PropertyGroup>
	<Import Project="$(VoxearGameFolder).voxear/Modules.props" Condition="Exists('$(VoxearGameFolder).voxear/Modules.props')" />
	<ItemGroup>
		<CompilerVisibleProperty Include="RootNamespace" />
		<VoxearStringTable Include="$(VoxearProjectFolder)**/*.strings" Exclude="$(VoxearProjectFolder)**/.*/**;$(VoxearProjectFolder)**/bin/**;$(VoxearProjectFolder)**/obj/**;$(VoxearProjectFolder)**/target/**;$(VoxearProjectFolder)**/node_modules/**;$(VoxearProjectFolder)Docs/**" />
		<AdditionalFiles Include="@(VoxearStringTable)" />
		<!-- A table added or removed builds the scripts again, as a script would; a table changed does already. -->
		<CoreCompileCache Include="@(VoxearStringTable)" />
		<!-- The project's input actions, for Voxear.Analyzers to make Actions from, so Actions.Player.Jump names Jump by its id. -->
		<VoxearInputActions Include="$(VoxearProjectFolder)**/*.inputactions" Exclude="$(VoxearProjectFolder)**/.*/**;$(VoxearProjectFolder)**/bin/**;$(VoxearProjectFolder)**/obj/**;$(VoxearProjectFolder)**/target/**;$(VoxearProjectFolder)**/node_modules/**;$(VoxearProjectFolder)Docs/**" />
		<AdditionalFiles Include="@(VoxearInputActions)" />
		<CoreCompileCache Include="@(VoxearInputActions)" />
	</ItemGroup>
	<ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Voxear.Core.dll')">
		<Reference Include="Voxear.Core">
			<HintPath>$(MSBuildThisFileDirectory)Voxear.Core.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Analyzer Include="$(MSBuildThisFileDirectory)Voxear.Analyzers.dll" Condition="Exists('$(MSBuildThisFileDirectory)Voxear.Analyzers.dll')" />
	</ItemGroup>
	<ItemGroup Condition="'$(VoxearNetworking)' == 'true' and Exists('$(MSBuildThisFileDirectory)Voxear.Networking.dll')">
		<Reference Include="Voxear.Networking">
			<HintPath>$(MSBuildThisFileDirectory)Voxear.Networking.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(VoxearNetworking)' == 'true' and !Exists('$(MSBuildThisFileDirectory)Voxear.Core.dll')">
		<ProjectReference Include="$(MSBuildThisFileDirectory)Voxear.Networking/Voxear.Networking.csproj" Private="false" GlobalPropertiesToRemove="OutputPath;IntermediateOutputPath" />
	</ItemGroup>
	<ItemGroup Condition="'$(VoxearGuns)' == 'true' and Exists('$(MSBuildThisFileDirectory)Voxear.Guns.dll')">
		<Reference Include="Voxear.Guns">
			<HintPath>$(MSBuildThisFileDirectory)Voxear.Guns.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(VoxearGuns)' == 'true' and !Exists('$(MSBuildThisFileDirectory)Voxear.Core.dll')">
		<ProjectReference Include="$(MSBuildThisFileDirectory)Voxear.Guns/Voxear.Guns.csproj" Private="false" GlobalPropertiesToRemove="OutputPath;IntermediateOutputPath" />
	</ItemGroup>
	<ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)Voxear.Core.dll')">
		<!-- A build's own output folder, which vox passes for the scripts alone, is not the engine's. -->
		<ProjectReference Include="$(MSBuildThisFileDirectory)Voxear.Core/Voxear.Core.csproj" Private="false" GlobalPropertiesToRemove="OutputPath;IntermediateOutputPath" />
		<ProjectReference Include="$(MSBuildThisFileDirectory)Voxear.Analyzers/Voxear.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="OutputPath;IntermediateOutputPath" />
	</ItemGroup>
</Project>
