[[obj]]
id = 14
name = "Step 1"
position = [0.6, 0.45, 0.6]
scale = [2.4, 0.9, 0.7]
[obj.renderer]
mesh = "builtin:cube"
material = { color = [0.5, 0.5, 0.52], roughness = 0.8 }

[[obj]]
id = 15
name = "Step 2"
position = [0.6, 0.3, -0.1]
scale = [2.4, 0.6, 0.7]
[obj.renderer]
mesh = "builtin:cube"
material = { color = [0.5, 0.5, 0.52], roughness = 0.8 }

[[obj]]
id = 16
name = "Step 3"
position = [0.6, 0.15, -0.8]
scale = [2.4, 0.3, 0.7]
[obj.renderer]
mesh = "builtin:cube"
material = { color = [0.5, 0.5, 0.52], roughness = 0.8 }

[[obj]]
id = 17
name = "Whirl"
position = [5.0, 0.5, 2.0]
[obj.force_field]
kind = "vortex"
strength = 8.0
radius = 3.5

# The starters that go on for good, each played by a Particle System's Effect.
[[obj]]
id = 18
name = "Starter Fire"
position = [8.0, 0.05, 2.5]
[obj.particles]
effect = "builtin:fire"

[[obj]]
id = 19
name = "Starter Smoke"
position = [11.0, 0.05, 7.0]
[obj.particles]
effect = "builtin:smoke"

[[obj]]
id = 20
name = "Starter Magic"
position = [-2.2, 1.0, -2.5]
[obj.particles]
effect = "builtin:magic"

# Effects played from a script, as a game plays them (Scripts/EffectRepeater.cs): each play has an Obj of its own
# while it lasts.
[[obj]]
id = 21
name = "Muzzle"
position = [-0.8, 1.0, -3.5]
behaviours = ["Effects.EffectRepeater"]
[obj.fields."Effects.EffectRepeater"]
effect = "builtin:muzzle_flash"
every = 0.8
follows = true

[[obj]]
id = 22
name = "Shells Landing"
position = [3.4, 0.4, -0.5]
behaviours = ["Effects.EffectRepeater"]
[obj.fields."Effects.EffectRepeater"]
effect = "builtin:explosion"
every = 5.0
blast = 6.0

[[obj]]
id = 23
name = "Mud Thrown Up"
position = [2.6, 0.1, -3.0]
behaviours = ["Effects.EffectRepeater"]
[obj.fields."Effects.EffectRepeater"]
effect = "builtin:mud"
every = 3.0

[[obj]]
id = 24
name = "Starter Rain"
position = [-12.0, 6.0, 6.0]
[obj.particles]
effect = "builtin:rain"

# Trails and meshes: a ribbon rising and wavering in the air, rubble that tumbles and comes to rest, and shell
# cases thrown out beside the muzzle flash.
[[obj]]
id = 25
name = "Ribbon"
position = [-6.0, 0.3, -1.0]
[obj.particles]
rate = 40.0
lifetime = [4.0, 4.0]
speed = [0.9, 0.9]
gravity = -0.03
size = [0.12, 0.12]
size_end = 0.2
color = [0.3, 0.7, 1.0, 1.0]
color_end = [0.6, 0.2, 1.0, 0.0]
intensity = 5.0
radius = 0.0
angle = 0.0
blend = "additive"
lit = false
softness = 0.1
space = "world"
turbulence = 0.7
turbulence_size = 1.6
trails = "ribbon"
trail_width = 1.0
light = 3.0
light_range = 5.0

[[obj]]
id = 27
name = "Rubble"
position = [2.2, 0.1, 3.2]
[obj.particles]
mesh = "builtin:chunk"
rate = 6.0
lifetime = [5.0, 6.0]
speed = [3.5, 5.5]
size = [0.12, 0.3]
color = [0.42, 0.4, 0.38, 1.0]
color_end = [0.42, 0.4, 0.38, 0.0]
opacity_curve = [[0.0, 1.0], [0.9, 1.0], [1.0, 0.0]]
angle = 22.0
gravity = 1.0
spin = 220.0
collision = "depth"
bounce = 0.35
friction = 0.5

[[obj]]
id = 28
name = "Shell Cases"
position = [-0.8, 1.0, -3.6]
rotation = [0.0, 0.0, -65.0]
[obj.particles]
mesh = "builtin:rod"
rate = 5.0
lifetime = [4.0, 4.0]
speed = [2.2, 3.0]
size = [0.06, 0.06]
color = [0.85, 0.62, 0.22, 1.0]
color_end = [0.85, 0.62, 0.22, 1.0]
shape = "point"
angle = 8.0
gravity = 1.0
spin = 900.0
collision = "depth"
bounce = 0.4
friction = 0.5
