# Voxear scene: Particle Systems in a wind, bouncing down steps and stirred by a Force Field
format = 1

[post]
preset = "voxear"

[[obj]]
id = 1
name = "Main Camera"
position = [0.0, 1.8, -8.0]
rotation = [2.0, 0.0, 0.0]
camera = { fov = 60.0 }

[[obj]]
id = 2
name = "Sun"
rotation = [32.0, -50.0, 0.0]
light = { type = "directional", color = [1.0, 0.93, 0.84], intensity = 3.0 }

[[obj]]
id = 3
name = "Ground"
scale = [200.0, 1.0, 200.0]
[obj.renderer]
mesh = "builtin:plane"
material = { color = [0.42, 0.38, 0.32], roughness = 0.9 }

[[obj]]
id = 4
name = "Wind"
rotation = [0.0, 90.0, 0.0]
[obj.wind_zone]
strength = 0.5
gusts = 0.6

[[obj]]
id = 5
name = "Campfire Flames"
position = [-3.5, 0.1, 0.0]
[obj.particles]
rate = 60.0
lifetime = [0.5, 0.9]
speed = [1.2, 2.0]
size = [0.35, 0.5]
size_end = 0.2
color = [1.0, 0.45, 0.08, 0.9]
color_end = [0.8, 0.08, 0.02, 0.0]
intensity = 3.0
radius = 0.2
angle = 12.0
gravity = -0.2
blend = "additive"
lit = false
softness = 0.2
wind = 0.15
turbulence = 0.4
turbulence_size = 0.5

[[obj]]
id = 6
name = "Campfire Smoke"
position = [-3.5, 0.8, 0.0]
[obj.particles]
rate = 14.0
lifetime = [4.0, 6.0]
speed = [0.8, 1.2]
size = [0.5, 0.7]
size_end = 5.0
color = [0.35, 0.35, 0.36, 0.5]
color_end = [0.5, 0.5, 0.5, 0.0]
radius = 0.15
angle = 10.0
gravity = -0.08
drag = 0.3
softness = 0.6
space = "world"
wind = 1.0
turbulence = 0.5
turbulence_size = 2.0

[[obj]]
id = 7
name = "Campfire Embers"
position = [-3.5, 0.3, 0.0]
[obj.particles]
rate = 25.0
lifetime = [1.5, 3.0]
speed = [1.0, 2.5]
size = [0.03, 0.05]
color = [1.0, 0.5, 0.1, 1.0]
color_end = [1.0, 0.15, 0.02, 0.0]
intensity = 6.0
radius = 0.2
angle = 20.0
gravity = -0.1
drag = 0.4
blend = "additive"
lit = false
softness = 0.05
space = "world"
wind = 0.6
turbulence = 1.2
turbulence_size = 0.8

[[obj]]
id = 8
name = "Sparks"
position = [0.6, 1.0, 0.6]
rotation = [-30.0, 0.0, 0.0]
[obj.particles]
rate = 150.0
lifetime = [2.5, 3.5]
speed = [2.0, 3.5]
size = [0.04, 0.07]
color = [1.0, 0.6, 0.2, 1.0]
color_end = [1.0, 0.25, 0.05, 0.0]
intensity = 4.0
angle = 20.0
gravity = 1.0
blend = "additive"
lit = false
softness = 0.02
collision = "depth"
bounce = 0.55
friction = 0.15
trails = "particles"
trail_time = 0.12
trail_width = 0.8

[[obj]]
id = 9
name = "Dust"
position = [5.0, 0.3, 2.0]
[obj.particles]
rate = 20.0
lifetime = [5.0, 8.0]
speed = [0.0, 0.2]
size = [0.6, 1.2]
size_end = 2.0
color = [0.45, 0.38, 0.28, 0.15]
color_end = [0.45, 0.38, 0.28, 0.0]
shape = "box"
box_size = [5.0, 0.3, 5.0]
softness = 0.8
space = "world"
wind = 0.4
turbulence = 0.3
turbulence_size = 3.0
forces = 1.0

