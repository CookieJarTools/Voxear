# Voxear prefab: a firefly that drifts up and goes out. FireflySpawner makes them at night.
format = 1

[[obj]]
id = 1
name = "Firefly"
scale = [0.06, 0.06, 0.06]
behaviours = ["Hello.Firefly"]
light = { type = "point", color = [0.8, 1.0, 0.4], intensity = 1.5, range = 1.5 }
[obj.renderer]
mesh = "builtin:sphere"
material = { color = [0.0, 0.0, 0.0], emissive = [4.0, 6.0, 1.5] }
