# Voxear scene: moonlight and coloured lamps
format = 1

[sky]
zenith = [0.02, 0.03, 0.08]
horizon = [0.06, 0.07, 0.14]
ground = [0.02, 0.02, 0.03]
ambient = 0.6

[[obj]]
id = 1
name = "Moon"
rotation = [50.0, 140.0, 0.0]
light = { type = "directional", color = [0.6, 0.7, 1.0], intensity = 0.5 }

[[obj]]
id = 2
name = "Monolith"
position = [0.0, 1.5, 1.0]
rotation = [0.0, 25.0, 0.0]
scale = [0.8, 3.0, 0.3]
behaviours = ["Hello.Turner"]
# It turns to face the camera as the night goes on.
fields."Hello.Turner" = { target = [0.0, 2.2, -7.0], degrees_per_second = 40.0 }
[obj.renderer]
mesh = "builtin:cube"
material = { color = [0.12, 0.12, 0.14], metallic = 0.6, roughness = 0.25 }

# The lamps are instances of Prefabs/Lamp.prefab, each tinted with its own light
# and an override on the bulb (Obj 2 inside the prefab).
[[obj]]
id = 3
name = "Violet lamp"
prefab = "Prefabs/Lamp.prefab"
position = [-2.5, 0.6, -0.5]

[[obj]]
id = 5
name = "Cyan lamp"
prefab = "Prefabs/Lamp.prefab"
position = [2.5, 0.6, -0.5]
light = { type = "point", color = [0.25, 0.85, 1.0], intensity = 6.0, range = 5.0 }
[obj.overrides.2.renderer.material]
emissive = [1.25, 4.25, 5.0]

[[obj]]
id = 7
name = "Pink lamp"
prefab = "Prefabs/Lamp.prefab"
position = [-2.5, 0.6, 2.5]
light = { type = "point", color = [1.0, 0.35, 0.6], intensity = 6.0, range = 5.0 }
[obj.overrides.2.renderer.material]
emissive = [5.0, 1.75, 3.0]

# A variant: AmberLamp is a Lamp with its colours already changed.
[[obj]]
id = 9
prefab = "Prefabs/AmberLamp.prefab"
position = [2.5, 0.6, 2.5]

[[obj]]
id = 11
name = "Fireflies"
position = [0.0, 0.0, 0.5]
behaviours = ["Hello.FireflySpawner"]
[obj.fields."Hello.FireflySpawner"]
firefly = "Prefabs/Firefly.prefab"
lamps = [{ obj = 3 }, { obj = 5 }, { obj = 7 }, { obj = 9 }]
rare_firefly = "Prefabs/RareFirefly.prefab"
rare_chance = 0.1
spread = 1.5
