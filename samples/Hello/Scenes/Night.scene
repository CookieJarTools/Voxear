# Voxear scene: moonlight and coloured lamps
format = 1

[sky]
zenith = [0.02, 0.03, 0.08]
horizon = [0.06, 0.07, 0.14]
ground = [0.02, 0.02, 0.03]
ambient = 0.6

[[obj]]
id = 1
name = "Moon"
rotation = [50.0, 140.0, 0.0]
light = { type = "directional", color = [0.6, 0.7, 1.0], intensity = 0.5 }

[[obj]]
id = 2
name = "Monolith"
position = [0.0, 1.5, 1.0]
rotation = [0.0, 25.0, 0.0]
scale = [0.8, 3.0, 0.3]
[obj.renderer]
mesh = "builtin:cube"
material = { color = [0.12, 0.12, 0.14], metallic = 0.6, roughness = 0.25 }

[[obj]]
id = 3
name = "Violet lamp"
position = [-2.5, 0.6, -0.5]
light = { type = "point", color = [0.62, 0.38, 1.0], intensity = 6.0, range = 5.0 }

[[obj]]
id = 4
name = "Violet glow"
parent = 3
position = [0.0, -0.35, 0.0]
scale = [0.3, 0.3, 0.3]
[obj.renderer]
mesh = "builtin:sphere"
material = { color = [0.0, 0.0, 0.0], emissive = [3.1, 1.9, 5.0] }

