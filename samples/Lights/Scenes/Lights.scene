# Voxear scene: 256 point lights among 100 pillars, at night
format = 1

[sky]
zenith = [0.02, 0.03, 0.08]
horizon = [0.06, 0.07, 0.14]
ground = [0.02, 0.02, 0.03]
ambient = 0.6

# The Voxear Look, with a little more glow around the lamps.
[post]
preset = "voxear"

[post.bloom]
intensity = 0.06

[[obj]]
id = 1
name = "Main Camera"
position = [0.0, 16.0, -36.0]
rotation = [24.0, 0.0, 0.0]
camera = { fov = 60.0 }

[[obj]]
id = 2
name = "Ground"
scale = [120.0, 1.0, 120.0]
[obj.renderer]
mesh = "builtin:plane"
material = { color = [0.55, 0.55, 0.58], roughness = 0.6 }

[[obj]]
id = 3
name = "Pillar (0,0,0)"
position = [-27.0, 1.5, -27.0]
scale = [0.8, 3.0, 0.8]
[obj.renderer]
mesh = "builtin:cube"
